<<stitch>>=
library(data.table)
part.1 <- res.2000.2020[, c("region", "share_2000", "share_2020"), ]
part.2 <- res.2005.2015[, c("region", "share_2005", "share_2015"), ]
part.3 <- res.2000.2010[, c("region", "share_2010"), ]
full.set <- Reduce(merge, list(part.1, part.2, part.3))
full.set[, forestation.change.2005 := 100 * (share_2005 - share_2000), ]
full.set[, forestation.change.2010 := 100 * (share_2010 - share_2000), ]
full.set[, forestation.change.2015 := 100 * (share_2015 - share_2000), ]
full.set[, forestation.change.2020 := 100 * (share_2020 - share_2000), ]
full.set[, c("share_2020", "share_2005", "share_2015", "share_2010") := NULL, ]
setnames(full.set, "share_2000", "forestation.2000")
## use per cent rather than proportion also for forestation.2000
full.set[, forestation.2000 := 100 * forestation.2000, ]
full.set[, region := factor(region), ]
library(sf)
setDT(my.sf)
my.sf[, c("change", "share_2005", "share_2000") := NULL, ]
my.sf <- my.sf[full.set, on = "region"]
## regain "SF"-class membership
my.sf <- st_as_sf(my.sf, sf_column_name = "geometry")

## Add sizes
library(future.apply)
plan(multicore)
area.sizes <- future_sapply(seq_len(nrow(my.sf)), function(i) {
    sf_use_s2(FALSE)
    as.numeric(st_area(my.sf[i, ]))
}, future.seed=TRUE)
my.sf$size.km2 <- round(area.sizes / 1e6)

## Derive top level region and country
my.sf$top.level.region.temp <- factor(sapply(strsplit(my.sf$region, ".", fixed = TRUE), function(x) { paste(x[1:2], collapse = ".") }))
my.sf$top.level.region <- factor(sapply(strsplit(my.sf$region, ".", fixed = TRUE), function(x) { paste(x[2], collapse = ".") }))
library(globallivingconditions)
country.code <- sapply(strsplit(my.sf$region, ".", fixed = TRUE), function(x) { x[1] })
only.digits <- which(grepl("^[0-9]+$", country.code))
country.code[only.digits] <- iso.3166$String.code[match(country.code[only.digits], iso.3166$numeric)]
my.sf$country <- factor(country.code)
my.sf$top.level.region <- factor(paste(my.sf$country, my.sf$top.level.region, sep = "."))
my.sf$top.level.region.temp <- NULL

## Make a data.table.version, for easy selections
my.dt <- as.data.table(st_drop_geometry(my.sf))

@ 


grat <- st_graticule(
  x = bb,
  crs = st_crs(my.sf),
  lon = seq(floor(bb["xmin"]/50)*50, ceiling(bb["xmax"]/50)*50, by = 50),
  lat = seq(floor(bb["ymin"]/20)*20, ceiling(bb["ymax"]/20)*20, by = 20)

<<forestation-change-cosmetic>>=
## Set areas with "no valid cells" to "no change" rather than NA which will just show up as grey dots in the maps
my.sf.copy <- my.sf
these <- which(is.na(my.sf.copy$change))
my.sf.copy$change[these] <- 0

@

<<properly.sized.grid.with.graticules>>=
bb <- st_bbox(my.sf.copy)

grat <- st_graticule(
  x = bb,
  crs = st_crs(my.sf.copy),
  lon = seq(floor(bb["xmin"]/50)*50, ceiling(bb["xmax"]/50)*50, by = 50),
  lat = seq(floor(bb["ymin"]/20)*20, ceiling(bb["ymax"]/20)*20, by = 20)
)

@ 

<<full-grid, fig.cap = "The borders of the administrative areas used.", dpi = 400, fig.width=6, fig.height=2.4>>=
library(sf); library(ggplot2)
## par(mar = c(0, 0, 0, 0))
## plot(st_geometry(full.grid.sf), lwd = 0.05)

ggplot() +
    ## graticule behind polygons
    geom_sf(data = grat, linewidth = 0.10) +
    ## The adminiatrative borders
    geom_sf(data = my.sf.copy, fill = "white", linewidth = 0.05) + 

    ## lock extent to the bbox
    coord_sf(
        xlim = c(bb["xmin"], bb["xmax"]),
        ylim = c(bb["ymin"], bb["ymax"]),
        expand = FALSE
    ) +

  theme_minimal()

@ 

%% Borders needed for the next graph.


<<forest.change.path.to.artifacts>>=
path.to.artifacts <- "/mnt/windows/Deforestation and poverty - Paper I/"
@ 

<<forest.change.import.borders>>=
all.borders <- readRDS(file.path(path.to.artifacts, "all.borders.RDS"))

my.crop.f <- function(xmin, ymin, xmax, ymax, my.sf){

  withCallingHandlers({

    old <- sf::sf_use_s2()
    on.exit(sf::sf_use_s2(old), add = TRUE)
    sf::sf_use_s2(FALSE)

    bbox <- sf::st_bbox(
      c(xmin = xmin, ymin = ymin, xmax = xmax, ymax = ymax),
      crs = sf::st_crs(my.sf)
    )

    sf::st_crop(my.sf, bbox)

  }, warning = function(w) invokeRestart("muffleWarning"))
}

@

<<forestation, fig.cap = "Average forest coverage in the administrative areas in year 2000. Country borders added.", dpi = 400, fig.width=6, fig.height=3>>=
library(sf); library(ggplot2)

ggplot() +
  # graticule behind polygons
  geom_sf(data = grat, linewidth = 0.10) +

  geom_sf(data = my.sf.copy,
          aes(fill = share_2000 * 100),
          color = NA) +
  geom_sf(data = all.borders, fill = NA, linewidth = 0.05) +

  # lock extent to the bbox
  coord_sf(
    xlim = c(bb["xmin"], bb["xmax"]),
    ylim = c(bb["ymin"], bb["ymax"]),
    expand = FALSE
  ) +

  scale_fill_gradientn(
    colours = rev(terrain.colors(256)),
    limits = c(0, 100),
    name = "Forest coverage (%)  "
  ) +

  theme_minimal() +
  theme(
    panel.grid = element_blank(),
    legend.position = "top",
    legend.direction = "horizontal",
    legend.key.width = unit(1, "cm"),
    legend.key.height = unit(0.07, "cm"),          
    legend.text = element_text(size = 7)
  )

@

<<forestation-change-temporary-5-degrees, fig.cap = paste0("Change in average forest coverage ", year0, "-", year1, " per administrative area."), fig.width=6, fig.height = 3>>=
library(ggplot2)

ggplot() +
    ## graticule behind polygons
    geom_sf(data = grat, linewidth = 0.10) +

    geom_sf(data = my.sf.copy, aes(fill = change), color = NA) +

    ## lock extent to the bbox
    coord_sf(
        xlim = c(bb["xmin"], bb["xmax"]),
        ylim = c(bb["ymin"], bb["ymax"]),
        expand = FALSE
    ) +

    scale_fill_gradient2(
    low = "red",
    mid = "black",
    high = "blue",
    midpoint = 0,
    name = "Forest coverage change (%)  "
  ) +
    theme_minimal() +
    theme(legend.position = "top",
          legend.direction = "horizontal",
          legend.key.width = unit(1, "cm"),
          legend.key.height = unit(0.07, "cm"),          
          legend.text = element_text(size = 7)) + 
    labs(title = NULL)

@



<<forest-change-south-america, fig.width = 7.5, fig.height = 9, fig.cap = paste0("Change in average forest coverage in South America ", year0, "-", year1, " per administrative area. Country borders added.")>>=
borders_crop <- my.crop.f(-90, -45, -34, 15, all.borders)
label_points <- sf::st_point_on_surface(borders_crop)
my.object <- my.crop.f(-90, -45, -34, 15, my.sf.copy)
ggplot(my.object) +
  geom_sf(aes(fill = change), color = NA) +
  scale_fill_gradient2(
    low = "red",
    mid = "black",
    high = "blue",
    midpoint = 0,
    name = "Forest cover change (%)  "
  ) +
  geom_sf(data = borders_crop,
          fill = NA,
          color = "white",
          linewidth = 0.3) +
  geom_sf_text(
    data = label_points,
    aes(label = COUNTRY),
    color = "white",
    size = 3
  ) +
    theme_minimal() +
    theme(legend.position = "top",
          legend.direction = "horizontal",
          legend.key.width = unit(1, "cm"),
          legend.key.height = unit(0.07, "cm"),          
          legend.title = element_text(size = 13),
          legend.text = element_text(size = 9)) +
    labs(title = NULL,
         x = NULL, y = NULL)

@ 


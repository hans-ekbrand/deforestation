setDT(my.map)
out <- merge(out, my.map)
my.cols <- setdiff(colnames(out), c("region_piece_id", "region", "geometry"))
out <- out[, lapply(.SD, sum, na.rm = TRUE), by = region, .SDcols = my.cols]

## Now with the counts in place can calculate proprtions and change
out[, paste0("share_", year0) := get(paste0("forest_", year0)) / get(paste0("valid_", year0))]
out[, paste0("share_", year1) := get(paste0("forest_", year1)) / get(paste0("valid_", year1))]
## last share minus first share gives negative values when there is a net loss of forest

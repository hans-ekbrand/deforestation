<<kuznet-0>>=
my.dt[, year := factor(year.of.interview), ]
my.formula.1 <- formula(forestation_change ~ gdp.log + I(gdp.log^2) + year + (1 | country))
my.formula.2 <- formula(forestation_change ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country))
@

% This is the code needed to fit the first model to data with lmer in R.

<<show.formula.1, echo = FALSE>>=
formula(forestation_change ~ gdp.log + I(gdp.log^2) + year + (1 | country))
@

% And here is the code for the second model:

<<show.formula.2, echo = FALSE>>=
formula(forestation_change ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country))
@

<<fcc.def, echo = FALSE>>=
library(data.table); library(xtable); library(globallivingconditions)
setkey(my.dt, area.name)
## import state at t0 again
deforestation.dt <- data.table(read.csv("forest_change.csv"))
initial.state.dt <- deforestation.dt[, list(area.name = region, FC_init = forestation_2000), ]
my.dt.full <- merge(my.dt, initial.state.dt)

setorder(my.dt.full, area.name, year.of.interview)

my.dt.full[
  ,
  forestation_state := FC_init + forestation_change
]

my.dt.full[
  order(area.name, year.of.interview),
  forestation_change_5yr_forward := data.table::shift(forestation_state, type = "lead") - forestation_state,
  by = area.name
]

my.dt.clean <- my.dt.full[, list(country, top.level.region, area.name, year = year.of.interview, iwi, gdp.log, forest_coverage = forestation_state, cummulative_forestation_change = forestation_change, forestation_change_5yr_forward), ]

my.dt.clean[
  order(area.name, year),
  forestation_change_5yr_backward :=
    forest_coverage - data.table::shift(forest_coverage, type = "lag"),
  by = area.name
]

country <- sapply(strsplit(my.dt.clean$country, split = ".", fixed = TRUE), function(x) { x[1] })
my.dt.clean$country.code <- iso.3166$String.code[match(country, iso.3166$String)]

## add the shares of rural, urban and refugee respondents per area
rural.dt <- readRDS("kuznet.rural.RDS")
my.dt.clean <- merge(my.dt.clean, rural.dt, by = "area.name", all.x = TRUE)
setcolorder(my.dt.clean, "country.code")

write.csv(my.dt.clean, file = "commondata1.csv")

sample.2 <- my.dt.clean[top.level.region == "Zimbabwe.Midlands", list(top.level.region, area.name, year, iwi, gdp.log, forest_coverage, cummulative_forestation_change, forestation_change_5yr_forward), ]
colnames(sample.2) <- c("Top level Region", "Area name", "year", "IWI", "GNI.log", "FC", "cum.FCC", "F5YFCC")

## print(xtable(sample.2, caption = "The data points for a top level region in the merged dataset. 'IWI', predicted average IWI based on observed IWI and education in years for a common cohort'; 'FC' = 'Forest Coverage'; 'cum.FCC' = 'Cummulative Forest Coverage Change'; 'F5YFCC' = 'Forward-looking 5 years Forest Coverage Change, ie, the FCC for the coming 5 years after this year. Not Available for the last observation in each area", label = "tab:def1"), booktabs = TRUE)

@

%% Adding Trade data from the FAO
%% input: "FAOSTAT_data_2011-2024.csv" and "FAOSTAT_data_2000-2010.csv" to be in the path
%% "~/mnt/poverty/media/sf_Our_data/Hans/Onedrive/University of Gothenburg/Deforestation and poverty - General/Data/Trade data from FAO/"
%% output: a data.table object called export with three variables per country and year

<<import.and.wash.fao, child="/home/hans/src/deforestation/FAO.Rnw">>=
@

<<add.fao.data>>=
library(data.table)
setkey(my.dt.clean, country.code, year)
fao.dt <- merge(my.dt.clean, exports)
@ 

<<iwi.static>>=
library(data.table); library(lme4)

iwi.static <- pred_grid[year.of.interview %in% c(2000, 2020),
    list(iwi_2000 = iwi_pred[year.of.interview == 2000],
         iwi_2020 = iwi_pred[year.of.interview == 2020]),
    by = list(area.name, country, top.level.region)]
## IWI units per year
iwi.static[, iwi_slope := (iwi_2020 - iwi_2000) / 20]

## The area-specific part of the slope, from the random term (0 + year | area.name),
## converted from the z-scaled metric to IWI units per year.
re.area <- ranef(my.fit.iwi)$area.name
slope.scale <- attr(bal$iwi, "scaled:scale") / attr(bal$year, "scaled:scale")
iwi.static[, iwi_slope_area := re.area[area.name, "year"] * slope.scale]

## How much data supports the trend in each area
## n_interview_years counts distinct years with interviews; a DHS round that
## spans two calendar years counts twice.
iwi.support <- bal[, list(n_interview_years = uniqueN(year.of.interview),
                          first_survey = min(year.of.interview),
                          last_survey  = max(year.of.interview)), by = area.name]
iwi.static <- merge(iwi.static, iwi.support, by = "area.name")
@

<<merge.transitions>>=
## Land cover transitions 2000-2020 per area, see transitions-per-area.R
transitions.dt <- fread("forest_transitions_2000_2020.csv", encoding = "UTF-8")
static.dt <- merge(iwi.static, transitions.dt, by.x = "area.name", by.y = "region")

## Deforestation by type, per cent of the land area in year 2000
static.dt[, deforestation_total := pct_A_forest_to_shortveg + pct_C_forest_to_cropland +
                                   pct_E_forest_to_builtup + pct_forest_to_other]

## Add the shares of rural, urban and refugee respondents per area
static.dt <- merge(static.dt, readRDS("kuznet.rural.RDS"), by = "area.name", all.x = TRUE)

saveRDS(static.dt, "paper_II_static.RDS")
write.csv(static.dt, file = "paper_II_static.csv", row.names = FALSE)
@


<<n.surveys.table, results = "asis", include = FALSE>>=
library(xtable)
n.surveys.tab <- static.dt[, list(areas = .N,
                                  `first (median)` = median(first_survey),
                                  `last (median)` = median(last_survey),
                                  `deforestation (\\%)` = mean(deforestation_total, na.rm = TRUE)),
                           by = list(`interview years` = n_interview_years)][order(`interview years`)]
print(xtable(n.surveys.tab,
             caption = "Number of areas by the number of years with DHS interviews their IWI trend is based on (a survey round spanning two calendar years counts twice). Areas with a single interview year have no area-specific IWI trend. First and last: median of the first and last interview year. Deforestation (mean) is the share of the land area in year 2000 that was forest in 2000 but not in 2020.",
             label = "tab:n-surveys", digits = c(0, 0, 0, 0, 0, 2)),
      include.rownames = FALSE, booktabs = TRUE, sanitize.colnames.function = identity)
@



<<iwi.deforestation.data>>=
library(data.table); library(lme4)

## Respondents per area and interview year, the same selection as average.iwi in prepare.data.f()
hh.dt <- readRDS("kuznet.1.RDS")
n.resp <- hh.dt[is.na(area.name) == FALSE & is.na(iwi) == FALSE,
                list(n_respondents = .N), by = list(year.of.interview, area.name)]
rm(hh.dt)

## Area-level explanatory variables, per cent of the land area in 2000
area.vars <- static.dt[valid_2000 > 0, list(
    area.name, forest_share_2000,
    pct_A = pct_A_forest_to_shortveg,
    pct_C = pct_C_forest_to_cropland,
    pct_E = pct_E_forest_to_builtup,
    ## regrowth
    pct_B = pct_B_shortveg_to_forest,
    pct_D = pct_D_cropland_to_forest,
    ## expansion of built-up land and cropland on land that was not forest in 2000
    nf_builtup  = 100 * (shortveg__builtup + cropland__builtup + other__builtup) / valid_2000,
    nf_cropland = 100 * (shortveg__cropland + other__cropland) / valid_2000,
    urban = share.urban,
    n_interview_years, first_survey, last_survey)]

bal2 <- merge(bal, n.resp, by = c("year.of.interview", "area.name"))
bal2 <- merge(bal2, area.vars, by = "area.name")
## the scaled variables are one-column matrices; make them plain vectors
bal2[, `:=`(iwi = as.numeric(iwi), year = as.numeric(year), education = as.numeric(education))]
bal2 <- bal2[complete.cases(bal2[, list(iwi, year, education, forest_share_2000, pct_A, pct_C, pct_E,
                                        pct_B, pct_D, nf_builtup, nf_cropland, urban)])]
## relative weights, mean 1
bal2[, w := n_respondents / mean(n_respondents)]

## areas whose interviews span the study period (model 3)
bal2.span <- bal2[first_survey <= 2005 & last_survey >= 2015]
@

<<area.vars.table>>=
library(xtable)
var.labels <- c(forest_share_2000 = "forest cover in 2000 (\\%)",
                pct_A = "A: forest $\\to$ short vegetation (\\%)",
                pct_C = "C: forest $\\to$ cropland (\\%)",
                pct_E = "E: forest $\\to$ built-up (\\%)",
                pct_B = "B: short vegetation $\\to$ forest (\\%)",
                pct_D = "D: cropland $\\to$ forest (\\%)",
                nf_builtup = "non-forest $\\to$ built-up (\\%)",
                nf_cropland = "non-forest $\\to$ cropland (\\%)",
                urban = "share urban respondents")
## one row per area, as in the models
area.level <- unique(bal2[, c("area.name", names(var.labels)), with = FALSE])
var.sd <- sapply(names(var.labels), function(v) sd(area.level[[v]]))
area.vars.tab <- rbindlist(lapply(names(var.labels), function(v) {
    x <- area.level[[v]]
    data.table(variable = var.labels[[v]], mean = mean(x), sd = sd(x), median = median(x),
               p90 = quantile(x, 0.9), max = max(x))
}))
setnames(area.vars.tab, "variable", "")
tab_area_vars <- list(x = xtable(area.vars.tab,
             caption = paste0("Area-level variables, ", format(nrow(area.level), big.mark = ","),
                              " areas. Transitions 2000--2020 as per cent of the land area in 2000."),
             label = "tab:area-vars", digits = c(0, 0, 2, 2, 2, 2, 2)),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<iwi.deforestation.models>>=
ctrl <- lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
re.part <- "(1 | area.name) + (year | top.level.region) + (year | country)"
f1 <- as.formula(paste("iwi ~ year * (forest_share_2000 + pct_A + pct_C + pct_E) + education +", re.part))
f2 <- as.formula(paste("iwi ~ year * (forest_share_2000 + pct_A + pct_C + pct_E + pct_B + pct_D +",
                       "nf_builtup + nf_cropland + urban) + education +", re.part))
fit.II   <- lmer(f1, data = bal2, weights = w, control = ctrl)
fit.II.2 <- lmer(f2, data = bal2, weights = w, control = ctrl)
fit.II.3 <- lmer(f2, data = bal2.span, weights = w, control = ctrl)
@

<<iwi.deforestation.table>>=
## from scaled iwi per scaled year to IWI units per year
k <- attr(bal$iwi, "scaled:scale") / attr(bal$year, "scaled:scale")

## estimate [95% CI] per standard deviation, as a string
est.ci <- function(fit, v) {
    term <- paste0("year:", v)
    cf <- summary(fit)$coefficients
    if (!term %in% rownames(cf)) return("")
    e  <- k * var.sd[[v]] * cf[term, "Estimate"]
    se <- k * var.sd[[v]] * cf[term, "Std. Error"]
    sprintf("%.3f [%.3f, %.3f]", e, e - 1.96 * se, e + 1.96 * se)
}
fits <- list(`Model 1` = fit.II, `Model 2` = fit.II.2, `Model 3` = fit.II.3)
iwi.def.tab <- data.table(variable = var.labels,
                          sapply(fits, function(f) sapply(names(var.labels), function(v) est.ci(f, v))))
setnames(iwi.def.tab, "variable", "")
tab_iwi_deforestation <- list(x = xtable(iwi.def.tab,
             caption = "Difference in the IWI trend (IWI units per year) associated with one standard deviation more of each variable, with 95\\% confidence intervals. Interaction terms with year from linear mixed models of average IWI per area and interview year, weighted by the number of respondents, with random intercepts for area and random intercepts and slopes for top level region and country, controlling for education. Model 2 adds regrowth (B and D), expansion of built-up land and cropland on non-forest land and the share of urban respondents. Model 3 is model 2 restricted to areas with interviews both in or before 2005 and in or after 2015.",
             label = "tab:iwi-deforestation", align = c("l", "l", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<iwi.deforestation.contrast>>=
## linear contrasts of interaction terms, with the covariance between the estimates
contrast.f <- function(fit, plus, minus) {
    b <- fixef(fit); V <- as.matrix(vcov(fit))
    L <- setNames(numeric(length(b)), names(b))
    L[paste0("year:", plus)] <- 1; L[paste0("year:", minus)] <- -1
    e  <- k * sum(L * b)
    se <- k * sqrt(as.numeric(t(L) %*% V %*% L))
    p  <- 2 * pnorm(-abs(e / se))
    c(sprintf("%.4f [%.4f, %.4f]", e, e - 1.96 * se, e + 1.96 * se), sprintf("%.3f", p))
}
contrast.tab <- rbindlist(lapply(names(fits), function(m) {
    ca <- contrast.f(fits[[m]], "pct_C", "pct_A")
    ea <- contrast.f(fits[[m]], "pct_E", "pct_A")
    data.table(model = m, ca = ca[1], ca.p = ca[2], ea = ea[1], ea.p = ea[2])
}))
setnames(contrast.tab, c("", "C $-$ A [95\\% CI]", "p", "E $-$ A [95\\% CI]", "p"))
tab_contrast <- list(x = xtable(contrast.tab,
             caption = "Difference in the IWI trend (IWI units per year) between deforestation paths, per percentage point of the land area, with 95\\% confidence intervals and p-values. C $-$ A: one percentage point of the land going from forest to cropland instead of from forest to short vegetation; E $-$ A: from forest to built-up instead of to short vegetation. Models as in Table \\ref{tab:iwi-deforestation}.",
             label = "tab:contrast", align = c("l", "l", "r", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "small",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<iwi.observed.trend>>=
library(data.table)

obs.dt <- merge(bal[, list(area.name, top.level.region, country, year.of.interview,
                           average.iwi, average.education)],
                n.resp, by = c("year.of.interview", "area.name"))
obs.dt <- obs.dt[complete.cases(obs.dt)]
obs.dt[, n_years := uniqueN(year.of.interview), by = area.name]
obs.dt <- obs.dt[n_years >= 2]
## centre year so that the area intercepts are IWI in 2010
obs.dt[, t := year.of.interview - 2010]
setorder(obs.dt, area.name, t)

## 1. Unweighted fit, residuals and leverage (within-area intercept and slope)
fit.obs.0 <- fixest::feols(average.iwi ~ average.education | area.name[t], data = obs.dt)
obs.dt[, e0 := resid(fit.obs.0)]
obs.dt[, h := 1 / .N + (t - mean(t))^2 / sum((t - mean(t))^2), by = area.name]

## 2. Variance components: E[e^2 / (1 - h)] = tau^2 + sigma_w^2 / n
vc.fit <- lm(I(e0^2 / (1 - h)) ~ I(1 / n_respondents), data = obs.dt[h < 0.99])
vc <- coef(vc.fit); vc[is.na(vc)] <- 0
tau2.obs    <- max(vc[[1]], 0.01)
sigma2w.obs <- max(vc[[2]], 0)
obs.dt[, w := 1 / (tau2.obs + sigma2w.obs / n_respondents)]

## 3. Weighted fit; the weights are inverse variances
fit.obs <- fixest::feols(average.iwi ~ average.education | area.name[t], data = obs.dt, weights = ~ w)

fe <- fixest::fixef(fit.obs)
slope.name <- grep("\\[\\[", names(fe), value = TRUE)
obs.trend <- data.table(area.name = names(fe[[slope.name]]),
                        iwi_2010_obs = as.numeric(fe[["area.name"]][names(fe[[slope.name]])]),
                        iwi_slope_obs = as.numeric(fe[[slope.name]]))
sxx <- obs.dt[, list(sxx = sum(w * (t - weighted.mean(t, w))^2),
                     obs_first = min(year.of.interview), obs_last = max(year.of.interview)),
              by = area.name]
obs.trend <- merge(obs.trend, sxx, by = "area.name")
obs.trend[, iwi_slope_obs_se := sqrt(1 / sxx)]
obs.trend[, sxx := NULL]

## 4. Between-area variance of the true slopes (DerSimonian-Laird) and reliability per area
dl.w   <- 1 / obs.trend$iwi_slope_obs_se^2
dl.mu  <- sum(dl.w * obs.trend$iwi_slope_obs) / sum(dl.w)
dl.Q   <- sum(dl.w * (obs.trend$iwi_slope_obs - dl.mu)^2)
dl.C   <- sum(dl.w) - sum(dl.w^2) / sum(dl.w)
tau2.slope <- max(0, (dl.Q - (nrow(obs.trend) - 1)) / dl.C)
obs.trend[, iwi_slope_obs_rel := tau2.slope / (tau2.slope + iwi_slope_obs_se^2)]

## 5. Within-country trends: as above, but with fixed effects for country x interview year.
## All areas in a country are interviewed in the same DHS rounds, so a round that deviates
## (an unusual year, a change of method) affects every area in the country. Without these
## fixed effects that deviation is counted as noise in each area, which overstates the
## standard errors for comparisons within countries. With them, an area's slope is only
## identified relative to the other areas in its country, so it is expressed as the deviation
## from the (inverse-variance weighted) mean slope of the country.
wc.dt <- copy(obs.dt)[, c("e0", "h", "w") := NULL]
repeat {                     # drop single-area country-years and areas left with one year
    n0 <- nrow(wc.dt)
    wc.dt <- wc.dt[, if (.N >= 2) .SD, by = list(country, year.of.interview)]
    wc.dt <- wc.dt[, if (uniqueN(year.of.interview) >= 2) .SD, by = area.name]
    if (nrow(wc.dt) == n0) break
}
setorder(wc.dt, area.name, t)
fml.wc <- average.iwi ~ average.education | area.name[t] + country^year.of.interview
fit.wc.0 <- fixest::feols(fml.wc, data = wc.dt, notes = FALSE)
wc.dt <- wc.dt[fixest::obs(fit.wc.0)]
wc.dt[, e0 := resid(fit.wc.0)]
wc.dt[, h := 1 / .N + (t - mean(t))^2 / sum((t - mean(t))^2), by = area.name]
wc.dt[, h := pmin(h + 1 / .N, 0.999), by = list(country, year.of.interview)]
vc.wc <- coef(lm(I(e0^2 / (1 - h)) ~ I(1 / n_respondents), data = wc.dt[h < 0.99])); vc.wc[is.na(vc.wc)] <- 0
tau2.wc    <- max(vc.wc[[1]], 0.01)
sigma2w.wc <- max(vc.wc[[2]], 0)
wc.dt[, w := 1 / (tau2.wc + sigma2w.wc / n_respondents)]
fit.wc <- fixest::feols(fml.wc, data = wc.dt, weights = ~ w, notes = FALSE)
fe.wc <- fixest::fixef(fit.wc)
slope.name.wc <- grep("\\[\\[", names(fe.wc), value = TRUE)
wc.trend <- data.table(area.name = names(fe.wc[[slope.name.wc]]),
                       iwi_slope_wc = as.numeric(fe.wc[[slope.name.wc]]))
wc.trend <- merge(wc.trend,
                  wc.dt[, list(iwi_slope_wc_se = sqrt(1 / sum(w * (t - weighted.mean(t, w))^2)),
                               wc_country = country[1]), by = area.name],
                  by = "area.name")
wc.trend[, iwi_slope_wc := iwi_slope_wc - weighted.mean(iwi_slope_wc, 1 / iwi_slope_wc_se^2), by = wc_country]
wc.trend[, wc_country := NULL]
obs.trend <- merge(obs.trend, wc.trend, by = "area.name", all.x = TRUE)

## Add to the static data set and save it again
static.dt <- merge(static.dt, obs.trend, by = "area.name", all.x = TRUE)
saveRDS(static.dt, "paper_II_static.RDS")
write.csv(static.dt, file = "paper_II_static.csv", row.names = FALSE)
@

<<iwi.observed.trend.table>>=
library(xtable)
ot <- static.dt[!is.na(iwi_slope_obs)]
within.cor <- function(x, y, g) {
    d <- data.table(x, y, g)[, list(x = x - mean(x), y = y - mean(y)), by = g]
    cor(d$x, d$y)
}
obs.tab <- data.frame(
    c("areas with an observed trend",
      "mean slope (IWI units per year, inverse-variance weighted)",
      "standard deviation of the observed slopes",
      "median standard error of a slope",
      "standard deviation of the true slopes (DerSimonian--Laird)",
      "median reliability of a slope",
      "areas with reliability $\\geq$ 0.5",
      "correlation with the model-based slope (iwi\\_slope)",
      "correlation, within top level regions"),
    c(format(nrow(ot), big.mark = ","),
      sprintf("%.3f", dl.mu),
      sprintf("%.3f", sd(ot$iwi_slope_obs)),
      sprintf("%.3f", median(ot$iwi_slope_obs_se)),
      sprintf("%.3f", sqrt(tau2.slope)),
      sprintf("%.2f", median(ot$iwi_slope_obs_rel)),
      format(sum(ot$iwi_slope_obs_rel >= 0.5), big.mark = ","),
      sprintf("%.2f", cor(ot$iwi_slope_obs, ot$iwi_slope)),
      sprintf("%.2f", within.cor(ot$iwi_slope_obs, ot$iwi_slope, ot$top.level.region))))
tab_obs_trend <- list(x = xtable(obs.tab,
             caption = "The observed IWI trend per area (fixed intercept and slope per area, common coefficient for cohort education, weighted by the inverse of the estimated sampling variance of each area-year average) compared with the model-based trend. Reliability is the share of the variance of an area's slope that is between-area variation rather than sampling error.",
             label = "tab:obs-trend", align = c("l", "l", "r")),
    args = list(include.rownames = FALSE, include.colnames = FALSE, booktabs = TRUE,
      sanitize.text.function = identity, hline.after = c(-1, nrow(obs.tab))))

ot[, span := obs_last - obs_first]
span.tab <- ot[, list(areas = .N,
                      `sd of slopes` = sd(iwi_slope_obs),
                      `median s.e.` = median(iwi_slope_obs_se),
                      `median reliability` = median(iwi_slope_obs_rel)),
               by = list(`interview span (years)` =
                             cut(span, c(-Inf, 3, 6, 10, Inf), labels = c("0--3", "4--6", "7--10", "11+")))]
setorderv(span.tab, "interview span (years)")
tab_obs_trend_span <- list(x = xtable(span.tab,
             caption = "Precision of the observed IWI trend by the interview span, the number of years between the first and the last interview year in the area.",
             label = "tab:obs-trend-span", digits = c(0, 0, 0, 3, 3, 2)),
    args = list(include.rownames = FALSE, booktabs = TRUE, sanitize.text.function = identity))
@

<<drivers.categories>>=
library(data.table)
drv <- fread("forest_drivers_2000_2020.csv", encoding = "UTF-8")[valid_2000 > 0]
rs <- function(pattern) rowSums(drv[, .SD, .SDcols = patterns(pattern)])
drv[, `:=`(
    cat_P = 100 * (rs("^loss_oil_palm_to_") + palm_from_forest_forest) / valid_2000,
    cat_U = 100 * (rs("^loss_.*_to_builtup$") - loss_oil_palm_to_builtup) / valid_2000,
    cat_K = pct_loss_permanent_agriculture_to_cropland,
    cat_G = pct_loss_permanent_agriculture_to_shortveg,
    cat_S = 100 * (rs("^loss_shifting_cultivation_to_") - loss_shifting_cultivation_to_builtup) / valid_2000,
    cat_L = 100 * (rs("^loss_logging_to_") - loss_logging_to_builtup) / valid_2000,
    palm_nf = pct_palm_from_nonforest)]
drv[, cat_R := 100 * (loss_total + palm_from_forest_forest) / valid_2000 -
               (cat_P + cat_U + cat_K + cat_G + cat_S + cat_L)]

q2.dt <- merge(static.dt[!is.na(iwi_slope_wc)],
               drv[, list(area.name = region, cat_P, cat_U, cat_K, cat_G, cat_S, cat_L, cat_R, palm_nf)],
               by = "area.name")
q2.dt[, `:=`(nf_builtup  = 100 * (shortveg__builtup + cropland__builtup + other__builtup) / valid_2000,
             nf_cropland = 100 * (shortveg__cropland + other__cropland) / valid_2000)]
q2.vars <- c("cat_P", "cat_U", "cat_K", "cat_G", "cat_S", "cat_L", "cat_R")
q2.ctrl <- c("pct_B_shortveg_to_forest", "pct_D_cropland_to_forest", "nf_builtup", "nf_cropland",
             "palm_nf", "share.urban", "forest_share_2000", "iwi_2010_obs")
q2.dt <- q2.dt[complete.cases(q2.dt[, c("iwi_slope_wc", "iwi_slope_wc_se", q2.vars, q2.ctrl,
                                         "top.level.region", "country"), with = FALSE])]
q2.labels <- c(cat_P = "P: oil palm", cat_U = "U: built-up",
               cat_K = "K: permanent agriculture, cropland",
               cat_G = "G: permanent agriculture, short vegetation",
               cat_S = "S: shifting cultivation", cat_L = "L: logging", cat_R = "R: other")
## shorter labels for the model tables
q2.short <- c(cat_P = "P oil palm", cat_U = "U built-up", cat_K = "K perm.\\ agric., cropland",
              cat_G = "G perm.\\ agric., short veg.", cat_S = "S shifting cultivation",
              cat_L = "L logging", cat_R = "R other")
@

<<drivers.categories.table>>=
library(xtable)
cat.tab <- rbindlist(lapply(q2.vars, function(v) {
    x <- q2.dt[[v]]
    data.table(category = q2.labels[[v]], mean = mean(x), sd = sd(x), p90 = quantile(x, 0.9),
               max = max(x), `areas $>$ 1\\%` = sum(x > 1))
}))
setnames(cat.tab, "category", "")
tab_drivers_categories <- list(x = xtable(cat.tab,
             caption = paste0("Forest loss 2000--2020 by what replaced the forest, per cent of the land area in 2000, ",
                              format(nrow(q2.dt), big.mark = ","), " areas with an observed IWI trend."),
             label = "tab:drivers-categories", digits = c(0, 0, 3, 3, 3, 2, 0)),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<two.step.models>>=
q2.formula <- function(fe) as.formula(paste("iwi_slope_wc ~", paste(c(q2.vars, q2.ctrl), collapse = " + "),
                                            "|", fe))

## Residual between-area variance of the true slopes, Paule-Mandel estimator: the tau^2 for
## which sum(w * e^2) with w = 1 / (se^2 + tau^2) equals the residual degrees of freedom.
## fixest drops observations (e.g. regions with a single area), so the weights are aligned
## with the residuals through fixest::obs().
tau2.paule.mandel <- function(formula) {
    q.minus.df <- function(t2) {
        w <- 1 / (q2.dt$iwi_slope_wc_se^2 + t2)
        f <- fixest::feols(formula, data = q2.dt, weights = w, notes = FALSE)
        sum(w[fixest::obs(f)] * resid(f)^2) - (nobs(f) - f$nparams)
    }
    if (q.minus.df(0) <= 0) return(0)
    upper <- 1
    while (q.minus.df(upper) > 0) upper <- upper * 4
    uniroot(q.minus.df, c(0, upper), tol = 1e-6)$root
}
tau2.residual <- function(fe) tau2.paule.mandel(q2.formula(fe))
tau2.res.region <- tau2.residual("top.level.region")
q2.dt[, w.re := 1 / (iwi_slope_wc_se^2 + tau2.res.region)]

fit.q2.1 <- fixest::feols(q2.formula("top.level.region"), data = q2.dt, weights = ~ w.re, cluster = ~ country)
fit.q2.2 <- fixest::feols(q2.formula("country"), data = q2.dt, weights = ~ w.re, cluster = ~ country)
fit.q2.3 <- fixest::feols(q2.formula("top.level.region"), data = q2.dt, cluster = ~ country)
q2.fits <- list(`(1) weighted, region FE` = fit.q2.1, `(2) weighted, country FE` = fit.q2.2,
                `(3) unweighted, region FE` = fit.q2.3)

## Between-area standard deviation of the true slopes within top level regions,
## without and with the explanatory variables
tau.within.region <- sqrt(tau2.paule.mandel(iwi_slope_wc ~ 1 | top.level.region))
@

<<two.step.table>>=
cat.sd <- sapply(q2.vars, function(v) sd(q2.dt[[v]]))
est.ci.q2 <- function(fit, v, scale) {
    e <- coef(fit)[[v]] * scale; s <- fixest::se(fit)[[v]] * scale
    sprintf("%.3f [%.3f, %.3f]", e, e - 1.96 * s, e + 1.96 * s)
}
two.step.tab <- data.table(variable = q2.short[q2.vars],
                           sapply(q2.fits, function(f) sapply(q2.vars, function(v) est.ci.q2(f, v, cat.sd[[v]]))))
setnames(two.step.tab, c("", "(1)", "(2)", "(3)"))
tab_two_step <- list(x = xtable(two.step.tab,
             caption = paste0("Difference in the observed IWI trend (IWI units per year) associated with one standard deviation more of each category of forest loss 2000--2020, with 95\\% confidence intervals clustered by country. (1) weighted, fixed effects for top level region; (2) weighted, fixed effects for country; (3) unweighted, fixed effects for top level region. ",
                              format(nrow(q2.dt), big.mark = ","), " areas. Weights $1/(\\mathrm{se}^2 + \\tau^2_{\\mathrm{res}})$ with $\\hat\\tau_{\\mathrm{res}} = ",
                              sprintf("%.3f", sqrt(tau2.res.region)),
                              "$. Controls: regrowth (B, D), built-up, cropland and oil palm expansion on non-forest land, share of urban respondents, forest cover in 2000 and observed IWI in 2010."),
             label = "tab:two-step", align = c("l", "l", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<two.step.contrast>>=
contrast.q2 <- function(fit, plus, minus) {
    requireNamespace("fixest", quietly = TRUE)        # vcov() method for fixest objects
    b <- coef(fit); V <- vcov(fit)
    L <- setNames(numeric(length(b)), names(b)); L[plus] <- 1; L[minus] <- -1
    e <- sum(L * b); s <- sqrt(as.numeric(t(L) %*% V %*% L))
    c(sprintf("%.4f [%.4f, %.4f]", e, e - 1.96 * s, e + 1.96 * s), sprintf("%.3f", 2 * pnorm(-abs(e / s))))
}
pairs <- list(c("cat_P", "cat_S"), c("cat_K", "cat_S"), c("cat_G", "cat_S"), c("cat_L", "cat_S"), c("cat_K", "cat_G"))
contrast.q2.tab <- rbindlist(lapply(pairs, function(pr) {
    r1 <- contrast.q2(fit.q2.1, pr[1], pr[2]); r3 <- contrast.q2(fit.q2.3, pr[1], pr[2])
    data.table(contrast = paste0(sub(":.*", "", q2.labels[[pr[1]]]), " $-$ ", sub(":.*", "", q2.labels[[pr[2]]])),
               w = r1[1], w.p = r1[2], u = r3[1], u.p = r3[2])
}))
setnames(contrast.q2.tab, c("", "(1) [95\\% CI]", "p", "(3) [95\\% CI]", "p"))
tab_two_step_contrast <- list(x = xtable(contrast.q2.tab,
             caption = "Differences in the observed IWI trend (IWI units per year) between categories of forest loss, per percentage point of the land area. For example, P $-$ S compares an area where one percentage point of the land went from forest to oil palm with an area where it went to shifting cultivation. Models (1) and (3) of Table \\ref{tab:two-step}.",
             label = "tab:two-step-contrast", align = c("l", "l", "r", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<two.step.country.models>>=
## Q-profile 95% confidence interval for tau: the values of tau^2 for which the weighted sum of
## squared residuals lies between the 2.5% and 97.5% quantiles of chi-square(df)
tau.qprofile <- function(formula, level = 0.95) {
    q.at <- function(t2) {
        w <- 1 / (q2.dt$iwi_slope_wc_se^2 + t2)
        f <- fixest::feols(formula, data = q2.dt, weights = w, notes = FALSE)
        c(q = sum(w[fixest::obs(f)] * resid(f)^2), df = nobs(f) - f$nparams)
    }
    q0 <- q.at(0)
    target.hi <- qchisq((1 - level) / 2, q0[["df"]])        # gives the upper limit of tau^2
    target.lo <- qchisq(1 - (1 - level) / 2, q0[["df"]])    # gives the lower limit of tau^2
    find <- function(target) {
        if (q0[["q"]] <= target) return(0)
        upper <- 1
        while (q.at(upper)[["q"]] > target) upper <- upper * 4
        uniroot(function(t2) q.at(t2)[["q"]] - target, c(0, upper), tol = 1e-7)$root
    }
    sqrt(c(lower = find(target.lo), upper = find(target.hi)))
}

tau.within.country    <- sqrt(tau2.paule.mandel(iwi_slope_wc ~ 1 | country))
tau.within.country.ci <- tau.qprofile(iwi_slope_wc ~ 1 | country)
tau2.res.country      <- tau2.residual("country")
tau.res.country.ci    <- tau.qprofile(q2.formula("country"))

q2.dt[, w.re.country := 1 / (iwi_slope_wc_se^2 + tau2.res.country)]
fit.q2.c1 <- fixest::feols(q2.formula("country"), data = q2.dt, weights = ~ w.re.country, cluster = ~ country)
fit.q2.c2 <- fixest::feols(q2.formula("country"), data = q2.dt, cluster = ~ country)
## areas whose interviews span at least ten years
fit.q2.c3 <- fixest::feols(q2.formula("country"), data = q2.dt[obs_last - obs_first >= 10],
                           weights = ~ w.re.country, cluster = ~ country)
q2.country.fits <- list(`(4)` = fit.q2.c1, `(5)` = fit.q2.c2, `(6)` = fit.q2.c3)
@

<<two.step.country.table>>=
two.step.country.tab <- data.table(variable = q2.short[q2.vars],
                                   sapply(q2.country.fits, function(f)
                                       sapply(q2.vars, function(v) est.ci.q2(f, v, cat.sd[[v]]))))
setnames(two.step.country.tab, c("", "(4)", "(5)", "(6)"))
tab_two_step_country <- list(x = xtable(two.step.country.tab,
             caption = paste0("Difference in the observed IWI trend (IWI units per year) associated with one standard deviation more of each category of forest loss 2000--2020, comparing areas within the same country, with 95\\% confidence intervals clustered by country. (4) weighted, ",
                              format(nobs(fit.q2.c1), big.mark = ","), " areas; (5) unweighted; (6) weighted, areas with at least ten years between the first and the last interview (",
                              format(nobs(fit.q2.c3), big.mark = ","), " areas). Weights $1/(\\mathrm{se}^2 + \\tau^2_{\\mathrm{res}})$ with $\\hat\\tau_{\\mathrm{res}} = ",
                              sprintf("%.3f", sqrt(tau2.res.country)),
                              "$. Fixed effects for country and the same controls as in Table \\ref{tab:two-step}."),
             label = "tab:two-step-country", align = c("l", "l", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<two.step.country.contrast>>=
contrast.country.tab <- rbindlist(lapply(pairs, function(pr) {
    r4 <- contrast.q2(fit.q2.c1, pr[1], pr[2]); r6 <- contrast.q2(fit.q2.c3, pr[1], pr[2])
    data.table(contrast = paste0(sub(":.*", "", q2.labels[[pr[1]]]), " $-$ ", sub(":.*", "", q2.labels[[pr[2]]])),
               a = r4[1], a.p = r4[2], b = r6[1], b.p = r6[2])
}))
setnames(contrast.country.tab, c("", "(4) [95\\% CI]", "p", "(6) [95\\% CI]", "p"))
tab_two_step_country_contrast <- list(x = xtable(contrast.country.tab,
             caption = "Differences in the observed IWI trend (IWI units per year) between categories of forest loss, per percentage point of the land area, comparing areas within the same country. Models (4) and (6) of Table \\ref{tab:two-step-country}.",
             label = "tab:two-step-country-contrast", align = c("l", "l", "r", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<sensitivity.loo>>=
latex.escape <- function(x) gsub("([&%#_$])", "\\\\\\1", x)
## share of the oil palm area (P, in land area units) by country
palm.by.country <- q2.dt[, list(palm = sum(cat_P * valid_2000)), by = country][order(-palm)]
palm.by.country[, share := palm / sum(palm)]

## leave one country out, model (4). The weights are computed here: columns added to q2.dt
## with := in another chunk are not restored when that chunk is loaded from the knitr cache.
loo.one <- function(excluded) {
    d <- if (is.na(excluded)) copy(q2.dt) else q2.dt[country != excluded]
    d[, w.loo := 1 / (iwi_slope_wc_se^2 + tau2.res.country)]
    f <- fixest::feols(q2.formula("country"), data = d, weights = ~ w.loo, cluster = ~ country,
                       notes = FALSE)
    ps <- contrast.q2(f, "cat_P", "cat_S")
    data.table(excluded = ifelse(is.na(excluded), "none (all countries)", excluded),
               areas = nobs(f),
               P = coef(f)[["cat_P"]] * cat.sd[["cat_P"]],
               S = coef(f)[["cat_S"]] * cat.sd[["cat_S"]],
               PS = sum(coef(f)[c("cat_P", "cat_S")] * c(1, -1)),
               PS.ci = ps[1], PS.p = as.numeric(ps[2]))
}
loo.dt <- rbindlist(c(list(loo.one(NA)), lapply(sort(unique(q2.dt$country)), loo.one)))
loo.full <- loo.dt[1]
loo.dt <- loo.dt[-1][, change := abs(PS - loo.full$PS)]
@

<<sensitivity.loo.table>>=
loo.tab <- rbind(loo.full, head(loo.dt[order(-change)], 8), fill = TRUE)[, list(
    `country left out` = latex.escape(excluded), areas = format(areas, big.mark = ","),
    `P (per sd)` = sprintf("%.3f", P), `S (per sd)` = sprintf("%.3f", S),
    `P $-$ S (per pp) [95\\% CI]` = PS.ci, p = sprintf("%.3f", PS.p))]
tab_loo <- list(x = xtable(loo.tab,
             caption = "Model (4) of Table \\ref{tab:two-step-country} re-estimated leaving out one country at a time: the full sample and the eight countries whose exclusion changes the contrast P $-$ S (oil palm $-$ shifting cultivation, IWI units per year per percentage point of the land area) the most.",
             label = "tab:loo", align = c("l", "l", "r", "r", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity,
      hline.after = c(-1, 0, 1, nrow(loo.tab))))
@

<<sensitivity.split.R>>=
## components of R, per cent of the land area in 2000 (losses that did not become built-up)
nb <- function(driver) 100 * (rs(paste0("^loss_", driver, "_to_")) -
                              drv[[paste0("loss_", driver, "_to_builtup")]]) / drv$valid_2000
r.split <- data.table(area.name = drv$region,
                      r_mining  = nb("hard_commodities"),
                      r_fire    = nb("wildfire"),
                      r_natural = nb("other_natural_disturbances"),
                      r_none    = nb("none"),
                      r_settl   = nb("settlements_infrastructure"),
                      r_agother = drv$pct_loss_permanent_agriculture_to_other)
q2.dt <- merge(q2.dt, r.split, by = "area.name", all.x = TRUE)
r.vars <- c("r_mining", "r_fire", "r_natural", "r_none", "r_settl", "r_agother")
stopifnot(max(abs(rowSums(q2.dt[, ..r.vars]) - q2.dt$cat_R)) < 1e-6)   # the components add up to R
r.labels <- c(r_mining = "R1 mining, energy", r_fire = "R2 wildfire", r_natural = "R3 other natural disturbances",
              r_none = "R4 no driver", r_settl = "R5 settlements, not built-up",
              r_agother = "R6 perm.\\ agric., other classes")

vars.split <- c(setdiff(q2.vars, "cat_R"), r.vars)
f.split <- as.formula(paste("iwi_slope_wc ~", paste(c(vars.split, q2.ctrl), collapse = " + "), "| country"))
tau2.split <- tau2.paule.mandel(f.split)
q2.dt[, w.split := 1 / (iwi_slope_wc_se^2 + tau2.split)]
fit.split <- fixest::feols(f.split, data = q2.dt, weights = ~ w.split, cluster = ~ country)
@

<<sensitivity.split.R.table>>=
split.sd <- sapply(vars.split, function(v) sd(q2.dt[[v]]))
split.tab <- data.table(variable = c(q2.short[setdiff(q2.vars, "cat_R")], r.labels),
                        mean = sapply(vars.split, function(v) sprintf("%.3f", mean(q2.dt[[v]]))),
                        est = sapply(vars.split, function(v) est.ci.q2(fit.split, v, split.sd[[v]])))
setnames(split.tab, c("", "mean (\\%)", "estimate per sd [95\\% CI]"))
tab_split_R <- list(x = xtable(split.tab,
             caption = paste0("Model (4) of Table \\ref{tab:two-step-country} with category R split into its components: difference in the observed IWI trend (IWI units per year) per standard deviation, comparing areas within the same country, with 95\\% confidence intervals clustered by country. $\\hat\\tau_{\\mathrm{res}} = ",
                              sprintf("%.3f", sqrt(tau2.split)), "$."),
             label = "tab:split-R", align = c("l", "l", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@

<<sensitivity.loo.L>>=
logging.by.country <- q2.dt[, list(logging = sum(cat_L * valid_2000)), by = country][order(-logging)]
logging.by.country[, share := logging / sum(logging)]

## weights computed here, see the comment in chunk sensitivity.loo
loo.L.one <- function(excluded) {
    d <- if (is.na(excluded)) copy(q2.dt) else q2.dt[country != excluded]
    d[, w.loo := 1 / (iwi_slope_wc_se^2 + tau2.res.country)]
    f <- fixest::feols(q2.formula("country"), data = d, weights = ~ w.loo, cluster = ~ country,
                       notes = FALSE)
    e <- coef(f)[["cat_L"]] * cat.sd[["cat_L"]]; s <- fixest::se(f)[["cat_L"]] * cat.sd[["cat_L"]]
    data.table(excluded = ifelse(is.na(excluded), "none (all countries)", excluded),
               areas = nobs(f), L = e, L.lo = e - 1.96 * s, L.hi = e + 1.96 * s,
               L.p = fixest::pvalue(f)[["cat_L"]])
}
loo.L.dt <- rbindlist(c(list(loo.L.one(NA)), lapply(sort(unique(q2.dt$country)), loo.L.one)))
loo.L.full <- loo.L.dt[1]
loo.L.dt <- loo.L.dt[-1][, change := abs(L - loo.L.full$L)]
@

<<sensitivity.loo.L.table>>=
loo.L.tab <- rbind(loo.L.full, head(loo.L.dt[order(-change)], 8), fill = TRUE)[, list(
    `country left out` = latex.escape(excluded), areas = format(areas, big.mark = ","),
    `share of logging` = ifelse(excluded %in% logging.by.country$country,
                                sprintf("%.1f\\%%", 100 * logging.by.country$share[match(excluded, logging.by.country$country)]), ""),
    `L (per sd) [95\\% CI]` = sprintf("%.3f [%.3f, %.3f]", L, L.lo, L.hi), p = sprintf("%.3f", L.p))]
tab_loo_L <- list(x = xtable(loo.L.tab,
             caption = "Model (4) of Table \\ref{tab:two-step-country} re-estimated leaving out one country at a time: the full sample and the eight countries whose exclusion changes the estimate for L (logging, IWI units per year per standard deviation) the most. Share of logging: the country's share of all forest loss to logging in the areas of the analysis.",
             label = "tab:loo-L", align = c("l", "l", "r", "r", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity,
      hline.after = c(-1, 0, 1, nrow(loo.L.tab))))
@

<<palm.split.data, cache.extra = tools::md5sum("forest_drivers_2000_2020.csv")>>=
library(data.table)
## read the file again: chunk drivers.categories may come from the cache, made before the
## file had the columns by plantation type
drv.palm <- fread("forest_drivers_2000_2020.csv", encoding = "UTF-8")[valid_2000 > 0]
pc <- function(cols) 100 * rowSums(drv.palm[, ..cols]) / drv.palm$valid_2000
pf <- function(type, period) paste0("palm_from_forest_", type, "_", period)
## untyped oil palm (planting year, but not in the 2021 extent map) is counted as smallholder
palm.split <- data.table(
    area.name   = drv.palm$region,
    p_ind       = pc(c(pf("industrial", "early"), pf("industrial", "late"))),
    p_sm        = pc(c(pf(c("smallholder", "untyped"), "early"), pf(c("smallholder", "untyped"), "late"))),
    p_sm.only   = pc(c(pf("smallholder", "early"), pf("smallholder", "late"))),
    p_un        = pc(c(pf("untyped", "early"), pf("untyped", "late"))),
    p_early     = pc(pf(c("industrial", "smallholder", "untyped"), "early")),
    p_late      = pc(pf(c("industrial", "smallholder", "untyped"), "late")),
    p_ind_early = pc(pf("industrial", "early")),  p_ind_late = pc(pf("industrial", "late")),
    p_sm_early  = pc(pf(c("smallholder", "untyped"), "early")),
    p_sm_late   = pc(pf(c("smallholder", "untyped"), "late")),
    palm_old    = drv.palm$pct_palm_before)
q2p <- merge(q2.dt, palm.split, by = "area.name")
## the split adds up to P, apart from oil palm on cells with no data in 2020
palm.split.check <- max(abs(q2p[, p_ind + p_sm] - q2p$cat_P))

palm.labels <- c(p_ind = "P industrial", p_sm = "P smallholder",
                 p_early = "P planted 2001--2010", p_late = "P planted 2011--2020",
                 p_ind_early = "P industrial, 2001--2010", p_ind_late = "P industrial, 2011--2020",
                 p_sm_early = "P smallholder, 2001--2010", p_sm_late = "P smallholder, 2011--2020",
                 palm_old = "oil palm planted before 2001", cat_S = "S shifting cultivation")
palm.n <- sapply(names(palm.labels), function(v) sum(q2p[[v]] > 1))
@

<<palm.split.models>>=
## Paule-Mandel tau^2 for a formula and data set (weights aligned with fixest::obs())
tau2.pm.on <- function(formula, data) {
    q.minus.df <- function(t2) {
        w <- 1 / (data$iwi_slope_wc_se^2 + t2)
        f <- fixest::feols(formula, data = data, weights = w, notes = FALSE)
        sum(w[fixest::obs(f)] * resid(f)^2) - (nobs(f) - f$nparams)
    }
    if (q.minus.df(0) <= 0) return(0)
    upper <- 1
    while (q.minus.df(upper) > 0) upper <- upper * 4
    uniroot(q.minus.df, c(0, upper), tol = 1e-6)$root
}
others <- setdiff(q2.vars, "cat_P")
palm.specs <- list(type   = c("p_ind", "p_sm", "palm_old"),
                   period = c("p_early", "p_late", "palm_old"),
                   both   = c("p_ind_early", "p_ind_late", "p_sm_early", "p_sm_late", "palm_old"))
palm.fits <- lapply(palm.specs, function(pv) {
    fml <- as.formula(paste("iwi_slope_wc ~", paste(c(pv, others, q2.ctrl), collapse = " + "), "| country"))
    t2 <- tau2.pm.on(fml, q2p)
    d <- copy(q2p)[, w.palm := 1 / (iwi_slope_wc_se^2 + t2)]
    list(fit = fixest::feols(fml, data = d, weights = ~ w.palm, cluster = ~ country), tau2 = t2)
})
@

<<palm.split.table>>=
est.ci.pp <- function(fit, v) {
    if (!v %in% names(coef(fit))) return("")
    e <- coef(fit)[[v]]; s <- fixest::se(fit)[[v]]
    sprintf("%.3f [%.3f, %.3f]", e, e - 1.96 * s, e + 1.96 * s)
}
## one block of rows per model
palm.tab <- rbindlist(lapply(names(palm.specs), function(m) {
    vars <- c(palm.specs[[m]], "cat_S")
    data.table(model = c(type = "(7) by type", period = "(8) by period", both = "(9) by type and period")[[m]],
               variable = palm.labels[vars], areas = palm.n[vars],
               est = sapply(vars, function(v) est.ci.pp(palm.fits[[m]]$fit, v)))
}))
palm.tab[duplicated(model), model := ""]
setnames(palm.tab, c("model", "", "areas $>$ 1\\%", "per pp [95\\% CI]"))
tab_palm_split <- list(x = xtable(palm.tab,
             caption = paste0("Oil palm on former forest land by plantation type and planting period: difference in the observed IWI trend (IWI units per year) per percentage point of the land area, comparing areas within the same country, with 95\\% confidence intervals clustered by country. ",
                              format(nobs(palm.fits$type$fit), big.mark = ","), " areas. Same controls and the other categories of forest loss as in Table \\ref{tab:two-step-country}; $\\hat\\tau_{\\mathrm{res}}$ = ",
                              paste(sprintf("%.3f", sqrt(sapply(palm.fits, `[[`, "tau2"))), collapse = ", "),
                              " for models (7)--(9). (7) by plantation type, (8) by planting period, (9) by type and period; untyped oil palm is counted as smallholder. Areas $>$ 1\\%: areas with more than 1\\% of the land area in the category."),
             label = "tab:palm-split", align = c("l", "l", "l", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity,
      hline.after = c(-1, 0, cumsum(lengths(palm.specs) + 1))))
@

<<palm.split.contrast>>=
palm.contrasts <- list(
    list("type", "p_sm", "p_ind", "smallholder $-$ industrial"),
    list("type", "p_ind", "cat_S", "industrial $-$ shifting cultivation"),
    list("type", "p_sm", "cat_S", "smallholder $-$ shifting cultivation"),
    list("period", "p_early", "p_late", "planted 2001--2010 $-$ 2011--2020"),
    list("period", "p_early", "cat_S", "planted 2001--2010 $-$ shifting cultivation"),
    list("period", "p_late", "cat_S", "planted 2011--2020 $-$ shifting cultivation"),
    list("both", "p_sm_early", "p_ind_early", "smallholder $-$ industrial, 2001--2010"),
    list("both", "p_sm_late", "p_ind_late", "smallholder $-$ industrial, 2011--2020"))
palm.contrast.tab <- rbindlist(lapply(palm.contrasts, function(x) {
    r <- contrast.q2(palm.fits[[x[[1]]]]$fit, x[[2]], x[[3]])
    data.table(contrast = x[[4]], model = c(type = "(7)", period = "(8)", both = "(9)")[[x[[1]]]],
               est = r[1], p = r[2])
}))
setnames(palm.contrast.tab, c("", "model", "per pp [95\\% CI]", "p"))
tab_palm_split_contrast <- list(x = xtable(palm.contrast.tab,
             caption = "Differences in the observed IWI trend (IWI units per year) between kinds of oil palm, and between oil palm and shifting cultivation, per percentage point of the land area, comparing areas within the same country. Models of Table \\ref{tab:palm-split}.",
             label = "tab:palm-split-contrast", align = c("l", "l", "c", "r", "r")),
    args = list(include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity))
@


<<rq1.lmer.data>>=
## RQ1: area-year IWI with the cumulative forest loss since 2000 as a time-varying predictor.
## Interview years 2000-2020 (the years covered by the yearly interpolated forest data).
library(data.table)
rq1.long <- merge(bal[, list(country, top.level.region, area.name, year.of.interview,
                             average.iwi, average.education)],
                  n.resp, by = c("year.of.interview", "area.name"))
rq1.fc <- deforestation_yearly.dt[, list(area.name = region, year.of.interview = year,
                                         forest_loss = -forestation_change)]
## forest cover change in percentage points of the land area (the data may be stored as shares)
if (max(abs(rq1.fc$forest_loss), na.rm = TRUE) <= 1) rq1.fc[, forest_loss := 100 * forest_loss]
rq1.long <- merge(rq1.long, rq1.fc, by = c("area.name", "year.of.interview"))
rq1.long <- rq1.long[complete.cases(rq1.long)]
rq1.long[, `:=`(t = (year.of.interview - 2010) / 10,          # decades from 2010
                w = n_respondents / mean(n_respondents))]
@

<<rq1.lmer.models>>=
library(lme4)
rq1.ctrl <- lmerControl(optimizer = "bobyqa", calc.derivs = FALSE)
## effect of forest loss varying between countries and between top level regions within countries
fit.rq1 <- lmer(average.iwi ~ t + forest_loss + average.education + (1 | area.name) +
                    (1 + t + forest_loss || top.level.region) + (1 + t + forest_loss || country),
                data = rq1.long, weights = w, control = rq1.ctrl)
## the same model with a common effect of forest loss
fit.rq1.0 <- lmer(average.iwi ~ t + forest_loss + average.education + (1 | area.name) +
                      (1 + t || top.level.region) + (1 + t || country),
                  data = rq1.long, weights = w, control = rq1.ctrl)
rq1.lrt <- anova(fit.rq1.0, fit.rq1, refit = FALSE)
rq1.vc <- as.data.table(as.data.frame(VarCorr(fit.rq1)))
rq1.vc[, grp := sub("\\.[0-9]+$", "", grp)]
rq1.sd <- function(g) rq1.vc[grp == g & var1 == "forest_loss", sdcor]

## effect of forest loss per country and per top level region: fixed effect plus the
## conditional modes; the variance adds the conditional variances (covariances ignored)
rq1.b  <- fixef(fit.rq1)[["forest_loss"]]
rq1.vb <- vcov(fit.rq1)["forest_loss", "forest_loss"]
rq1.re <- as.data.table(as.data.frame(ranef(fit.rq1, condVar = TRUE)))[term == "forest_loss"]
rq1.country <- rq1.re[grpvar == "country", list(country = as.character(grp), c.val = condval, c.sd = condsd)]
rq1.country[, `:=`(est = rq1.b + c.val, se = sqrt(rq1.vb + c.sd^2))]
rq1.region <- rq1.re[grpvar == "top.level.region",
                     list(top.level.region = as.character(grp), r.val = condval, r.sd = condsd)]
rq1.region <- merge(rq1.region, unique(rq1.long[, list(top.level.region, country)]), by = "top.level.region")
rq1.region <- merge(rq1.region, rq1.country[, list(country, c.val, c.sd)], by = "country")
rq1.region[, `:=`(est = rq1.b + c.val + r.val, se = sqrt(rq1.vb + c.sd^2 + r.sd^2))]
rq1.sig <- function(est, se) ifelse(est - qnorm(0.975) * se > 0, "positive",
                                    ifelse(est + qnorm(0.975) * se < 0, "negative", "includes zero"))
rq1.country[, sig := rq1.sig(est, se)]
rq1.region[, sig := rq1.sig(est, se)]
@


<<rq1b.lmer.models>>=
## Alternative specification: intercept and time trend correlated within region and country,
## effect of forest loss uncorrelated with them.
library(lme4); library(data.table)
fit.rq1b <- lmer(average.iwi ~ t + forest_loss + average.education + (1 | area.name) +
                     (1 + t | top.level.region) + (0 + forest_loss | top.level.region) +
                     (1 + t | country) + (0 + forest_loss | country),
                 data = rq1.long, weights = w, control = rq1.ctrl)
## the same model with a common effect of forest loss
fit.rq1b.0 <- lmer(average.iwi ~ t + forest_loss + average.education + (1 | area.name) +
                       (1 + t | top.level.region) + (1 + t | country),
                   data = rq1.long, weights = w, control = rq1.ctrl)
rq1b.lrt <- anova(fit.rq1b.0, fit.rq1b, refit = FALSE)
## comparison with fit.rq1 (same fixed and forest-loss terms; adds the intercept-trend correlations)
rq1b.vs.rq1 <- anova(fit.rq1, fit.rq1b, refit = FALSE)
rq1b.vc <- as.data.table(as.data.frame(VarCorr(fit.rq1b)))
rq1b.vc[, grp := sub("\\.[0-9]+$", "", grp)]
rq1b.sd  <- function(g) rq1b.vc[grp == g & var1 == "forest_loss" & is.na(var2), sdcor]
rq1b.cor <- function(g) rq1b.vc[grp == g & var1 == "(Intercept)" & var2 == "t", sdcor]

## effect of forest loss per country and per top level region (as for fit.rq1)
rq1b.b  <- fixef(fit.rq1b)[["forest_loss"]]
rq1b.vb <- vcov(fit.rq1b)["forest_loss", "forest_loss"]
rq1b.re <- as.data.table(as.data.frame(ranef(fit.rq1b, condVar = TRUE)))[term == "forest_loss"]
rq1b.country <- rq1b.re[grpvar == "country", list(country = as.character(grp), c.val = condval, c.sd = condsd)]
rq1b.country[, `:=`(est = rq1b.b + c.val, se = sqrt(rq1b.vb + c.sd^2))]
rq1b.region <- rq1b.re[grpvar == "top.level.region",
                       list(top.level.region = as.character(grp), r.val = condval, r.sd = condsd)]
rq1b.region <- merge(rq1b.region, unique(rq1.long[, list(top.level.region, country)]), by = "top.level.region")
rq1b.region <- merge(rq1b.region, rq1b.country[, list(country, c.val, c.sd)], by = "country")
rq1b.region[, `:=`(est = rq1b.b + c.val + r.val, se = sqrt(rq1b.vb + c.sd^2 + r.sd^2))]
rq1b.sig <- function(est, se) ifelse(est - qnorm(0.975) * se > 0, "positive",
                                     ifelse(est + qnorm(0.975) * se < 0, "negative", "includes zero"))
rq1b.country[, sig := rq1b.sig(est, se)]
rq1b.region[, sig := rq1b.sig(est, se)]
## agreement with fit.rq1
rq1b.agree <- merge(rq1.region[, list(top.level.region, est.a = est, sig.a = sig)],
                    rq1b.region[, list(top.level.region, est.b = est, sig.b = sig)], by = "top.level.region")
@


\section{Methods and data}
\label{sec:methods}

% DRAFT. Numbers marked TODO should be replaced by \Sexpr{} once the chunks that compute
% them have been moved before this section (\Sexpr is evaluated in document order).

\subsection{Study period}
\label{sec:study-period}

Land cover is observed in two years, 2000 and 2020, and forest loss is measured as the change between them. Living conditions are observed in the years when DHS surveys were carried out in an area, which differ between countries and areas. % TODO: range and median of first and last interview year (Table \ref{tab:n-surveys})
For each area we estimate a linear trend in average household wealth over all interview years, and relate that trend to the forest loss 2000--2020. The interview years do not coincide with the period of forest loss: in a typical area the first survey was carried out in the 2000s and the last in the 2010s. % TODO: check against Table \ref{tab:n-surveys}
The trend is therefore a summary of the development of household wealth during, roughly, the same two decades as the forest loss, not a measurement of wealth before and after it. Since the drivers of forest loss are recorded per year 2001--2025 and the oil palm planting year per year 1990--2021, the timing of the conversion can be used for some of the categories (Section \ref{sec:palm-split}).

\subsection{Study area and its partitioning}
\label{sec:study-area}

The study area consists of the administrative areas in low- and middle-income countries where the DHS has carried out surveys with GPS coordinates for the sampled villages and urban neighbourhoods (clusters). % TODO: number of countries (55?) and surveys
The areas are those of a published data set of forest cover and forest change per administrative area \citep{Ekbrand2026forest}. It is based on the GADM boundaries \citep{Hijmans_GADM_v41}, with areas merged to ensure DHS coverage. % TODO: describe the GADM level(s) used and the merging rule
Each DHS cluster is assigned to the area that contains its coordinates. The DHS displaces the coordinates of the clusters by up to 2 km in urban and up to 5 km in rural areas (up to 10 km for one per cent of the rural clusters) to protect the anonymity of respondents, so some clusters close to a boundary are assigned to the neighbouring area. Since the areas are much larger than the displacement, this adds some noise but should not bias the results. % TODO: median area size

The land cover data are raster data at 30 m and 1 km resolution, while the areas are polygons of varying size. Every raster cell is counted with the fraction of the cell that lies inside the area (coverage-fraction weighting, \citealt{exactextractr}), so that cells on a boundary are split between the areas they belong to. All land cover variables are expressed as per cent of the land area of the area in 2000.

\subsection{Data on living conditions}
\label{sec:data-dhs}

Living conditions are measured with the International Wealth Index (IWI, \citealt{Smits2014}), an asset index that ranges from 0 to 100 and is comparable across countries and over time. It is based on the household's ownership of consumer durables, access to water and sanitation, and the quality of the dwelling. The DHS household files are harmonised and linked to the areas with the R package \texttt{globallivingconditions} \citep{Ekbrand_dhsharmonisation}. For every area and interview year we compute the average IWI of the interviewed households and the number of respondents.

The DHS samples different villages in each survey round, so part of the change in average IWI between two surveys reflects which villages were sampled rather than change over time. To correct for this, we use the average years of education of the respondents born 1960--1976. Their education was completed before the study period, so changes in their average education between surveys in the same area mainly reflect which villages and households were sampled. Including it as a control in the trend model adjusts the IWI of each survey for how well-off the sampled part of the area was. The variables derived from the DHS are listed in Table \ref{tab:vars-dhs}.

\subsection{Data on land cover, drivers of forest loss and oil palm}
\label{sec:data-landcover}
\label{sec:data-map}

Forest and other land cover in 2000 and 2020 are taken from the Global Land Cover and Land Use Change data set (GLCLU, \citealt{Potapov2022}), which classifies every 30 m cell as forest (trees at least 5 m tall), short vegetation, cropland, built-up land, water or other. GLCLU tells what the land is in 2020, but not what activity replaced the forest: a plantation of tall trees is classified as forest, and pasture, fallow and young tree crops are all short vegetation. We therefore combine GLCLU with two data sets on the use of the land.

The first is the dominant driver of forest loss 2001--2025 in each 1 km cell \citep[v1.3]{Sims2025drivers}. The drivers are permanent agriculture (long-term establishment of cropland, pasture and tree crops), hard commodities (mining and energy), shifting cultivation (forest cleared for temporary cultivation and left to regrow), logging (forest management and logging, including wood fibre plantations), wildfire, settlements and infrastructure, and other natural disturbances. The second is the planting year of oil palm 1990--2021 at 30 m and the oil palm extent in 2021, which distinguishes industrial from smallholder plantations \citep{Descals2024}. It identifies oil palm planted on former forest land also where GLCLU still classifies the palms as forest.

Every 30 m cell that was forest in 2000 and not in 2020, or where oil palm was planted 2001--2020 on land that was forest in 2000, is assigned to exactly one of seven categories, in this order: a cell with oil palm planted 2001--2020 is oil palm (P), whatever its class in 2020; of the other cells, those that are built-up land in 2020 are built-up (U), whatever the driver; the remaining cells are classified by the driver of their 1 km cell and, for permanent agriculture, by their GLCLU class in 2020. The categories are:

\begin{description}
\item[P, oil palm:] oil palm planted 2001--2020 on land that was forest in 2000, including palms that GLCLU still classifies as forest in 2020. P is split by plantation type, industrial or smallholder (oil palm with a planting year but not in the 2021 extent map is counted as smallholder), and by planting period, 2001--2010 or 2011--2020.
\item[U, built-up:] forest that became built-up land.
\item[K, permanent agriculture, cropland:] driver permanent agriculture and cropland in 2020, that is, annual crops.
\item[G, permanent agriculture, short vegetation:] driver permanent agriculture and short vegetation in 2020: pasture, fallow, and tree crops other than oil palm that are shorter than 5 m. Tree crops such as cocoa and rubber therefore end up in G while they are young; tree crops that are taller than 5 m in 2020 are classified as forest by GLCLU and do not count as forest loss at all.
\item[S, shifting cultivation:] driver shifting cultivation.
\item[L, logging:] driver logging.
\item[R, other:] all other forest loss: hard commodities, wildfire, other natural disturbances, the settlements and infrastructure driver where the land is not built-up in 2020, loss in 1 km cells without a driver, and permanent agriculture where the land is neither cropland nor short vegetation in 2020.
\end{description}

All categories are expressed as per cent of the land area of the area in 2000, and they add up to the total forest loss. Two approximations should be noted. The driver is recorded per 1 km cell, so every 30 m cell with forest loss in a 1 km cell gets the dominant driver of that cell, also where several processes occur side by side. And the drivers refer to forest loss 2001--2025, while forest loss is measured between 2000 and 2020. The categories, like all land cover variables, are aggregated to the areas with coverage-fraction weights (Section \ref{sec:study-area}). We also measure the transitions in the other direction, from short vegetation and cropland to forest (regrowth), and the expansion of built-up land, cropland and oil palm on land that was not forest in 2000. All variables are listed in Table \ref{tab:vars-landcover}. Figure \ref{fig:map.categories} in Section \ref{sec:res-descriptive} shows where the forest was lost, and what replaced it.

\subsection{Data coverage}
\label{sec:coverage}

An area-specific trend in IWI requires at least two interview years. Of the \Sexpr{format(nrow(static.dt), big.mark = ",")} areas in the data set, \Sexpr{format(sum(!is.na(static.dt$iwi_slope_wc)), big.mark = ",")} have at least two interview years and a within-country trend, and \Sexpr{format(nrow(q2.dt), big.mark = ",")} of them have complete data on land cover and controls and enter the models.
The precision of the trends varies a lot between areas. It depends on the number of interview years, how far apart they are, and the number of respondents in each, and in countries with only two or three survey rounds a large part of the variation in observed trends is sampling error. We take this into account by weighting the areas by the precision of their trend (Section \ref{sec:strategy}), and we report the reliability of the trends: the share of the variation in observed trends that is variation in true trends rather than sampling error. The median reliability is \Sexpr{sprintf("%.2f", median(ot$iwi_slope_obs_rel))}, and it increases with the time between the first and the last interview year (Table \ref{tab:obs-trend-span}).

<<show.tab_obs_trend_span, results = "asis", cache = FALSE>>=
show.tab(tab_obs_trend_span)
@

The weighting also means that countries with few or short surveys contribute little. Indonesia, with many areas and much of the oil palm expansion, has large standard errors for its area trends and carries little weight; the oil palm results are driven mainly by West Africa and Peru. % TODO: verify and quantify

\subsection{Analytical strategy}
\label{sec:strategy}

The analysis has two steps. In the first step we estimate an observed IWI trend for every area with at least two interview years: a regression of the average IWI per area and interview year on year, with an intercept and a slope of its own for each area, the average education of the 1960--1976 cohort as a control, and fixed effects for each combination of country and interview year, which absorb national shocks and differences between survey rounds. The area slopes are therefore measured relative to other areas in the same country. The variance of each area-year average is modelled as the sum of a between-village component and a between-household component that decreases with the number of respondents, and the trends are estimated with inverse-variance weights. This gives a trend and a standard error for every area (Section \ref{sec:obs-trend}). We use this observed trend rather than the trend predicted by a mixed model with random slopes for area, top level region and country: in such a model the estimated variance of the area-specific slopes is close to zero, so the predicted trend of an area is in practice the trend of its region and country, and any association with local deforestation would be shrunk to zero before the analysis starts.

For the first research question, where deforestation is associated with improved or worsened living conditions, we describe how the trends vary between areas with forest loss, and estimate how much of that variation is real rather than sampling error (the between-area standard deviation $\tau$, within countries and within top level regions). We then estimate the effect of forest loss on the level of IWI in a linear mixed model of the area-year averages, where the effect of forest loss varies between countries and between top level regions within countries, and map the estimated effects (Section \ref{sec:res-rq1}).

For the second research question, whether what replaced the forest predicts the trend, we regress the area trends on the seven categories of forest loss in a meta-regression: a weighted least squares regression where each area is weighted by the inverse of its sampling variance plus the residual between-area variance, estimated with the method of \citet{PauleMandel1982}. The models control for regrowth, expansion of built-up land, cropland and oil palm on non-forest land, the share of urban respondents, the forest cover in 2000 and the IWI level of the area in 2010, and include fixed effects for country. Standard errors are clustered by country. The coefficients of the categories are compared with each other, in particular each category with shifting cultivation, since the question is not whether forest loss is good or bad but whether what replaced the forest matters. Oil palm is further split by plantation type and planting period. If the benefits of industrial plantations accrue mainly to companies and workers from elsewhere, smallholder oil palm should be associated with a better IWI trend than industrial oil palm; and since oil palm takes several years to reach full production, palms planted 2001--2010 should matter more than palms planted 2011--2020. To separate the maturity of the plantations from long-established oil palm economies, these models also control for oil palm planted before 2001 (on any land). As robustness checks we estimate the models with fixed effects for top level regions, without weights, for areas whose interviews span at least ten years, leaving out one country at a time, and with the residual category R split into its components. The full model specifications are given in Appendix \ref{sec:model-specs}.

This is an observational design. The categories of forest loss are not randomly assigned, and an association between a category and the IWI trend may reflect where that kind of conversion takes place rather than its consequences. The country fixed effects and the controls for initial wealth, urbanisation and forest cover remove some of these differences, but not all.


\section{Results}
\label{sec:results}

% DRAFT. This section is placed after the working sections because \Sexpr{} and the
% tables need the objects computed there. When the working sections are trimmed, keep
% their chunks (with the prose removed) and move the tables that are cited below.

\subsection{Where is deforestation associated with improved living conditions?}
\label{sec:res-rq1}

To locate where deforestation is associated with improved or worsened living conditions, we model the level of IWI in each area and interview year, with the forest loss up to the interview year as a predictor whose effect may differ between countries and between regions within countries. The unit is the area-year, with interviews 2000--2020 (\Sexpr{format(nrow(rq1.long), big.mark = ",")} area-years in \Sexpr{format(uniqueN(rq1.long$area.name), big.mark = ",")} areas). The predictor $D_{at}$ is the cumulative net loss of forest cover in the area from 2000 up to the interview year, in percentage points, from the forest cover per area every fifth year \citep{Ekbrand2026forest}, interpolated linearly between those years. The model is a linear mixed model,
\begin{align*}
\bar Y_{at} = {} & \beta_0 + \beta_1 t + \beta_2 D_{at} + \lambda e_{at} + u_a
 + v_{r(a)} + b_{r(a)} t + d_{r(a)} D_{at} + w_{c(a)} + g_{c(a)} t + h_{c(a)} D_{at} + \varepsilon_{at},
\end{align*}
where $t$ is time in decades from 2010, $e_{at}$ the average education of the 1960--1976 cohort, $u_a$ a random intercept for the area, $v_r$ and $b_r$ a random intercept and time trend for the top level region, and $w_c$ and $g_c$ the same for the country. The intercept and the time trend are allowed to correlate within regions and within countries (the estimated correlations are \Sexpr{sprintf("%.2f", rq1b.cor("top.level.region"))} and \Sexpr{sprintf("%.2f", rq1b.cor("country"))}). The random effects of forest loss, $d_r$ for the region and $h_c$ for the country, are independent of them. The area-year averages are weighted by the number of respondents. The effect of forest loss in region $r$ of country $c$ is $\beta_2 + h_c + d_r$. Since each region and country has its own time trend, the effect is identified by areas that lost more forest than other areas in their region, and by the timing of the loss, not by the general growth of IWI.

The average effect of forest loss is \Sexpr{sprintf("%.3f", rq1b.b)} IWI units per percentage point of forest cover lost (95\% CI \Sexpr{sprintf("%.3f", rq1b.b - qnorm(0.975) * sqrt(rq1b.vb))}--\Sexpr{sprintf("%.3f", rq1b.b + qnorm(0.975) * sqrt(rq1b.vb))}), which cannot be distinguished from zero. The effect varies, however, between countries, with a standard deviation of \Sexpr{sprintf("%.3f", rq1b.sd("country"))}, and between top level regions within countries, with a standard deviation of \Sexpr{sprintf("%.3f", rq1b.sd("top.level.region"))}. A model where the effect of forest loss is the same everywhere fits \Sexpr{ifelse(rq1b.lrt[["Pr(>Chisq)"]][2] < 0.05, "significantly worse", "no worse")} (likelihood ratio $\chi^2_2 = \Sexpr{sprintf("%.1f", rq1b.lrt[["Chisq"]][2])}$, p \Sexpr{ifelse(rq1b.lrt[["Pr(>Chisq)"]][2] < 0.001, "$<$ 0.001", paste("=", sprintf("%.3f", rq1b.lrt[["Pr(>Chisq)"]][2])))}; the test is conservative since the variances are tested at the boundary of the parameter space). Forest loss is thus associated with rising IWI in some places and with falling IWI in others, and on average these associations nearly cancel out. The variation is substantial: in a region one standard deviation above the average, an area that lost 5 percentage points of its forest cover would have an IWI about \Sexpr{sprintf("%.1f", 5 * (rq1b.b + sqrt(rq1b.sd("country")^2 + rq1b.sd("top.level.region")^2)))} units higher than an otherwise similar area without forest loss, and in a region one standard deviation below the average about \Sexpr{sprintf("%.1f", abs(5 * (rq1b.b - sqrt(rq1b.sd("country")^2 + rq1b.sd("top.level.region")^2))))} units lower.

<<rq1.map.geometry, cache.extra = tools::md5sum("forest-change.gpkg")>>=
library(sf); library(data.table)
old.s2 <- sf_use_s2(FALSE)
rq1.areas <- st_read("forest-change.gpkg", quiet = TRUE)[, "region"]
st_crs(rq1.areas) <- 4326
rq1.key <- unique(bal[, list(region = area.name, top.level.region, country)])
rq1.areas <- merge(rq1.areas, rq1.key, by = "region")
rq1.areas <- st_make_valid(st_simplify(st_make_valid(rq1.areas), dTolerance = 0.02, preserveTopology = TRUE))
rq1.dissolve <- function(x, by) {
    g <- aggregate(x[, by], by = list(id = x[[by]]), FUN = function(v) v[1])
    st_make_valid(g[, "id"])
}
rq1.region.sf  <- rq1.dissolve(rq1.areas, "top.level.region")
rq1.country.sf <- rq1.dissolve(rq1.areas, "country")
invisible(sf_use_s2(old.s2))
@

<<rq1b.map.region, fig.cap = "Effect of forest loss on the average IWI of an area, IWI units per percentage point of forest cover lost since 2000, per top level region, from a linear mixed model with random intercepts, time trends and effects of forest loss for countries and for top level regions within countries. The effect of a region includes the deviation of its country. Faded colours: the 95\\% interval includes zero. White land: no area in the analysis. The colour scale is capped at the 95th percentile of the absolute regional effects.", fig.width = 144/25.4, fig.height = 70/25.4, dpi = 300>>=
library(sf); library(ggplot2); library(data.table)
old.s2 <- sf_use_s2(FALSE)
rq1c.map.dt <- merge(rq1.region.sf, rq1b.region[, list(id = top.level.region, est, sig)], by = "id")
rq1c.map.dt$interval <- factor(ifelse(rq1c.map.dt$sig == "includes zero", "includes zero", "excludes zero"),
                               levels = c("excludes zero", "includes zero"))
rq1c.cap <- quantile(abs(rq1b.region$est), 0.95, na.rm = TRUE)
rq1c.bg <- rnaturalearth::ne_countries(scale = 50, returnclass = "sf")[, "admin"]
rq1c.bb <- st_bbox(rq1c.map.dt)

ggplot() +
    geom_sf(data = rq1c.bg, fill = "#ffffff", colour = NA) +
    geom_sf(data = rq1c.map.dt, aes(fill = est, alpha = interval), colour = NA) +
    geom_sf(data = rq1c.bg, fill = NA, colour = "#6f6e69", linewidth = 0.12) +
    scale_fill_gradient2(low = "#b2182b", mid = "#f2f1ec", high = "#2166ac", midpoint = 0,
                         limits = c(-rq1c.cap, rq1c.cap), oob = scales::squish,
                         name = "IWI units per pp\nof forest lost",
                         guide = guide_colourbar(barwidth = unit(30, "mm"), barheight = unit(2.5, "mm"))) +
    scale_alpha_manual(values = c(`excludes zero` = 1, `includes zero` = 0.3), drop = FALSE,
                       name = "95% interval",
                       guide = guide_legend(override.aes = list(fill = "#2166ac"))) +
    coord_sf(xlim = c(rq1c.bb[["xmin"]] - 1, rq1c.bb[["xmax"]] + 1),
             ylim = c(rq1c.bb[["ymin"]] - 1, rq1c.bb[["ymax"]] + 1), expand = FALSE, datum = NA) +
    theme_void(base_size = 7) +
    theme(legend.position = "bottom", legend.key.size = unit(3, "mm"),
          legend.text = element_text(size = 6, colour = "#52514e"),
          legend.title = element_text(size = 6.5, colour = "#0b0b0b"),
          panel.background = element_rect(fill = "#eef1f4", colour = NA),
          plot.background = element_rect(fill = "#ffffff", colour = NA),
          plot.margin = margin(1, 1, 1, 1))
invisible(sf_use_s2(old.s2))
@

Figure \ref{fig:rq1b.map.region} shows the estimated effect of forest loss per top level region. The effect of a region includes the deviation of its country, so the map also shows the differences between countries; the country effects are listed in Table \ref{tab:rq1-countries} in the appendix. At the country level, the 95\% interval lies above zero in \Sexpr{sum(rq1b.country$sig == "positive")} of the \Sexpr{nrow(rq1b.country)} countries (\Sexpr{paste(rq1b.country[sig == "positive"][order(-est), country], collapse = ", ")}) and below zero in \Sexpr{sum(rq1b.country$sig == "negative")} (\Sexpr{paste(rq1b.country[sig == "negative"][order(est), country], collapse = ", ")}). Among the \Sexpr{format(nrow(rq1b.region), big.mark = ",")} top level regions, the interval lies above zero in \Sexpr{sum(rq1b.region$sig == "positive")} regions, in \Sexpr{paste(unique(rq1b.region[sig == "positive"][order(-est), country]), collapse = ", ")}, and below zero in \Sexpr{sum(rq1b.region$sig == "negative")}, in \Sexpr{paste(unique(rq1b.region[sig == "negative"][order(est), country]), collapse = ", ")}.

The map shows a geographical pattern. Forest loss is associated with rising IWI in the humid parts of West and Central Africa, where the estimates are positive also in countries where the interval includes zero, such as Liberia and Ghana, and in Indonesia. It is associated with falling IWI in eastern and southern Africa, in Mozambique and Tanzania, with negative but uncertain estimates also in Uganda, Angola and India. % TODO: check the country names against the map and the table after each run
This pattern is consistent with differences in what replaced the forest: commercial tree crops such as cocoa and oil palm in the humid zone of West and Central Africa and in Indonesia, and clearing of dry woodland for small-scale agriculture and charcoal in eastern and southern Africa. Whether what replaced the forest explains the variation is the second research question (Section \ref{sec:res-rq2}).

In most regions, the 95\% interval includes zero. This should not be read as evidence that living conditions were unaffected by deforestation there. With two or three survey rounds per country, the effect in a single region is estimated with little precision, and the estimates of regions and countries with few areas or little variation in forest loss are drawn towards the effect in their country and towards the average effect. The map therefore shows few significant effects by chance, but also few real ones where the data are thin.

The results are not sensitive to the specification of the random effects. In a model where the intercepts, time trends and effects of forest loss of regions and countries are all uncorrelated, the regional effects correlate \Sexpr{sprintf("%.2f", cor(rq1b.agree$est.a, rq1b.agree$est.b))} with those above, and \Sexpr{sum(rq1b.agree$sig.a == rq1b.agree$sig.b)} of the \Sexpr{nrow(rq1b.agree)} regions get the same classification (interval above zero, below zero, or including zero); the model with correlated intercepts and trends fits better ($\chi^2_{\Sexpr{rq1b.vs.rq1[["Df"]][2]}} = \Sexpr{sprintf("%.1f", rq1b.vs.rq1[["Chisq"]][2])}$, p = \Sexpr{sprintf("%.3f", rq1b.vs.rq1[["Pr(>Chisq)"]][2])}).

\subsection{Forest loss and what replaced it}
\label{sec:res-descriptive}

Figure \ref{fig:map.categories} shows where the forest was lost between 2000 and 2020, and what replaced it, and Table \ref{tab:drivers-categories} summarises the seven categories across the areas with an IWI trend.

<<map.categories, fig.cap = "Forest loss 2000--2020 and what replaced the forest, per cent of the land area in 2000, in the administrative areas with geocoded DHS surveys. The first panel shows all forest loss (forest in 2000, not forest in 2020, plus oil palm planted on former forest land that GLCLU still classifies as forest); the other panels split it into the seven categories, which add up to the first panel. White land: no DHS area in the analysis.", fig.width = 144/25.4, fig.height = 128/25.4, dpi = 300, cache.extra = tools::md5sum(c("forest_drivers_2000_2020.csv", "forest-change.gpkg"))>>=
library(data.table); library(sf); library(ggplot2)
if (!requireNamespace("rnaturalearth", quietly = TRUE) || !requireNamespace("rnaturalearthdata", quietly = TRUE))
    stop("install.packages(c('rnaturalearth', 'rnaturalearthdata')) is needed for the country borders")
old.s2 <- sf_use_s2(FALSE)

## the seven categories, as in chunk drivers.categories (Section \ref{sec:two-step})
map.drv <- fread("forest_drivers_2000_2020.csv", encoding = "UTF-8")[valid_2000 > 0]
## shares of oil palm on former forest land by plantation type and planting period
## (untyped oil palm, with a planting year but not in the 2021 extent map, counted as smallholder)
map.pf <- function(type, period)
    sum(as.matrix(map.drv[, .SD, .SDcols = as.vector(outer(type, period, function(t, p) paste0("palm_from_forest_", t, "_", p)))]))
map.palm.all <- map.pf(c("industrial", "smallholder", "untyped"), c("early", "late"))
map.palm.share <- 100 * c(industrial = map.pf("industrial", c("early", "late")),
                          smallholder = map.pf(c("smallholder", "untyped"), c("early", "late")),
                          early = map.pf(c("industrial", "smallholder", "untyped"), "early")) / map.palm.all
rs.map <- function(pattern) rowSums(map.drv[, .SD, .SDcols = patterns(pattern)])
map.drv[, `:=`(
    cat_P = 100 * (rs.map("^loss_oil_palm_to_") + palm_from_forest_forest) / valid_2000,
    cat_U = 100 * (rs.map("^loss_.*_to_builtup$") - loss_oil_palm_to_builtup) / valid_2000,
    cat_K = pct_loss_permanent_agriculture_to_cropland,
    cat_G = pct_loss_permanent_agriculture_to_shortveg,
    cat_S = 100 * (rs.map("^loss_shifting_cultivation_to_") - loss_shifting_cultivation_to_builtup) / valid_2000,
    cat_L = 100 * (rs.map("^loss_logging_to_") - loss_logging_to_builtup) / valid_2000,
    cat_T = 100 * (loss_total + palm_from_forest_forest) / valid_2000)]
map.drv[, cat_R := cat_T - (cat_P + cat_U + cat_K + cat_G + cat_S + cat_L)]
map.panels <- c(cat_T = "All forest loss", cat_P = "P  oil palm", cat_U = "U  built-up",
                cat_K = "K  permanent agriculture, cropland",
                cat_G = "G  permanent agriculture, short vegetation",
                cat_S = "S  shifting cultivation", cat_L = "L  logging", cat_R = "R  other")
map.cat.dt <- melt(map.drv[, c("region", names(map.panels)), with = FALSE], id.vars = "region",
                   variable.name = "cat", value.name = "pct")
map.labels <- c("< 0.1", "0.1--0.5", "0.5--2", "2--5", "5--10", "> 10")
map.cat.dt[, class := factor(cut(pct, c(-Inf, 0.1, 0.5, 2, 5, 10, Inf), labels = map.labels, right = FALSE),
                             levels = map.labels)]
map.cat.dt[, panel := factor(map.panels[as.character(cat)], levels = map.panels)]

## area geometries, simplified for plotting
map.areas <- st_read("forest-change.gpkg", quiet = TRUE)[, "region"]
st_crs(map.areas) <- 4326
map.areas <- map.areas[map.areas$region %in% map.drv$region, ]
map.areas <- st_make_valid(st_simplify(st_make_valid(map.areas), dTolerance = 0.02, preserveTopology = TRUE))
map.sf <- merge(map.areas, map.cat.dt, by = "region")
map.countries <- rnaturalearth::ne_countries(scale = 50, returnclass = "sf")[, "admin"]
map.bb <- st_bbox(map.areas)

## one-hue sequential ramp; the lowest class recedes to a neutral grey
map.cols <- setNames(c("#e6e5e1", "#b7d3f6", "#6da7ec", "#2a78d6", "#1c5cab", "#0d366b"), map.labels)
names(map.cols) <- gsub("--", "–", names(map.cols))
levels(map.sf$class) <- gsub("--", "–", levels(map.sf$class))

ggplot() +
    geom_sf(data = map.countries, fill = "#ffffff", colour = NA) +
    geom_sf(data = map.sf, aes(fill = class), colour = NA) +
    geom_sf(data = map.countries, fill = NA, colour = "#6f6e69", linewidth = 0.12) +
    scale_fill_manual(values = map.cols, name = "% of land area in 2000", drop = FALSE,
                      guide = guide_legend(nrow = 1, title.position = "left")) +
    coord_sf(xlim = c(map.bb[["xmin"]] - 1, map.bb[["xmax"]] + 1),
             ylim = c(map.bb[["ymin"]] - 1, map.bb[["ymax"]] + 1), expand = FALSE, datum = NA) +
    facet_wrap(~ panel, ncol = 2) +
    theme_void(base_size = 7) +
    theme(strip.text = element_text(hjust = 0, size = 7, margin = margin(2, 0, 2, 2), colour = "#0b0b0b"),
          legend.position = "bottom", legend.key.size = unit(3, "mm"),
          legend.text = element_text(size = 6, colour = "#52514e"),
          legend.title = element_text(size = 6.5, colour = "#0b0b0b"),
          panel.background = element_rect(fill = "#eef1f4", colour = NA),
          plot.background = element_rect(fill = "#ffffff", colour = NA),
          panel.spacing = unit(2, "mm"), plot.margin = margin(1, 1, 1, 1))
invisible(sf_use_s2(old.s2))
@

The map covers the \Sexpr{format(uniqueN(map.cat.dt$region), big.mark = ",")} areas with geocoded DHS surveys and land cover data. The categories are geographically distinct. Oil palm on former forest land is concentrated in Indonesia and coastal West Africa; permanent agriculture with cropland in the Sahel belt, in Zambia, Malawi and Tanzania, and on the soy frontier of eastern Bolivia; permanent agriculture with short vegetation (pasture, tree crops and fallow) in the Amazon and Colombia, across West and Central Africa, Madagascar and Southeast Asia; shifting cultivation in the Congo basin, Myanmar and Madagascar; and logging in Indonesia and the plantation forestry of southern Africa. Because the categories are concentrated in different countries, the analyses below compare areas within countries.

Of the oil palm planted 2001--2020 on former forest land in the areas of the data set, \Sexpr{sprintf("%.0f", map.palm.share[["industrial"]])}\% is industrial and \Sexpr{sprintf("%.0f", map.palm.share[["smallholder"]])}\% smallholder, and \Sexpr{sprintf("%.0f", map.palm.share[["early"]])}\% was planted 2001--2010.

<<show.tab_drivers_categories, results = "asis", cache = FALSE>>=
show.tab(tab_drivers_categories)
@
% TODO: two or three sentences on the size of the categories: which dominate in area, which are concentrated in few areas (oil palm, logging)

\subsection{Does what replaced the forest predict the change in living conditions?}
\label{sec:res-rq2}
\label{sec:two-step-country}

<<show.tab_two_step_country, results = "asis", cache = FALSE>>=
show.tab(tab_two_step_country)
@

<<rq2.coef, fig.cap = "Difference in the observed IWI trend between each category of forest loss and shifting cultivation, IWI units per year per percentage point of the land area, with 95\\% confidence intervals (standard errors clustered by country). Comparisons within countries, model (4) of Table \\ref{tab:two-step-country}; oil palm split by plantation type and by planting period from the models in Table \\ref{tab:palm-split}.", fig.width = 5.5, fig.height = 3.4, fig.align = "center">>=
library(data.table); library(ggplot2)
invisible(requireNamespace("fixest", quietly = TRUE))  # registers vcov() for fixest objects
rq2.ctr1 <- function(fit, a, b = "cat_S") {
    V <- vcov(fit); cf <- coef(fit)
    est <- cf[[a]] - cf[[b]]; se <- sqrt(V[a, a] + V[b, b] - 2 * V[a, b])
    data.table(term = a, est = est, lo = est - qnorm(0.975) * se, hi = est + qnorm(0.975) * se,
               p = 2 * pnorm(-abs(est / se)))
}
rq2.ctr <- rbind(
    rbindlist(lapply(setdiff(q2.vars, "cat_S"), rq2.ctr1, fit = fit.q2.c1))[, group := "Categories"],
    rbindlist(lapply(c("p_ind", "p_sm"), rq2.ctr1, fit = palm.fits$type$fit))[, group := "Oil palm by type"],
    rbindlist(lapply(c("p_early", "p_late"), rq2.ctr1, fit = palm.fits$period$fit))[, group := "Oil palm by period"])
rq2.lab <- c(sub(":", "", q2.labels), p_ind = "Industrial oil palm", p_sm = "Smallholder oil palm",
             p_early = "Oil palm planted 2001-2010", p_late = "Oil palm planted 2011-2020")
rq2.ctr[, label := factor(rq2.lab[term], levels = rev(rq2.lab[term]))]
rq2.ctr[, group := factor(group, levels = c("Categories", "Oil palm by type", "Oil palm by period"))]
setkey(rq2.ctr, term)
s.S <- coef(fit.q2.c1)[["cat_S"]] * sd(q2.dt$cat_S)

ggplot(rq2.ctr, aes(est, label)) +
    geom_vline(xintercept = 0, colour = "#c3c2bd", linewidth = 0.3) +
    geom_linerange(aes(xmin = lo, xmax = hi), colour = "#2a78d6", linewidth = 0.5) +
    geom_point(colour = "#2a78d6", size = 1.6) +
    facet_grid(group ~ ., scales = "free_y", space = "free_y") +
    labs(x = "Difference from shifting cultivation (IWI units per year per percentage point)", y = NULL) +
    theme_minimal(base_size = 8) +
    theme(panel.grid.minor = element_blank(), panel.grid.major.y = element_blank(),
          panel.grid.major.x = element_line(colour = "#eeede9"),
          strip.text.y = element_text(angle = 0, hjust = 0, colour = "#0b0b0b"),
          axis.text = element_text(colour = "#52514e"))
@

Shifting cultivation is associated with a slower IWI trend than in other areas of the same country: one standard deviation more shifting cultivation goes with a trend that is \Sexpr{sprintf("%.3f", abs(s.S))} IWI units per year slower (Table \ref{tab:two-step-country}). Figure \ref{fig:rq2.coef} compares the other categories with shifting cultivation, per percentage point of the land area. Oil palm stands out: an area where one percentage point of the land went from forest to oil palm had an IWI trend \Sexpr{sprintf("%.3f", rq2.ctr["cat_P", est])} IWI units per year faster (95\% CI \Sexpr{sprintf("%.3f", rq2.ctr["cat_P", lo])}--\Sexpr{sprintf("%.3f", rq2.ctr["cat_P", hi])}) than an area where the same land went to shifting cultivation. % TODO: one sentence each on U, K, G, L and R
Logging is associated with a slightly slower trend than other areas in the country (p = \Sexpr{sprintf("%.3f", loo.L.full$L.p)}).

<<rq2.palm.numbers>>=
rq2.el <- rq2.ctr1(palm.fits$period$fit, "p_early", "p_late")
rq2.si <- rq2.ctr1(palm.fits$type$fit, "p_sm", "p_ind")
rq2.b  <- function(fit, v) coef(fit)[[v]]
@

The association for oil palm depends on when the palms were planted. Oil palm planted 2001--2010, which had reached full production by the last surveys, is associated with an IWI trend \Sexpr{sprintf("%.3f", rq2.b(palm.fits$period$fit, "p_early"))} IWI units per year faster per percentage point of the land area, compared with \Sexpr{sprintf("%.3f", rq2.b(palm.fits$period$fit, "p_late"))} for oil palm planted 2011--2020 (difference \Sexpr{sprintf("%.3f", rq2.el$est)}, p = \Sexpr{sprintf("%.3f", rq2.el$p)}; Table \ref{tab:palm-split-contrast}). The later plantations are still associated with a faster trend than shifting cultivation. The difference between early and late plantations remains when oil palm planted before 2001 is controlled for, so it is not only a matter of long-established oil palm economies. Smallholder oil palm is associated with a faster trend than industrial oil palm (difference \Sexpr{sprintf("%.3f", rq2.si$est)} per percentage point, p = \Sexpr{sprintf("%.3f", rq2.si$p)}); industrial oil palm does not differ significantly from shifting cultivation.

<<palm.split.contrast.78, results = "asis", cache = FALSE>>=
## as chunk palm.split.contrast, without model (9) (oil palm by type and period)
palm.contrasts.78 <- Filter(function(x) x[[1]] != "both", palm.contrasts)
palm.contrast.tab.78 <- rbindlist(lapply(palm.contrasts.78, function(x) {
    r <- contrast.q2(palm.fits[[x[[1]]]]$fit, x[[2]], x[[3]])
    data.table(contrast = x[[4]], model = c(type = "(7)", period = "(8)")[[x[[1]]]],
               est = r[1], p = r[2])
}))
setnames(palm.contrast.tab.78, c("", "model", "per pp [95\\% CI]", "p"))
xtable::print.xtable(xtable::xtable(palm.contrast.tab.78,
             caption = "Differences in the observed IWI trend (IWI units per year) between kinds of oil palm, and between oil palm and shifting cultivation, per percentage point of the land area, comparing areas within the same country. Models of Table \\ref{tab:palm-split}.",
             label = "tab:palm-split-contrast", align = c("l", "l", "c", "r", "r")),
      include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity)
@

% TODO: Indonesia carries little weight; the oil palm results come mainly from West Africa and Peru (say so here or in the discussion)

\subsection{Robustness}
\label{sec:res-robustness}

The contrast between oil palm and shifting cultivation is positive and significant at the 5 per cent level in \Sexpr{sum(loo.dt$PS.p < 0.05)} of the \Sexpr{nrow(loo.dt)} models that leave out one country at a time, and the estimate for logging is negative in \Sexpr{sum(loo.L.dt$L < 0)} of them (Table \ref{tab:loo}). Restricted to areas whose interviews span at least ten years (model 6 of Table \ref{tab:two-step-country}), the estimates are almost the same as in model 4. Without weights (model 5), all estimates are less precise and the estimate for oil palm changes sign (\Sexpr{est.ci.q2(fit.q2.c2, "cat_P", cat.sd[["cat_P"]])} per standard deviation); the unweighted model gives areas with very imprecise trends as much weight as areas with precise ones (Section \ref{sec:coverage}). With fixed effects for top level regions instead of countries (Table \ref{tab:two-step}), the estimates point in the same directions, but the association with shifting cultivation is weaker (\Sexpr{est.ci.q2(fit.q2.1, "cat_S", cat.sd[["cat_S"]])} per standard deviation), since comparisons within regions use less of the variation in forest loss. Splitting the residual category R into its components leaves the estimates for the other categories unchanged; the positive estimate for R comes mainly from forest loss without a dominant driver and from the settlements driver where the land is not built-up in 2020 (Appendix \ref{app:sensitivity}).


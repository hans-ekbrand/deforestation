## instead of gni.atlas.current.dollar

my_indicators = c("gni.atlas.current.dollar" = "NY.GNP.PCAP.CD",
                  "percent.goods.and.services.percent.of.gdp" = "NE.EXP.GNFS.ZS",
                  "agriculture.forestry.percent.of.gdp" = "NV.AGR.TOTL.ZS",
                  "population.15.64" = "SP.POP.1564.TO"
                  )
my_countries <- iso.3166$String.code[match(country.codes, iso.3166$numeric)]

my.log.f(paste(Sys.time(), "indicators =", paste(my_indicators, collapse = ", "),
               "countries =", paste(my_countries, collapse = ", ")))

gdp.wb <- wb_data(my_indicators, country = my_countries, start_date = 1999, end_date = 2024)

<<find.the.grid.cell, dependson = "load.data.using.child.document">>=
library(httr)
## version <- "2021-v1.9"
version <- "2023-v1.11"
url.gcf <- "https://storage.googleapis.com/earthenginepartners-hansen/GFC-"
base.url <- paste0(url.gcf, version, "/")
file.name.prefix <- paste0("Hansen_GFC-", version, "_")

my.years <- 1:23

## helper functions
url.from.point.f <- function(lon, lat, layer){
    lon.first.corner <- floor(lon / 10) * 10
    lat.first.corner <- ceiling(lat / 10) * 10
    if(abs(lon.first.corner) > 100){
        lon.corner <- abs(lon.first.corner)
    } else {
        lon.corner <- paste0("0", abs(lon.first.corner))        
    }
    if(abs(lon.first.corner) < 10){
        ## longitude 0 is written 000E
        lon.corner <- paste0("00", abs(lon.first.corner))
    }    
    if(lon.first.corner < 0){
        lon.corner <- paste0(lon.corner, "W")
    } else {
        lon.corner <- paste0(lon.corner, "E")    
    }
    ## For some reason I still see values like "0100E"
    ## that should be 100E.
    ## Dirty hack:
    if(nchar(lon.corner) > 4){
        lon.corner <- substring(lon.corner, 2, 5)
    }
    if(abs(lat.first.corner) < 10){
        ## latitude 0 is written 00N
        lat.corner <- paste0("0", abs(lat.first.corner))
    } else {
        lat.corner <- abs(lat.first.corner)        
    }
    if(lat.first.corner < 0){
        lat.corner <- paste0(lat.corner, "S")
    } else {
        lat.corner <- paste0(lat.corner, "N")    
    }
    my.file <- paste0(file.name.prefix, layer, "_",
                      lat.corner, "_", lon.corner, ".tif")
    return(my.file)
}
point.at.corners.f <- function(combination, my.bbox){
    c(my.bbox["x", combination[1]], my.bbox["y", combination[2]])
}

obsolete.file.name.from.bbox.f <- function(bbox, layer){
    my.combinations <- unlist(sapply(1:2, function(x){ sapply(1:2,
       function(y) { c(x, y) }, simplify = FALSE) }, simplify = FALSE),
                              recursive = FALSE)
    points.at.corners <- sapply(my.combinations, point.at.corners.f,
                                my.bbox = bbox)
    urls.at.corners <- apply(points.at.corners, 2, function(x) {
        url.from.point.f(lon=x[1], lat=x[2], layer) })
    return(unique(urls.at.corners))
}

file.name.from.bbox.f <- function(bbox, layer, tile_deg = 10, eps = 1e-10) {
  # bbox is sp::bbox result: matrix with rows x,y and cols min,max

  xmin <- bbox["x", "min"]
  xmax <- bbox["x", "max"]
  ymin <- bbox["y", "min"]
  ymax <- bbox["y", "max"]

  # Apply half-open convention by nudging max inward a hair.
  # This makes xmax=20 belong to the tile [10,20), not [20,30).
  xmax2 <- xmax - eps
  ymax2 <- ymax - eps

  # Handle degenerate bboxes (e.g., width 0) safely
  if (xmax2 < xmin) xmax2 <- xmin
  if (ymax2 < ymin) ymax2 <- ymin

  # Compute tile indices (multiples of tile_deg)
  x_starts <- seq(floor(xmin / tile_deg) * tile_deg,
                  floor(xmax2 / tile_deg) * tile_deg,
                  by = tile_deg)

  y_starts <- seq(floor(ymin / tile_deg) * tile_deg,
                  floor(ymax2 / tile_deg) * tile_deg,
                  by = tile_deg)

  # Convert tile start (south edge) to the NW corner latitude (ymax of tile)
  # Tile spans [y, y+tile_deg); NW corner lat is y+tile_deg.
  tiles <- expand.grid(xmin_tile = x_starts, ymin_tile = y_starts)

  urls <- apply(tiles, 1, function(t) {
    lon_west <- t[["xmin_tile"]]
    lat_north <- t[["ymin_tile"]] + tile_deg
    url.from.point.f(lon = lon_west, lat = lat_north, layer = layer)
  })

  unique(urls)
}

url.from.file.f <- function(file.name) { paste0(base.url, file.name) }


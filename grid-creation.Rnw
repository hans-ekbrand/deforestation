<<get.raster>>=
## make sure the files are available locally
fetch.raster <- function(my.files, deforestation.path, verbose = FALSE) {
    ## download files, if they are missing
    my.urls <- sapply(my.files, url.from.file.f)    
    for(j in 1:length(my.files)){
        file.and.path <- paste0(deforestation.path, my.files[j])
        if(!file.exists(file.and.path)) {
globallivingconditions::my.log.f(paste(Sys.time(), "will download this url:",
           my.urls[j], "and save it as", file.and.path), "deforestation.log")
            httr::GET(my.urls[j], httr::write_disk(file.and.path))
        } else {
            if(verbose) {
globallivingconditions::my.log.f(paste(Sys.time(), "File", my.files[j],
          "already downloaded to", file.and.path), "deforestation.log")
            }
        }
    }
}

values.from.file.f <- function(file, polygon, deforestation.path) {
    r <- raster::raster(file.path(deforestation.path, file))
    ## vector of values under polygon; no temp rasters created
    v <- raster::extract(r, polygon)[[1]]
    rm(r)
    v
}

## Improved version of raster:removeTmpFiles() that only removes temp files create by the current process.

removeTmpFiles_pid <- function(h = 0, pid = Sys.getpid(), dryrun = FALSE, verbose = TRUE) {
  stopifnot(is.numeric(h), length(h) == 1, h >= 0)
  pid <- as.character(pid)

  files <- gsub('///', '/', list.files(raster::tmpDir(create=FALSE), full.names = TRUE))

  # Helper: age filter (like raster's removeTmpFiles(h=...))
  if (h > 0) {
    cutoff <- Sys.time() - (h * 3600)
    mt <- suppressWarnings(file.mtime(files))
    keep_age <- !is.na(mt) & (mt <= cutoff)
    files <- files[keep_age]
    if (length(files) == 0L) {
      return(invisible(character(0)))
    }
  }

  # Extract PID from basename:
  # r_tmp_YYYY-MM-DD_HHMMSS.micro_PID_RAND.suffix
  # We capture the PID (group 1)
  b <- basename(files)
  pid_in_name <- sub("^r_tmp_\\d{4}-\\d{2}-\\d{2}_[0-9]{6}\\.[0-9]+_([0-9]+)_[0-9]+\\..*$", "\\1", b)

  # Where regex didn't match, pid_in_name will be unchanged; exclude those
  matched <- pid_in_name != b

  # Keep only this pid
  mine <- matched & (pid_in_name == pid)

  files_pid <- files[mine]

  if (length(files_pid) == 0L) {
    return(invisible(character(0)))
  }

  # Remove "stems" so we remove all companions (.grd/.gri/etc)
  # Stem = path minus final extension
  stems <- unique(sub("\\.[^.]+$", "", files_pid))

  to_remove <- unique(unlist(lapply(stems, function(s) Sys.glob(paste0(s, ".*"))), use.names = FALSE))
  to_remove <- to_remove[file.exists(to_remove)]

  if (verbose) {
      globallivingconditions::my.log.f(paste(Sys.time(), "Found",
       length(files_pid), "candidate file(s) for pid=", pid,
       ":", paste(files_pid, collapse = ", "), "removing",
       length(to_remove), "file(s) including companions."),
        "deforestation.log")       
  }

  if (dryrun) {
    if (verbose) message("dryrun=TRUE; not deleting anything.")
    return(invisible(to_remove))
  }

  ok <- file.remove(to_remove)

  if (verbose) {
      globallivingconditions::my.log.f(paste(Sys.time(), "Found ",  
           "Removed: ", sum(ok), " / ", length(ok), " files."),
           "deforestation.log")
  }

  invisible(to_remove[ok])
}

average.coverage.over.time.directly.from.single.file.fast <- function(
  polygon, my.cover.file, my.loss.file, deforestation.path, ...
) {
    ## Loss values under polygon
    loss <- values.from.file.f(my.loss.file, polygon, deforestation.path)

    these.are.within.the.area <- which(!is.na(loss))
    size <- length(these.are.within.the.area)

    if (size == 0) {
        globallivingconditions::my.log.f(
          paste(Sys.time(), "found an area of size 0, returning NULL"),
          "deforestation.log")
        return(NULL)
    }

    these.were.lost.indices <- which(loss > 0)
    these.were.lost.values  <- loss[these.were.lost.indices]
    rm(loss); gc(FALSE)

    globallivingconditions::my.log.f(
      paste(Sys.time(), "Loss data preparation finished"),
      "deforestation.log")

    ## Cover values under polygon
    cover_vals <- values.from.file.f(my.cover.file, polygon, deforestation.path)

    ## Match your original behavior: only consider cells that are non-NA in loss
    coverage <- cover_vals[these.are.within.the.area]
    rm(cover_vals); gc(FALSE)
    globallivingconditions::my.log.f(
        paste(Sys.time(), "Coverage data preparation finished"),
        "deforestation.log")

  average.coverage.at.t0 <- mean(coverage)

  my.f <- function(year) {
    idx <- these.were.lost.indices[these.were.lost.values <= year]
    if (length(idx) > 0) {
      mean(c(coverage[-idx], rep(0, length(idx))), na.rm = TRUE)
    } else {
      average.coverage.at.t0
    }
  }

  average.coverage.per.year <- sapply(my.years, my.f)
    names(average.coverage.per.year) <- paste0("t", my.years)
    size = round(geosphere::areaPolygon(polygon)/1e6, 2)

  globallivingconditions::my.log.f(
     paste(Sys.time(), "Ready with temporal loss for",
       "a polygon of size", size, "Km^2"),
     "deforestation.log")

  rm(polygon, my.cover.file, my.loss.file, coverage); gc(FALSE)

  list(
    size,
    coverage = c(t0 = average.coverage.at.t0, average.coverage.per.year)
  )
}

average.coverage.over.time.directly.from.single.file.pointer.fast <- function(
  polygon, my.cover.raster, my.loss.raster, ...
) {
    loss <- raster::extract(my.loss.raster, polygon)[[1]]

  these.are.within.the.area <- which(!is.na(loss))
  size <- length(these.are.within.the.area)

  if (size == 0) {
    globallivingconditions::my.log.f(
      paste(Sys.time(), "found an area of size 0, returning NULL"),
      "deforestation.log")
    return(NULL)
  }

    these.were.lost.indices <- which(loss > 0)
    these.were.lost.values  <- loss[these.were.lost.indices]
    rm(loss); gc(FALSE)

    cover_vals <- raster::extract(my.cover.raster, polygon)[[1]]
    ## only consider cells that are non-NA in loss
    coverage <- cover_vals[these.are.within.the.area]
    rm(cover_vals); gc(verbose = FALSE)
    ## raster::removeTmpFiles(h=0)
    removeTmpFiles_pid()
    
    average.coverage.at.t0 <- mean(coverage)

    my.f <- function(year) {
        idx <- these.were.lost.indices[these.were.lost.values <= year]
        if (length(idx) > 0) {
            mean(c(coverage[-idx], rep(0, length(idx))), na.rm = TRUE)
        } else {
            average.coverage.at.t0
        }
    }

    average.coverage.per.year <- sapply(my.years, my.f)
    names(average.coverage.per.year) <- paste0("t", my.years)

    list(
        size = size,
        coverage = c(t0 = average.coverage.at.t0, average.coverage.per.year)
    )
}

@ 

<<function.definitions.for.efficient.parallelization>>=

split_polygon_by_extents_sp <- function(poly,
                                       extents,
                                       target_n = 15) {
  stopifnot(inherits(poly, "SpatialPolygons"))
  stopifnot(length(extents) >= 1)
  stopifnot(is.numeric(target_n) && target_n >= 1)

  if (!requireNamespace("sp", quietly = TRUE)) stop("Need package 'sp'.")
  if (!requireNamespace("raster", quietly = TRUE)) stop("Need package 'raster'.")

  library(sp)
  library(raster)

  crs_poly <- sp::proj4string(poly)

  # Convert extents to SpatialPolygons and set CRS
  extent_polys <- lapply(extents, function(e) {
    if (inherits(e, "Raster")) e <- raster::extent(e)
    stopifnot(inherits(e, "Extent"))
    p <- as(e, "SpatialPolygons")
    sp::proj4string(p) <- crs_poly
    p
  })

  # Cheap bbox overlap check (fast, avoids many bad intersect calls)
  bbox_overlaps <- function(a, b) {
    ba <- sp::bbox(a); bb <- sp::bbox(b)
    !(ba[1,2] < bb[1,1] || ba[1,1] > bb[1,2] || ba[2,2] < bb[2,1] || ba[2,1] > bb[2,2])
  }

  safe_intersect <- function(a, b) {
    if (!bbox_overlaps(a, b)) return(NULL)
    # tryCatch catches BOTH warnings elevated to errors and real errors
    out <- tryCatch(
      suppressWarnings(raster::intersect(a, b)),
      warning = function(w) NULL,
      error   = function(e) NULL
    )
    if (is.null(out)) return(NULL)

    # Sometimes returns empty/invalid things; reject those
    # (raster::intersect usually returns SpatialPolygons or NULL)
    if (!inherits(out, "SpatialPolygons")) return(NULL)
    if (length(out) == 0) return(NULL)
    if (any(is.na(sp::bbox(out)))) return(NULL)

    out
  }

  # Intersect polygon with each extent → per-tile polygon
  per_tile <- lapply(extent_polys, function(ep) safe_intersect(poly, ep))
  keep_idx <- which(!vapply(per_tile, is.null, logical(1)))
  per_tile <- per_tile[keep_idx]

  if (length(per_tile) == 0) stop("Polygon does not intersect any provided extent.")

  # Allocate subdivisions proportional to area
  areas <- vapply(per_tile, function(p) {
    # raster::area works for lon/lat; returns km^2 for geographic CRS
    sum(raster::area(p), na.rm = TRUE)
  }, numeric(1))
  areas[!is.finite(areas)] <- 0

  if (sum(areas) <= 0) {
    k_per_tile <- rep(1L, length(per_tile))
  } else {
    raw <- target_n * areas / sum(areas)
    k_per_tile <- pmax(1L, as.integer(round(raw)))
    # Adjust to match target_n more closely
    diff <- target_n - sum(k_per_tile)
    if (diff != 0) {
      ord <- order(areas, decreasing = (diff > 0))
      idx <- rep(ord, length.out = abs(diff))
      if (diff > 0) k_per_tile[idx] <- k_per_tile[idx] + 1L
      if (diff < 0) k_per_tile[idx] <- pmax(1L, k_per_tile[idx] - 1L)
    }
  }

  # Helper: split one polygon into k pieces by a grid, then intersect each cell
  split_one <- function(p, k) {
    if (k <= 1) return(list(p))

    bb <- sp::bbox(p)
    dx <- bb[1,2] - bb[1,1]
    dy <- bb[2,2] - bb[2,1]
    if (!is.finite(dx) || !is.finite(dy) || dx <= 0 || dy <= 0) return(list(p))

    nx <- max(1L, round(sqrt(k * dx / dy)))
    ny <- max(1L, round(k / nx))

    xs <- seq(bb[1,1], bb[1,2], length.out = nx + 1)
    ys <- seq(bb[2,1], bb[2,2], length.out = ny + 1)

    grid_polys <- vector("list", nx * ny)
    idx <- 1L
    for (i in seq_len(nx)) {
      for (j in seq_len(ny)) {
        coords <- matrix(c(
          xs[i],   ys[j],
          xs[i+1], ys[j],
          xs[i+1], ys[j+1],
          xs[i],   ys[j+1],
          xs[i],   ys[j]
        ), ncol = 2, byrow = TRUE)

        grid_polys[[idx]] <- sp::Polygons(list(sp::Polygon(coords)), ID = as.character(idx))
        idx <- idx + 1L
      }
    }
    grid <- sp::SpatialPolygons(grid_polys, proj4string = sp::CRS(crs_poly))

    pieces <- safe_intersect(grid, p)
    if (is.null(pieces)) return(list(p))

    # Convert SpatialPolygons with many Polygons into list of SpatialPolygons (one each)
    lapply(slot(pieces, "polygons"), function(pg) {
      sp::SpatialPolygons(list(pg), proj4string = sp::CRS(crs_poly))
    })
  }

  out <- list()
  for (i in seq_along(per_tile)) {
    parts <- split_one(per_tile[[i]], k_per_tile[i])
    # annotate which original extent index it came from (in case you want it)
    for (p in parts) {
      attr(p, "extent_index") <- keep_idx[i]
      out[[length(out) + 1L]] <- p
    }
  }

  out
}

## Define a new version of temporal.loss.non.forking.version()
## which takes the grid as an argument.

temporal.loss.non.forking.version <- function(index, the.grid, deforestation.path, ...) {

    ## check if stats for this polygon are already calculated.
    if(exists("temporal.loss")) {
        hit <- match(names(the.grid)[index], temporal.loss$region)
        if(is.na(hit) == FALSE){
            globallivingconditions::my.log.f(paste(Sys.time(),
                                                   "in temporal.loss.non.forking.version()",
                                                   "working with index =", index,
                                                   "region name:", names(the.grid)[index],
                                                   "returning data from temporal.loss"),
                                             "deforestation.log")
            return(temporal.loss[hit, ])
        }
    }

    ## index refers to the.grid
    polygon <- the.grid[index]
    
    my.bbox <- sp::bbox(polygon)
    my.cover.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "treecover2000")
    my.loss.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "lossyear")
    polygon.size <- geosphere::areaPolygon(polygon)
    globallivingconditions::my.log.f(paste(Sys.time(),
         "in temporal.loss.non.forking.version()",
         "working with index =", index,
         "region name:", names(the.grid)[index],
         "About to iterate over", length(my.cover.files),
         "cover files to produce data about a polygon of size:",
         round(polygon.size / 1e6), "Km^2"),
         "deforestation.log")
         
    fetch.raster(c(my.cover.files, my.loss.files),
                 deforestation.path = deforestation.path, ...)

    ## This version of the function should only be called
    ## sequentially on large areas, since it forks.
    
    ## Divide the original polygon in smaller polygons, in order to
    ## increase efficient parallelize computations.

    extents <- lapply(my.cover.files, function(f) {
        raster::extent(raster::raster(file.path(deforestation.path, f)))
    })

    pieces <- split_polygon_by_extents_sp(
        poly = the.grid[index],
        extents = extents,
        target_n = max(7, round(polygon.size / 5e9)) ## 5000 km^2 is fine, 7 because I have 8 cores on the server, so keep them busy
    )

    ## Sort pieces by size, largest first to make most out of the parallelization
    pieces <- pieces[order(sapply(pieces, geosphere::areaPolygon), decreasing = TRUE)]

    ## Now loop over pieces instead of the full polygon
    globallivingconditions::my.log.f(
       paste(Sys.time(), "iterating over a set of",
             length(pieces), "small polygons"),
       "deforestation.log")

    inner.function <- function(p) {
        ## each p is guaranteed to only require a single cover file.
        ## but which cover file is it?
        ## We need to detect that!
        my.small.bbox <- sp::bbox(p)
        my.small.cover.file <- file.name.from.bbox.f(
            bbox = my.small.bbox,
            layer = "treecover2000")
        my.small.loss.file <- file.name.from.bbox.f(
            bbox = my.small.bbox,
            layer = "lossyear")

        ## debug START
        small.polygon.size <- geosphere::areaPolygon(p)
        globallivingconditions::my.log.f(
            paste(Sys.time(), "Working with a small polygon with size",
                  round(small.polygon.size/1e6), "Km^2"),
            "deforestation.log")
        ## debug STOP
            
        average.coverage.over.time.directly.from.single.file.fast(
            polygon = p, my.cover.file = my.small.cover.file,
            my.loss.file = my.small.loss.file,
            deforestation.path = deforestation.path)
    }

    my.raster.stats <- sapply(pieces, inner.function, simplify = FALSE)
    ## At this point, no more data collection from disk is needed, so clean the
    ## cache now.

    ## Use a safe file cleaning function, that is informed about how
    ## raster used the current pid when naming tempory files, and uses
    ## the current pid to find only the files created by the current
    ## process.

    ## Old code that maybe removed temporary files for OTHER processes!
    ## raster_tmp <- file.path(tempdir(), "raster")

    ## if (dir.exists(raster_tmp)) {
    ##     globallivingconditions::my.log.f(
    ##      paste(Sys.time(), "Cleaning the temp-dir/raster used for index", index), 
    ##      "deforestation.log") 
        
    ##     unlink(raster_tmp, recursive = TRUE, force = TRUE)
    ## }

    removeTmpFiles_pid()
    
    ## If any element is NULL remove it
    ## (This probably only happened due to a bug in file.name.from.bbox.f
    ## which included tiles that only shared points but not area with the polygon)
    
    these.are.null <- which(sapply(my.raster.stats, is.null))
    if(length(these.are.null) > 0) {
        ## assume not all of them are null
        my.raster.stats <- my.raster.stats[-these.are.null]
    }

    globallivingconditions::my.log.f(
         paste(Sys.time(), "my.raster.stats are ready for index", index), 
         "deforestation.log") 
        
    ## if there are still more than one element, then create a
    ## weighted mean
    if(length(my.raster.stats) > 1) {
        weights <- as.vector(prop.table(unlist(sapply(seq(from = 1,
                             to = length(my.raster.stats)), function(i) {
                                 my.raster.stats[[i]][1] }))))
        ## restructure so that we don't need to know the number of
        ## tiff-files were used
        my.data <- Reduce(cbind, sapply(1:length(my.raster.stats),
             function(i) { my.raster.stats[[i]][[2]] }, simplify = FALSE))
            weighted.means <- sapply(1:nrow(my.data), function(i) {
                round(weighted.mean(x = unlist(my.data[i, ]),
                                    w = weights), 16)
            })
        names(weighted.means) <- paste0("t", 0:(length(
                                                 weighted.means)-1))
        my.raster.stats <- list(size = sum(unlist(sapply(seq(from = 1,
                            to = length(my.raster.stats)), function(i) {
                                my.raster.stats[[i]][1] }))),
                            coverage = weighted.means)
        } else {
            ## just flatten
            my.raster.stats <- my.raster.stats[[1]]
        }
    absolute.loss.per.year <- sapply(1:(length(my.raster.stats$coverage)-1),
       function(i) { my.raster.stats$coverage[["t0"]] -
                         my.raster.stats$coverage[[paste0("t", i)]] })
    temporal.loss <- cbind(data.table::data.table(
               region = names(the.grid)[index],
               size = geosphere::areaPolygon(polygon),
               coverage.at.t0 = my.raster.stats$coverage[["t0"]]),
               t(data.frame(absolute.loss.per.year)))
    globallivingconditions::my.log.f(paste(Sys.time(), "Ready with",
          "temporal loss for region", names(the.grid)[index]),
          "deforestation.log")
    return(temporal.loss)
}

@

<<get.more.borders.select.south.america>>=
library(sf)

dir.create(gis.path.sf, showWarnings = FALSE, recursive = TRUE)

library(globallivingconditions) ## iso.3166 and my.log.f()

m49 <- read.csv(system.file("M49.csv", package="globallivingconditions"))
south.america.letter.codes.tmp <- m49$ISO.alpha3.Code[which(m49$Sub.region.Name == "Latin America and the Caribbean")]
## Discard some small islands.
small.islands <- c("AIA", "ATG", "ABW", "BHS", "BRB", "BES", "VGB", "CYM", "CUW", "DMA", "GLP", "MTQ", "MSR", "BLM", "KNA", "LCA", "MAF", "VCT", "SXM", "TCA", "VIR", "BVT", "FLK", "SGS")
south.america.letter.codes <- south.america.letter.codes.tmp[south.america.letter.codes.tmp %in% small.islands == FALSE]

## gadm uses the letter codes, but globallivingconditions uses the digit codes.
## Not all entities are proper countries, so use na.omit to filter out those not existing in iso.3166
south.america.numeric.codes <- as.vector(na.omit(iso.3166$numeric[match(south.america.letter.codes, iso.3166$String.code)]))

## make sure all borders exists

my.borders.inner.f <- function(code, gis.path.sf, absolute.log.filename, level) {
    ## code is the three letter code.
    ## While only the geometry corresponding to level 0 will be returned,
    ## the other levels, if they exist, will be saved to disk.

    my.log.f(paste(Sys.time(), "my.borders.inner.f called with argument", code), absolute.log.filename)
    ## if the file does not exists, then download it

    base.uri.for.gadm <- "https://geodata.ucdavis.edu/gadm/gadm4.1/json/"

    ## Start with level == 0
    ## code is the three letter code, eg. "ARG" for Argentine
    target.filename.base <- paste0("gadm41_", code, "_", 0)
    url.file <- paste0(target.filename.base, ".json")
    disk.file <- paste0(target.filename.base, ".rds")
    
    if(file.exists(paste0(gis.path.sf, disk.file)) == FALSE) {
        ## Look for an indication that this file does not exist at all.
        if(file.exists(paste0(gis.path.sf, disk.file, "does.not.exist"))) {
            ## No level zero file exists at all
            return(NULL)
        }
        my.error <- try(my.sf.df <- st_read(paste0(base.uri.for.gadm, url.file), quiet = TRUE), silent = TRUE)
        if(length(attr(my.error, which = "condition")) > 0) {
            my.log.f(paste(Sys.time(), "no level", 0, "file for", code, "at", paste0(base.uri.for.gadm, url.file),
                           "sleeping to avoid bandwidth limiting measures"), absolute.log.filename)

            ## Make a local note of this.
            file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))

            ## This was level 0, since it did no exist, just return NULL directly.
            return(NULL)
            
        } else {
            my.log.f(paste(Sys.time(), "border successfully downloaded for level 0", code), absolute.log.filename)
            saveRDS(my.sf.df, file = paste0(gis.path.sf, disk.file))
        }
    } else {
        my.log.f(paste(Sys.time(), "border exists locally for level 0", code), absolute.log.filename)
        my.sf.df <- readRDS(paste0(gis.path.sf, disk.file))
    }
    number.of.tries <- 0
    success <- FALSE
    while(level > 0) {
        target.filename.base <- paste0("gadm41_", code, "_", level)
        url.file <- paste0(target.filename.base, ".json")
        disk.file <- paste0(target.filename.base, ".rds")
        if(! file.exists(paste0(gis.path.sf, disk.file))) {
            if(file.exists(paste0(gis.path.sf, disk.file, "does.not.exist"))) {
                level <- level - 1
                next
            }
            number.of.tries <- number.of.tries + 1
            my.error <- try(my.sf.df.subnational <- st_read(paste0(base.uri.for.gadm, url.file), quiet = TRUE), silent = TRUE)
            if(length(attr(my.error, which = "condition")) > 0) {
                if(success) {
                    ## File is there, try this level again, unless we have already tried the max number of times
                    my.log.f(paste(Sys.time(), "download failed at try number", number.of.tries,
                              "for this URI: ", paste0(base.uri.for.gadm, code, "_", level, "_sp.rds"),
                              "sleeping ", 61 * number.of.tries, "seconds"), absolute.log.filename)

                    ## biogeo.ucdavis.edu is unfortunately not reliable, 
                    ## increase the probability of getting a file by sleeping an increasing time for each attempt
                    Sys.sleep(1 * number.of.tries)
                    
                    if(number.of.tries >= 3) {
                        ## Give up on this one
                        file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))
                        level <- level - 1
                    }
                } else {
                    my.log.f(paste(Sys.time(), "no level", level, "file for", code, "at",
                                   paste0(base.uri.for.gadm, url.file)), absolute.log.filename)
                    ## Don't try this level again
                    file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))
                    level <- level - 1
                }
            } else {
                success <- TRUE
                my.log.f(paste(Sys.time(), "border successfully downloaded for level", level, code), absolute.log.filename)
                saveRDS(my.sf.df.subnational, file = paste0(gis.path.sf, disk.file))
                ## Good, move on to next level
                level <- level - 1
            }
        } else {
            success <- TRUE            
            my.log.f(paste(Sys.time(), "border exists locally for level", level, code), absolute.log.filename)
            ## Good, move on to next level
            level <- level - 1
        }
    }
    return(my.sf.df)
}

my.log.f(paste(Sys.time(), "Starting looking for more borders"), "deforestation.log")

## Do not flood the gadm server with requests, run this sequentially
borders.with.GPS <- sapply(south.america.letter.codes, function(x) {
    my.borders.inner.f(x, gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(borders.with.GPS) <- south.america.numeric.codes

my.log.f(paste(Sys.time(), "Borders collected"), "deforestation.log")

## make a single sf object
south.america.border <- Reduce(rbind, borders.with.GPS)

my.log.f(paste(Sys.time(), "Reduced to a single sf object"), "deforestation.log")

## Take the union, avoid errors
sf_use_s2(FALSE)
south.america.union <- st_union(south.america.border)

my.log.f(paste(Sys.time(), "Union created"), "deforestation.log")

these.polygons.are.in.south.america <- st_intersects(sfdf, south.america.union, sparse = FALSE)[,1]
my.log.f(paste(Sys.time(), "Selection created created"), "deforestation.log")

@

<<south.east.asia.prepare>>=
library(globallivingconditions) ## iso.3166 and my.log.f()
south.east.asia.letter.codes <- m49$ISO.alpha3.Code[m49$Sub.region.Name %in% c("Southern Asia", "South-eastern Asia")]

## gadm uses the letter codes, but globallivingconditions uses the digit codes.
## Not all entities are proper countries, so use na.omit to filter out those not existing in iso.3166
south.east.asia.numeric.codes <- as.vector(na.omit(iso.3166$numeric[match(south.east.asia.letter.codes, iso.3166$String.code)]))

## Do not flood the gadm server with requests, run this sequentially
borders.with.GPS <- sapply(south.east.asia.letter.codes, function(x) {
    my.borders.inner.f(x, gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(borders.with.GPS) <- south.east.asia.numeric.codes

my.log.f(paste(Sys.time(), "Borders collected"), "deforestation.log")

## make a single sf object
south.east.asia.border <- Reduce(rbind, borders.with.GPS)

my.log.f(paste(Sys.time(), "Reduced to a single sf object"), "deforestation.log")

## Take the union, avoid errors
sf_use_s2(FALSE)
south.east.asia.union <- st_union(south.east.asia.border)

my.log.f(paste(Sys.time(), "Union created"), "deforestation.log")

these.polygons.are.in.south.east.asia <- st_intersects(sfdf, south.east.asia.union, sparse = FALSE)[,1]
my.log.f(paste(Sys.time(), "Selection created created"), "deforestation.log")

@

<<non.dhs.countries>>=
africa.non.dhs <- c("Algeria", "Tunisia", "Libya", "Congo", "Botswana", "Lesotho", "Guinea-Bissau", "Equatorial Guinea", "Western Sahara", "Sudan", "South Sudan", "Eritrea", "Djibouti", "Somalia")
south.america.non.dhs <- c("Brazil", "Argentina", "Chile", "Uruguay", "Paraguay", "Venezuela (Bolivarian Republic of)", "Ecuador", "Panama", "Costa Rica", "Nicaragua", "Belize", "Mexico", "Cuba", "Jamaica", "Suriname", "French Guiana")

south.asia.non.dhs <- c("Iran (Islamic Republic of)", "Lao People's Democratic Republic", "Viet Nam", "Thailand", "Papua New Guinea", "Sri Lanka")

letter.code.from.name <- function(name) {
    globallivingconditions::iso.3166$String.code[match(name,
                    globallivingconditions::iso.3166$String)]
}

non.dhs.african.borders <- sapply(africa.non.dhs, function(x) {
    my.borders.inner.f(letter.code.from.name(x), gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(non.dhs.african.borders) <- sapply(africa.non.dhs, code.from.name)
## Load the administrative areas, pick the finest resolution there is available
africa.non.dhs.sf <- Reduce(rbind, sapply(africa.non.dhs, function(country.name) {
    this.file <- sort(list.files(path = gis.path.sf,
      pattern = paste0("gadm41_", letter.code.from.name(country.name), "_.*.rds$")),
      decreasing = TRUE)[1]
    tmp <- readRDS(paste0(gis.path.sf, this.file))
    ## Standardize the column structure.
    ## Standardize by keep only a single column, "region",
    ## based on the highest available level
    target.colum.name <- paste0("GID_", length(grep("GID_", colnames(tmp))) - 1)
    tmp$region <- tmp[[target.colum.name]]
    keep.these <- c("region", "geometry")
    for(column in colnames(tmp)){
        if(! column %in% keep.these) {
            tmp[[column]] <- NULL
        }
    }
    tmp
}, simplify = FALSE))

non.dhs.south.american.borders <- sapply(south.america.non.dhs, function(x) {
    my.borders.inner.f(letter.code.from.name(x), gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(non.dhs.south.american.borders) <- sapply(south.america.non.dhs, code.from.name)
## Load the administrative areas, pick the finest resolution there is available
south.america.non.dhs.sf <- Reduce(rbind, sapply(south.america.non.dhs, function(country.name) {
    this.file <- sort(list.files(path = gis.path.sf,
      pattern = paste0("gadm41_", letter.code.from.name(country.name), "_.*.rds$")),
      decreasing = TRUE)[1]
    tmp <- readRDS(paste0(gis.path.sf, this.file))
    ## Standardize the column structure.
    ## Standardize by keep only a single column, "region",
    ## based on the highest available level
    target.colum.name <- paste0("GID_", length(grep("GID_", colnames(tmp))) - 1)
    tmp$region <- tmp[[target.colum.name]]
    keep.these <- c("region", "geometry")
    for(column in colnames(tmp)){
        if(! column %in% keep.these) {
            tmp[[column]] <- NULL
        }
    }
    tmp
}, simplify = FALSE))

non.dhs.south.asian.borders <- sapply(south.asia.non.dhs, function(x) {
    my.borders.inner.f(letter.code.from.name(x), gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(non.dhs.south.asian.borders) <- sapply(south.asia.non.dhs, code.from.name)
## Load the administrative areas, pick the finest resolution there is available
south.asia.non.dhs.sf <- Reduce(rbind, sapply(south.asia.non.dhs, function(country.name) {
    if(country.name %in% c("Thailand", "Viet Nam")) {
        ## This construct will use level 1 (both of these countries have 3 levels,
        ## 3:1[3] will give level 1
        index <- 3
    } else {
        ## Use lowest level by default
        index <- 1
    }
    this.file <- sort(list.files(path = gis.path.sf,
      pattern = paste0("gadm41_", letter.code.from.name(country.name), "_.*.rds$")),
      decreasing = TRUE)[index]
    ## Some exceptions: Use level 1 for Thailand and Viet Nam
    tmp <- readRDS(paste0(gis.path.sf, this.file))
    ## Standardize the column structure.
    ## Standardize by keep only a single column, "region",
    ## based on the highest available level
    target.colum.name <- paste0("GID_", length(grep("GID_", colnames(tmp))) - 1)
    tmp$region <- tmp[[target.colum.name]]
    keep.these <- c("region", "geometry")
    for(column in colnames(tmp)){
        if(! column %in% keep.these) {
            tmp[[column]] <- NULL
        }
    }
    tmp
}, simplify = FALSE))

my.log.f(paste(Sys.time(), "Borders collected"), "deforestation.log")

@

<<grid.creation>>=

dhs.grid <- readRDS("dhs.grid.RDS")
dhs.grid.sf <- st_as_sf(dhs.grid)
dhs.grid.sf$region <- names(dhs.grid)
full.grid.sf <- Reduce(rbind, list(dhs.grid.sf, south.america.non.dhs.sf, africa.non.dhs.sf, south.asia.non.dhs.sf))

## create a SpatialPolygons object (since the existing code assumes that)
## Surprisingly difficult to set the names() on the SP object.
sp.grid <- SpatialPolygons(
  as(full.grid.sf, "Spatial")@polygons,
  proj4string = CRS(st_crs(full.grid.sf)$wkt)
)
library(sp)
ids <- as.character(full.grid.sf$region)
# set IDs on each Polygons object
for (i in seq_along(sp.grid@polygons)) {
  sp.grid@polygons[[i]]@ID <- ids[i]
}

@



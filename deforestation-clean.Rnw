}

# build list of one-row data.tables (column j -> one-row DT)
dt_list <- lapply(seq_len(ncol(mat)), function(j) {
  vals <- mat[, j]                             # named vector of length 26
  names(vals) <- attr(mat, "dimnames")[[1]]    # ensure names come from dimnames[[1]]
  # convert types sensibly (numbers -> numeric, "NA" -> NA, keep strings)
  vals_list <- type.convert(as.list(vals), as.is = TRUE)
  as.data.table(vals_list)                     # single-row data.table
})

# optional: attach original column index/name as an id when binding
combined <- rbindlist(dt_list, use.names = TRUE, fill = TRUE, idcol = "orig_col")
combined[ , orig_col := NULL, ]
small.multiple.tiles.results <- combined

@ 

Stitch together the three pieces. Apparently, the `size` column in `small.areas.means.from.single.tiff` is wrongly called ``V2'', fix that in a way that is robust to the fact that other columns in the data set has the name ``V2''.

<<stitch>>=
if(file.exists("my.spdf.RDS")) {
    spdf <- readRDS("my.spdf.RDS")
    sfdf <- readRDS("my.sfdf.RDS")
    temporal.loss <- readRDS("temporal.loss.RDS")
} else {

colnames(small.areas.means.from.single.tiff)[2] <- "size"

temporal.loss <- rbind(large.polygons.results, small.multiple.tiles.results, small.areas.means.from.single.tiff)

## create a SPDF object, with one layer for each year.
library(data.table)
library(sp)
library(raster)

# 1) Match rows in temporal.loss to polygon order in dhs.grid
#    (assumes names(dhs.grid) are the region IDs)
setDT(temporal.loss)

# keep only needed columns (drop size)
keep_cols <- c("region", "coverage.at.t0", paste0("V", 1:23))
dt <- temporal.loss[, ..keep_cols]

# reorder to match polygon names
idx <- match(names(dhs.grid), dt$region)
if (anyNA(idx)) {
  missing <- names(dhs.grid)[is.na(idx)]
  stop("These polygons have no matching 'region' row in temporal.loss:\n",
       paste(missing, collapse = ", "))
}
dt <- dt[idx]

# also verify there are no duplicated regions (optional but recommended)
if (any(duplicated(dt$region))) {
  stop("Duplicated region names in temporal.loss (cannot 1:1 match to polygons).")
}

## Drop "region", access it via rownames(spdf@data) instead.
dt[, region := NULL, ]

# 2) Base SPDF with all attributes (coverage.at.t0 + V1..V23)
#    row.names must align with polygon IDs
spdf <- SpatialPolygonsDataFrame(
  Sr = dhs.grid,
  data = as.data.frame(dt),
  match.ID = FALSE
)
row.names(spdf@data) <- names(dhs.grid)

library(sf)
sfdf <- st_as_sf(spdf)

saveRDS(spdf, file = "my.spdf.RDS")
saveRDS(sfdf, file = "my.sfdf.RDS")
    saveRDS(temporal.loss, file = "temporal.loss.RDS")
    }


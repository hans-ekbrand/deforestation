<<get.more.borders.select.south.america>>=
library(sf)

gis.path.sf <- "/mnt/c/Users/xekbha/University of Gothenburg/Deforestation and poverty - DHS/GIS-borders-SF/"
dir.create(gis.path.sf, showWarnings = FALSE, recursive = TRUE)

library(globallivingconditions) ## iso.3166 and my.log.f()

m49 <- read.csv("~/src/dhsharmonisation/inst/M49.csv")
south.america.letter.codes.tmp <- m49$ISO.alpha3.Code[which(m49$Sub.region.Name == "Latin America and the Caribbean")]
## Discard some small islands.
small.islands <- c("AIA", "ATG", "ABW", "BHS", "BRB", "BES", "VGB", "CYM", "CUW", "DMA", "GLP", "MTQ", "MSR", "BLM", "KNA", "LCA", "MAF", "VCT", "SXM", "TCA", "VIR", "BVT", "FLK", "SGS")
south.america.letter.codes <- south.america.letter.codes.tmp[south.america.letter.codes.tmp %in% small.islands == FALSE]

## gadm uses the letter codes, but globallivingconditions uses the digit codes.
## Not all entities are proper countries, so use na.omit to filter out those not existing in iso.3166
south.america.numeric.codes <- as.vector(na.omit(iso.3166$numeric[match(south.america.letter.codes, iso.3166$String.code)]))

## make sure all borders exists

my.borders.inner.f <- function(code, gis.path.sf, absolute.log.filename, level) {
    ## code is the three letter code.
    ## While only the geometry corresponding to level 0 will be returned,
    ## the other levels, if they exist, will be saved to disk.

    my.log.f(paste(Sys.time(), "my.borders.inner.f called with argument", code), absolute.log.filename)
    ## if the file does not exists, then download it

    base.uri.for.gadm <- "https://geodata.ucdavis.edu/gadm/gadm4.1/json/"

    ## Start with level == 0
    ## code is the three letter code, eg. "ARG" for Argentine
    target.filename.base <- paste0("gadm41_", code, "_", 0)
    url.file <- paste0(target.filename.base, ".json")
    disk.file <- paste0(target.filename.base, ".rds")
    
    if(file.exists(paste0(gis.path.sf, disk.file)) == FALSE) {
        ## Look for an indication that this file does not exist at all.
        if(file.exists(paste0(gis.path.sf, disk.file, "does.not.exist"))) {
            ## No level zero file exists at all
            return(NULL)
        }
        my.error <- try(my.sf.df <- st_read(paste0(base.uri.for.gadm, url.file), quiet = TRUE), silent = TRUE)
        if(length(attr(my.error, which = "condition")) > 0) {
            my.log.f(paste(Sys.time(), "no level", 0, "file for", code, "at", paste0(base.uri.for.gadm, url.file),
                           "sleeping to avoid bandwidth limiting measures"), absolute.log.filename)

            ## Make a local note of this.
            file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))

            ## This was level 0, since it did no exist, just return NULL directly.
            return(NULL)
            
        } else {
            my.log.f(paste(Sys.time(), "border successfully downloaded for level 0", code), absolute.log.filename)
            saveRDS(my.sf.df, file = paste0(gis.path.sf, disk.file))
        }
    } else {
        my.log.f(paste(Sys.time(), "border exists locally for level 0", code), absolute.log.filename)
        my.sf.df <- readRDS(paste0(gis.path.sf, disk.file))
    }
    number.of.tries <- 0
    success <- FALSE
    while(level > 0) {
        target.filename.base <- paste0("gadm41_", code, "_", level)
        url.file <- paste0(target.filename.base, ".json")
        disk.file <- paste0(target.filename.base, ".rds")
        if(! file.exists(paste0(gis.path.sf, disk.file))) {
            if(file.exists(paste0(gis.path.sf, disk.file, "does.not.exist"))) {
                level <- level - 1
                next
            }
            number.of.tries <- number.of.tries + 1
            my.error <- try(my.sf.df.subnational <- st_read(paste0(base.uri.for.gadm, url.file), quiet = TRUE), silent = TRUE)
            if(length(attr(my.error, which = "condition")) > 0) {
                if(success) {
                    ## File is there, try this level again, unless we have already tried the max number of times
                    my.log.f(paste(Sys.time(), "download failed at try number", number.of.tries,
                              "for this URI: ", paste0(base.uri.for.gadm, code, "_", level, "_sp.rds"),
                              "sleeping ", 61 * number.of.tries, "seconds"), absolute.log.filename)

                    ## biogeo.ucdavis.edu is unfortunately not reliable, 
                    ## increase the probability of getting a file by sleeping an increasing time for each attempt
                    Sys.sleep(1 * number.of.tries)
                    
                    if(number.of.tries >= 3) {
                        ## Give up on this one
                        file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))
                        level <- level - 1
                    }
                } else {
                    my.log.f(paste(Sys.time(), "no level", level, "file for", code, "at",
                                   paste0(base.uri.for.gadm, url.file)), absolute.log.filename)
                    ## Don't try this level again
                    file.create(paste0(gis.path.sf, disk.file, "does.not.exist"))
                    level <- level - 1
                }
            } else {
                success <- TRUE
                my.log.f(paste(Sys.time(), "border successfully downloaded for level", level, code), absolute.log.filename)
                saveRDS(my.sf.df.subnational, file = paste0(gis.path.sf, disk.file))
                ## Good, move on to next level
                level <- level - 1
            }
        } else {
            success <- TRUE            
            my.log.f(paste(Sys.time(), "border exists locally for level", level, code), absolute.log.filename)
            ## Good, move on to next level
            level <- level - 1
        }
    }
    return(my.sf.df)
}

my.log.f(paste(Sys.time(), "Starting looking for more borders"), "deforestation.log")

## Do not flood the gadm server with requests, run this sequentially
borders.with.GPS <- sapply(south.america.letter.codes, function(x) {
    my.borders.inner.f(x, gis.path.sf, absolute.log.filename = "deforestation.log", level = 3)
}, simplify = FALSE)
names(borders.with.GPS) <- south.america.numeric.codes

my.log.f(paste(Sys.time(), "Borders collected"), "deforestation.log")

## make a single sf object
south.america.border <- Reduce(rbind, borders.with.GPS)

my.log.f(paste(Sys.time(), "Reduced to a single sf object"), "deforestation.log")

## Take the union, avoid errors
sf_use_s2(FALSE)
south.america.union <- st_union(south.america.border)

my.log.f(paste(Sys.time(), "Union created"), "deforestation.log")

these.polygons.are.in.south.america <- st_intersects(sfdf, south.america.union, sparse = FALSE)[,1]
my.log.f(paste(Sys.time(), "Selection created created"), "deforestation.log")


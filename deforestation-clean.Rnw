Each subset includes the average education in years for the adults aged 24-44 in year 2000 and aged 45-65 in year 2021, in order for us to be able to estimate how different the group surveyed in one year is from the group surveyed another year (in the same area), even if the educational level is increasing during the study period. By focussing on the persons who have already aquired their education when the study starts, we make use of the invariant feature of education, it is never lost.

Select variables actually used in the analyses.

<<choose.vars>>=
library(globallivingconditions)
my.dt <- readRDS("final.RDS")

vars.to.keep=c("source", "version", "year.of.interview",
               "country.code.ISO.3166.alpha.3", 
"m49.region", "RegionID", "district", "ClusterID", "ClusterID.clean", 
"PersonID.unique", "severe.food.deprivation", "severe.water.deprivation", 
"severe.sanitation.deprivation", "severe.shelter.deprivation", "has.electricity",
"HouseholdID", "month.of.interview", "sample.weight", "water", "time.to.water",
"iwi", "rural", "lon", "lat", "phone", "owns.tv", "owns.land", "refridgerator",
"owns.livestock",
"relation.to.hh", "age", "education.in.years", "education", "superClusterID")

drop.these <- colnames(my.dt)[! colnames(my.dt) %in% vars.to.keep]
my.dt[, (drop.these) := NULL, ]

## Create the set of numeric codes of the countries in the sample.
country.codes <- my.dt[, unique(country.code.ISO.3166.alpha.3), ]

## Store some meta data about the number of clusters
n.measurement.locations <- nrow(unique(my.dt[, list(lon, lat), ]))

## And the number of persons
n.persons <- nrow(my.dt)

## This data set is too large to be cached; save, delete now,
## and reload later.
saveRDS(my.dt, file = "reduced.RDS")

rm(my.dt)
gc(verbose=FALSE)

@

Create a custom subset for each deprivation, including only the cases which have data on this deprivation and add country level factors. Note that these files do have non-standard values on the variable ``Country Name'', e.g. ``Tanzania'' instead of the standard compliant ``United Republic of Tanzania'', so use the three letter code instead of the name when merging data. The existing code uses the country name, create a new variable ``Country Name'' using the mapping in the dataset «iso.3166«, which is part of «globallivingconditions«.

<<continued.country>>=
library("readxl"); library(data.table); library(globallivingconditions)
country.data <- Reduce(merge, sapply(
  c("API_NY.GDP.PCAP.CD_DS2_en_excel_v2_5795829.xlsx",
       "API_NE.EXP.GNFS.ZS_DS2_en_excel_v2_5728793.xlsx",
       "API_NV.AGR.TOTL.ZS_DS2_en_excel_v2_5728821.xlsx",
       "API_SP.POP.1564.TO_DS2_en_excel_v2_5731200.xlsx"), function(x) {
  temp.dt.1 <- data.table(read_excel(paste0(country.data.path, x), skip = 2))
  meta.data <- temp.dt.1[["Indicator Name"]][1]
  temp.dt.1[, c("Indicator Name", "Indicator Code", "Country Name") := NULL, ]
  temp.dt.2 <- melt(temp.dt.1, id.vars = "Country Code",
                    variable.name = "raw.year", value.name = meta.data)
  temp.dt.2[, raw.year := as.numeric(as.character(temp.dt.2$raw.year)), ]
  ## Create a proper name, based on the tree letter code
    temp.dt.2[, country := iso.3166$String[match(`Country Code`,
                                                 iso.3166$String.code)], ]
  ## Drop the three letter code.
  temp.dt.2[, `Country Code` := NULL, ]
  ## Drop cases that have missing data on the identifier variables.
  temp.dt.3 <- temp.dt.2[is.na(country) == FALSE, ]
  setkey(temp.dt.3, country, raw.year)
  return(temp.dt.3)
}, simplify = FALSE))

## improve some variable names which has reserved characters in them.
bad.names <- c("GDP per capita (current US$)",
               "Exports of goods and services (% of GDP)",
               "Agriculture, forestry, and fishing, value added (% of GDP)",
               "Population ages 15-64, total")
nice.names <- c("GDP",
                "percent.goods.and.services.percent.of.gdp",
                "agriculture.forestry.percent.of.gdp",
                "population.15.64")
for(i in 1:length(bad.names)){
    colnames(country.data) <- gsub(bad.names[i], nice.names[i],
                                   colnames(country.data), fixed = TRUE)
}
@

To identify which grid cell(s) of deforestation data cover the gadm region, find the North West corner, that is, «max(latitude)« and «min(longitude)« of the bounding box, and that gives the first needed cell. Then extend to east and south if necessary. Assume no region covers more than four grid cells.

<<find.the.grid.cell, dependson = "load.data.using.child.document">>=
library(httr)
## version <- "2021-v1.9"
version <- "2023-v1.11"
url.gcf <- "https://storage.googleapis.com/earthenginepartners-hansen/GFC-"
base.url <- paste0(url.gcf, version, "/")
file.name.prefix <- paste0("Hansen_GFC-", version, "_")

my.years <- 1:23

## helper functions
url.from.point.f <- function(lon, lat, layer){
    lon.first.corner <- floor(lon / 10) * 10
    lat.first.corner <- ceiling(lat / 10) * 10
    if(abs(lon.first.corner) > 100){
        lon.corner <- abs(lon.first.corner)
    } else {
        lon.corner <- paste0("0", abs(lon.first.corner))        
    }
    if(abs(lon.first.corner) < 10){
        ## longitude 0 is written 000E
        lon.corner <- paste0("00", abs(lon.first.corner))
    }    
    if(lon.first.corner < 0){
        lon.corner <- paste0(lon.corner, "W")
    } else {
        lon.corner <- paste0(lon.corner, "E")    
    }
    ## For some reason I still see values like "0100E"
    ## that should be 100E.
    ## Dirty hack:
    if(nchar(lon.corner) > 4){
        lon.corner <- substring(lon.corner, 2, 5)
    }
    if(abs(lat.first.corner) < 10){
        ## latitude 0 is written 00N
        lat.corner <- paste0("0", abs(lat.first.corner))
    } else {
        lat.corner <- abs(lat.first.corner)        
    }
    if(lat.first.corner < 0){
        lat.corner <- paste0(lat.corner, "S")
    } else {
        lat.corner <- paste0(lat.corner, "N")    
    }
    my.file <- paste0(file.name.prefix, layer, "_",
                      lat.corner, "_", lon.corner, ".tif")
    return(my.file)
}
point.at.corners.f <- function(combination, my.bbox){
    c(my.bbox["x", combination[1]], my.bbox["y", combination[2]])
}

obsolete.file.name.from.bbox.f <- function(bbox, layer){
    my.combinations <- unlist(sapply(1:2, function(x){ sapply(1:2,
       function(y) { c(x, y) }, simplify = FALSE) }, simplify = FALSE),
                              recursive = FALSE)
    points.at.corners <- sapply(my.combinations, point.at.corners.f,
                                my.bbox = bbox)
    urls.at.corners <- apply(points.at.corners, 2, function(x) {
        url.from.point.f(lon=x[1], lat=x[2], layer) })
    return(unique(urls.at.corners))
}

file.name.from.bbox.f <- function(bbox, layer, tile_deg = 10, eps = 1e-10) {
  # bbox is sp::bbox result: matrix with rows x,y and cols min,max

  xmin <- bbox["x", "min"]
  xmax <- bbox["x", "max"]
  ymin <- bbox["y", "min"]
  ymax <- bbox["y", "max"]

  # Apply half-open convention by nudging max inward a hair.
  # This makes xmax=20 belong to the tile [10,20), not [20,30).
  xmax2 <- xmax - eps
  ymax2 <- ymax - eps

  # Handle degenerate bboxes (e.g., width 0) safely
  if (xmax2 < xmin) xmax2 <- xmin
  if (ymax2 < ymin) ymax2 <- ymin

  # Compute tile indices (multiples of tile_deg)
  x_starts <- seq(floor(xmin / tile_deg) * tile_deg,
                  floor(xmax2 / tile_deg) * tile_deg,
                  by = tile_deg)

  y_starts <- seq(floor(ymin / tile_deg) * tile_deg,
                  floor(ymax2 / tile_deg) * tile_deg,
                  by = tile_deg)

  # Convert tile start (south edge) to the NW corner latitude (ymax of tile)
  # Tile spans [y, y+tile_deg); NW corner lat is y+tile_deg.
  tiles <- expand.grid(xmin_tile = x_starts, ymin_tile = y_starts)

  urls <- apply(tiles, 1, function(t) {
    lon_west <- t[["xmin_tile"]]
    lat_north <- t[["ymin_tile"]] + tile_deg
    url.from.point.f(lon = lon_west, lat = lat_north, layer = layer)
  })

  unique(urls)
}

url.from.file.f <- function(file.name) { paste0(base.url, file.name) }

dhs.grid <- readRDS("dhs.grid.RDS")

for(i in 1:length(dhs.grid)){
    my.bbox <- dhs.grid[i]@bbox
    for(my.layer in c("treecover2000", "lossyear")){
        my.files <- file.name.from.bbox.f(my.bbox, layer = my.layer)
        my.urls <- sapply(my.files, url.from.file.f)
        ## fetch missing files
        for(j in 1:length(my.files)){
            file.and.path <- paste0(deforestation.path, my.files[j])
            if(!file.exists(file.and.path)){
	        globallivingconditions::my.log.f(paste(Sys.time(),
  "polygon number", i, "j", j, "will download this url:", my.urls[j],
  "and save it as", file.and.path), "deforestation.log")
                httr::GET(my.urls[j], httr::write_disk(file.and.path))
            }
        }
    }
}


<<function.definitions.for.efficient.parallelization>>=
split_polygon_by_extents_sp <- function(poly,
                                       extents,
                                       target_n = 15) {
  stopifnot(inherits(poly, "SpatialPolygons"))
  stopifnot(length(extents) >= 1)
  stopifnot(is.numeric(target_n) && target_n >= 1)

  if (!requireNamespace("sp", quietly = TRUE)) stop("Need package 'sp'.")
  if (!requireNamespace("raster", quietly = TRUE)) stop("Need package 'raster'.")

  library(sp)
  library(raster)

  crs_poly <- sp::proj4string(poly)

  # Convert extents to SpatialPolygons and set CRS
  extent_polys <- lapply(extents, function(e) {
    if (inherits(e, "Raster")) e <- raster::extent(e)
    stopifnot(inherits(e, "Extent"))
    p <- as(e, "SpatialPolygons")
    sp::proj4string(p) <- crs_poly
    p
  })

  # Cheap bbox overlap check (fast, avoids many bad intersect calls)
  bbox_overlaps <- function(a, b) {
    ba <- sp::bbox(a); bb <- sp::bbox(b)
    !(ba[1,2] < bb[1,1] || ba[1,1] > bb[1,2] || ba[2,2] < bb[2,1] || ba[2,1] > bb[2,2])
  }

  safe_intersect <- function(a, b) {
    if (!bbox_overlaps(a, b)) return(NULL)
    # tryCatch catches BOTH warnings elevated to errors and real errors
    out <- tryCatch(
      suppressWarnings(raster::intersect(a, b)),
      warning = function(w) NULL,
      error   = function(e) NULL
    )
    if (is.null(out)) return(NULL)

    # Sometimes returns empty/invalid things; reject those
    # (raster::intersect usually returns SpatialPolygons or NULL)
    if (!inherits(out, "SpatialPolygons")) return(NULL)
    if (length(out) == 0) return(NULL)
    if (any(is.na(sp::bbox(out)))) return(NULL)

    out
  }

  # Intersect polygon with each extent → per-tile polygon
  per_tile <- lapply(extent_polys, function(ep) safe_intersect(poly, ep))
  keep_idx <- which(!vapply(per_tile, is.null, logical(1)))
  per_tile <- per_tile[keep_idx]

  if (length(per_tile) == 0) stop("Polygon does not intersect any provided extent.")

  # Allocate subdivisions proportional to area
  areas <- vapply(per_tile, function(p) {
    # raster::area works for lon/lat; returns km^2 for geographic CRS
    sum(raster::area(p), na.rm = TRUE)
  }, numeric(1))
  areas[!is.finite(areas)] <- 0

  if (sum(areas) <= 0) {
    k_per_tile <- rep(1L, length(per_tile))
  } else {
    raw <- target_n * areas / sum(areas)
    k_per_tile <- pmax(1L, as.integer(round(raw)))
    # Adjust to match target_n more closely
    diff <- target_n - sum(k_per_tile)
    if (diff != 0) {
      ord <- order(areas, decreasing = (diff > 0))
      idx <- rep(ord, length.out = abs(diff))
      if (diff > 0) k_per_tile[idx] <- k_per_tile[idx] + 1L
      if (diff < 0) k_per_tile[idx] <- pmax(1L, k_per_tile[idx] - 1L)
    }
  }

  # Helper: split one polygon into k pieces by a grid, then intersect each cell
  split_one <- function(p, k) {
    if (k <= 1) return(list(p))

    bb <- sp::bbox(p)
    dx <- bb[1,2] - bb[1,1]
    dy <- bb[2,2] - bb[2,1]
    if (!is.finite(dx) || !is.finite(dy) || dx <= 0 || dy <= 0) return(list(p))

    nx <- max(1L, round(sqrt(k * dx / dy)))
    ny <- max(1L, round(k / nx))

    xs <- seq(bb[1,1], bb[1,2], length.out = nx + 1)
    ys <- seq(bb[2,1], bb[2,2], length.out = ny + 1)

    grid_polys <- vector("list", nx * ny)
    idx <- 1L
    for (i in seq_len(nx)) {
      for (j in seq_len(ny)) {
        coords <- matrix(c(
          xs[i],   ys[j],
          xs[i+1], ys[j],
          xs[i+1], ys[j+1],
          xs[i],   ys[j+1],
          xs[i],   ys[j]
        ), ncol = 2, byrow = TRUE)

        grid_polys[[idx]] <- sp::Polygons(list(sp::Polygon(coords)), ID = as.character(idx))
        idx <- idx + 1L
      }
    }
    grid <- sp::SpatialPolygons(grid_polys, proj4string = sp::CRS(crs_poly))

    pieces <- safe_intersect(grid, p)
    if (is.null(pieces)) return(list(p))

    # Convert SpatialPolygons with many Polygons into list of SpatialPolygons (one each)
    lapply(slot(pieces, "polygons"), function(pg) {
      sp::SpatialPolygons(list(pg), proj4string = sp::CRS(crs_poly))
    })
  }

  out <- list()
  for (i in seq_along(per_tile)) {
    parts <- split_one(per_tile[[i]], k_per_tile[i])
    # annotate which original extent index it came from (in case you want it)
    for (p in parts) {
      attr(p, "extent_index") <- keep_idx[i]
      out[[length(out) + 1L]] <- p
    }
  }

  out
}

temporal.loss.directly.from.possible.multiple.files <- function(index,
      deforestation.path, ...) {

    ## This version is for smaller polygons, less than 5k Km^2
    
    ## index refers to dhs.grid
    polygon <- dhs.grid[index]
    
    my.bbox <- sp::bbox(polygon)
    my.cover.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "treecover2000")
    my.loss.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "lossyear")
    polygon.size <- geosphere::areaPolygon(polygon)
    
    globallivingconditions::my.log.f(paste(Sys.time(),
         "in temporal.loss.directly.from.possible.multiple.files()",
         "working with index =", index,
         "region name:", names(dhs.grid)[index],
         "About to iterate over", length(my.cover.files),
         "cover files to produce data about a polygon of size:",
         polygon.size),
         "deforestation.log")
         
    fetch.raster(c(my.cover.files, my.loss.files),
                 deforestation.path = deforestation.path, ...)

    if(length(my.cover.files) > 1) {

        my.raster.stats <- sapply(1:length(my.cover.files), function (i) {

            globallivingconditions::my.log.f(
                paste(Sys.time(), "Starting to work with cover file", i),
                "deforestation.log")
            
            average.coverage.over.time.directly.from.single.file.fast(
                polygon = polygon, my.cover.file = my.cover.files[i],
                my.loss.file = my.loss.files[i],
                deforestation.path = deforestation.path)
        }, simplify = FALSE)

        ## If any element is NULL remove it
        these.are.null <- which(sapply(my.raster.stats, is.null))
        if(length(these.are.null) > 0) {
            ## assume not all of them are null
            my.raster.stats <- my.raster.stats[-these.are.null]
        }

        globallivingconditions::my.log.f(
          paste(Sys.time(), "my.raster.stats are ready for index", index), 
           "deforestation.log") 
        
        ## if there are still more than one element, then create a
        ## weighted mean
        if(length(my.raster.stats) > 1) {
            weights <- as.vector(prop.table(unlist(sapply(seq(from = 1,
                             to = length(my.raster.stats)), function(i) {
                                 my.raster.stats[[i]][1] }))))
            ## restructure so that we don't need to know the number of
            ## tiff-files were used
            my.data <- Reduce(cbind, sapply(1:length(my.raster.stats),
             function(i) { my.raster.stats[[i]][[2]] }, simplify = FALSE))
            weighted.means <- sapply(1:nrow(my.data), function(i) {
                round(weighted.mean(x = unlist(my.data[i, ]),
                                    w = weights), 16)
            })
            names(weighted.means) <- paste0("t", 0:(length(
                                                     weighted.means)-1))
            my.raster.stats <- list(size = sum(unlist(sapply(seq(from = 1,
                            to = length(my.raster.stats)), function(i) {
                                my.raster.stats[[i]][1] }))),
                            coverage = weighted.means)
        } else {
            ## just flatten
            my.raster.stats <- my.raster.stats[[1]]
        }
    } else {
        my.raster.stats <- average.coverage.over.time.directly.from.single.file.fast(
            polygon = polygon, my.cover.file = my.cover.files,
            my.loss.file = my.loss.files, deforestation.path)
    }
    absolute.loss.per.year <- sapply(1:(length(my.raster.stats$coverage)-1),
       function(i) { my.raster.stats$coverage[["t0"]] -
                         my.raster.stats$coverage[[paste0("t", i)]] })
    temporal.loss <- cbind(data.table::data.table(
               region = names(dhs.grid)[index],
               size = geosphere::areaPolygon(polygon),
               coverage.at.t0 = my.raster.stats$coverage[["t0"]]),
               t(data.frame(absolute.loss.per.year)))
    globallivingconditions::my.log.f(paste(Sys.time(), "Ready with",
          "temporal loss for region", names(dhs.grid)[index]),
          "deforestation.log")
    return(temporal.loss)
}

temporal.loss.for.multiple.areas.from.a.single.grid.cell <- function(index,
                                                deforestation.path, ...) {
    ## if index is a vector, be smart, otherwise just call (what?, maybe
    ## temporal.loss.directly.from.possible.multiple.files()?
    
    ## needs: dhs.grid
    ## calls: file.name.from.bbox.f
    ## calls with ... : fetch.raster(my.files, deforestation.path, verbose = FALSE)

    ## Try to be pure, only read _functions_ from the global environment,
    ## not variables.

    globallivingconditions::my.log.f(paste(Sys.time(),
         "in temporal.loss.for.multiple.areas.from.a.single.grid.cell()",
         "found",
         "deforestation.path to be", deforestation.path),
         "deforestation.log")

    globallivingconditions::my.log.f(paste(Sys.time(),
      "temporal.loss.for.multiple.areas.from.a.single.grid.cell called",
      "with a vector argument", paste(index, collapse = ", ")),
      "deforestation.log")
    if(length(index) == 1) {
        globallivingconditions::my.log.f(paste(Sys.time(),
         "Error: temporal.loss.for.multiple.areas.from.a.single.grid.cell",
         "called with a scalar argument", index), "deforestation.log")
        return(NULL)
    }
    ## Verify that a single grid cells covers multiple areas.
    my.cover.files <- sapply(index, function(i) {
        file.name.from.bbox.f(bbox = sp::bbox(dhs.grid[i]),
                              layer = "treecover2000")
    })
    if(length(table(my.cover.files)) > 1) {
      globallivingconditions::my.log.f(paste(Sys.time(),
        "Error: temporal.loss.for.multiple.areas.from.a.single.grid.cell",
        "called with a vector argument but not all cover files are",
        "identical", paste(index, collapse = ", ")), "deforestation.log")
        return(NULL)
    }
    my.loss.files <- file.name.from.bbox.f(bbox = sp::bbox(
                                 dhs.grid[index[1]]), layer = "lossyear")
    fetch.raster(c(my.cover.files, my.loss.files),
                 deforestation.path = deforestation.path, ...)
    
    ## load the grid cells (only meta data is loaded)
    my.cover.raster <- raster::raster(paste0(deforestation.path,
                                             my.cover.files[1]))
    my.loss.raster <- raster::raster(paste0(deforestation.path,
                                            my.loss.files[1]))

    ## Create my.raster.stats in a way that does not require crop()
    ## my.cover.files is guaranteed to be a single scalar.
    ## We pass the raster pointer instead of the file names to avoid
    ## having to read metadata thousands of times for the same tif file.

    my.f <- function(i) {
        polygon <- dhs.grid[i]
        my.raster.stats <- average.coverage.over.time.directly.from.single.file.pointer.fast(polygon,
                   my.cover.raster, my.loss.raster)
        absolute.loss.per.year <- sapply(1:(length(
            my.raster.stats$coverage)-1), function(i) {
                my.raster.stats$coverage[["t0"]] -
                    my.raster.stats$coverage[[paste0("t", i)]] })
        globallivingconditions::my.log.f(paste(Sys.time(),
              "Ready with temporal loss for area", names(dhs.grid)[i],
              "size", my.raster.stats$size/1e6, "Km^2"),
                 "deforestation.log")    
        temporal.loss <- cbind(data.table::data.table(
                                               region = names(
                                                   dhs.grid)[i],
                                               my.raster.stats$size,
                         coverage.at.t0 = my.raster.stats$coverage[["t0"]]),
                               t(data.frame(absolute.loss.per.year)))
    }
    
    results <- sapply(index, my.f, simplify = FALSE)
    ## rm(my.loss.raster, my.cover.raster);
    trash <- gc(verbose = FALSE)
    raster::removeTmpFiles(h=0)
    return(results)
}

## Split tasks by RAM requirements
library(future.apply)
plan(multisession, workers = 7)

area.sizes <- future_sapply(dhs.grid@polygons, function(p) {
  # p is a 'Polygons' object; slot(p, "Polygons") is a list of 'Polygon' rings
  rings <- slot(p, "Polygons")
  sum(vapply(rings, function(r) geosphere::areaPolygon(slot(r, "coords")), numeric(1)))
}, future.seed=TRUE)

large.polygons <- which(area.sizes > 5e9)

## For all small regions, derive the necessary grid cells.
non.large.polygons <- (1:length(dhs.grid))[-large.polygons]
files.required <- future_sapply(non.large.polygons, function(i) {
    file.name.from.bbox.f(bbox = sp::bbox(dhs.grid[i]),
                          layer="treecover2000")
}, future.seed=TRUE)

files.required.string <- sapply(files.required, paste, collapse = ", ")
files.required.unique.string <- unique(files.required.string)
files.required.unique <- unique(files.required)

## Categorise regions based on the files the require.
categories.of.requirements <- sapply(unique(files.required.unique.string),
                                     function(required.files) {
    which(files.required.string == required.files)
})

single.tiff.requirements <- categories.of.requirements[which(
    sapply(files.required.unique, length) == 1)]

multiple.tiff.requirements <- categories.of.requirements[which(
    sapply(files.required.unique, length) > 1)]

## order single.tiff.requirements by estimated computation cost (ignore size)
tile_cost <- sapply(single.tiff.requirements, length)
ord <- order(tile_cost, decreasing = TRUE)
single.tiff.requirements <- single.tiff.requirements[ord]

@

\section{Efficient parallelization}
\label{sec:effic-parall}

There are three classes of cases that each need a customized strategy for parallelization. The first class are those areas that are so large that processing the area in one go would require more RAM than the total amount of RAM divided by the number of processor cores. For these areas an algorithm that parallelizes by dividing up the area in smaller parts is used. At any given moment in time work is only being done on parts of a single area, but up to four different tiles can be used simultaneously. The second class are small areas that intersect with a single tile. For these, we avoid recreating the raster corresponding to that tile, in stead a single raster is created per tile, and all calculations use the same raster (the raster is just a structure in memory , but it does require reading metadata from disk which we minimize). The third class are small areas that intersect at least two tiles.

\subsection{Small polygons - single tile required}
\label{sec:small-polyg-single}

Setup a cluster, organise by the required tile. Evaluate «temporal.loss.from.single.file.pointer.f()«, which is basically a wrapper around «average.coverage.over.time.directly.from.single.file.pointer.fast()« but that also creates the needer raster pointers, on all areas that require the same single tile.

<<small.polygons>>=
if(file.exists("small.polygons.RDS")) {
    small.areas.means.from.single.tiff <- readRDS("small.polygons.RDS")
} else {
library(foreach); library(future); library(doRNG)
## n.cores <- parallelly::availableCores(method = c("Slurm", "system"))-1
## plan(multisession, workers = n.cores)
doFuture::registerDoFuture()

small.areas.means.from.single.tiff <- data.table::rbindlist(
   foreach(i=1:length(single.tiff.requirements),
           .options.future = list(scheduling = 1, chunk.size = 1)) %dorng% {

 ## Make note in the log that we started working with this tiff, so that we can track progress.
 globallivingconditions::my.log.f(paste(Sys.time(),
             "Starting to work with tiff number", i, "which is used by",
             length(single.tiff.requirements[[i]]), "polygons"),
                 "deforestation.log")    

 ## create the two file names needed for this batch.
 my.cover.file <- names(single.tiff.requirements)[i]
 my.loss.file <- gsub("treecover2000", "lossyear", my.cover.file, fixed = TRUE)
 fetch.raster(c(my.cover.file, my.loss.file), deforestation.path = deforestation.path)
 my.cover.raster <- raster::raster(paste0(deforestation.path, my.cover.file))
 my.loss.raster <- raster::raster(paste0(deforestation.path, my.loss.file))

 small.areas <- single.tiff.requirements[[i]]

 ## define a function
 temporal.loss.from.single.file.pointer.f <- function(j) {
    polygon <- dhs.grid[j]
    my.raster.stats <- average.coverage.over.time.directly.from.single.file.pointer.fast(
        polygon, my.cover.raster, my.loss.raster)
    absolute.loss.per.year <- sapply(1:(length(
        my.raster.stats$coverage)-1), function(k) {
            my.raster.stats$coverage[["t0"]] -
                my.raster.stats$coverage[[paste0("t", k)]] })
    globallivingconditions::my.log.f(paste(Sys.time(),
              "Ready with temporal loss for area", names(dhs.grid)[j],
              "size", round(my.raster.stats$size/1e6), "Km^2"),
                 "deforestation.log")
    temporal.loss <- cbind(data.table::data.table(
                                           region = names(
                                               dhs.grid)[j],
                                           my.raster.stats$size,
                                           coverage.at.t0 = my.raster.stats$coverage[["t0"]]),
                           t(data.frame(absolute.loss.per.year)))
}

 ## iterate over all indices, note only normal sequential sappply() here,
 ## because this is the inner loop.
 my.temp.dt <- data.table::rbindlist(sapply(non.large.polygons[small.areas],
                             temporal.loss.from.single.file.pointer.f, simplify = FALSE))
})
}

@

<<large.polygons.aggressive.parallelisation, eval = ! file.exists("my.spdf.RDS")>>=
temporal.loss.non.forking.version <- function(
         index, deforestation.path, ...) {

    ## index refers to dhs.grid
    polygon <- dhs.grid[index]
    
    my.bbox <- sp::bbox(polygon)
    my.cover.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "treecover2000")
    my.loss.files <- file.name.from.bbox.f(
        bbox = my.bbox, layer = "lossyear")
    polygon.size <- geosphere::areaPolygon(polygon)
    globallivingconditions::my.log.f(paste(Sys.time(),
         "in temporal.loss.non.forking.version()",
         "working with index =", index,
         "region name:", names(dhs.grid)[index],
         "About to iterate over", length(my.cover.files),
         "cover files to produce data about a polygon of size:",
         round(polygon.size / 1e6), "Km^2"),
         "deforestation.log")
         
    fetch.raster(c(my.cover.files, my.loss.files),
                 deforestation.path = deforestation.path, ...)

    ## This version of the function should only be called
    ## sequentially on large areas, since it forks.
    
    ## Divide the original polygon in smaller polygons, in order to
    ## increase efficient parallelize computations.

    extents <- lapply(my.cover.files, function(f) {
        raster::extent(raster::raster(file.path(deforestation.path, f)))
    })

    pieces <- split_polygon_by_extents_sp(
        poly = dhs.grid[index],
        extents = extents,
        target_n = max(7, round(polygon.size / 5e9)) ## 5000 km^2 is fine, 7 because I have 8 cores on the server, so keep them busy
    )

    ## Sort pieces by size, largest first to make most out of the parallelization
    pieces <- pieces[order(sapply(pieces, geosphere::areaPolygon), decreasing = TRUE)]

    ## Now loop over pieces instead of the full polygon
    globallivingconditions::my.log.f(
       paste(Sys.time(), "iterating over a set of",
             length(pieces), "small polygons"),
       "deforestation.log")

    inner.function <- function(p) {
        ## each p is guaranteed to only require a single cover file.
        ## but which cover file is it?
        ## We need to detect that!
        my.small.bbox <- sp::bbox(p)
        my.small.cover.file <- file.name.from.bbox.f(
            bbox = my.small.bbox,
            layer = "treecover2000")
        my.small.loss.file <- file.name.from.bbox.f(
            bbox = my.small.bbox,
            layer = "lossyear")

        ## debug START
        small.polygon.size <- geosphere::areaPolygon(p)
        globallivingconditions::my.log.f(
            paste(Sys.time(), "Working with a small polygon with size",
                  round(small.polygon.size/1e6), "Km^2"),
            "deforestation.log")
        ## debug STOP
            
        average.coverage.over.time.directly.from.single.file.fast(
            polygon = p, my.cover.file = my.small.cover.file,
            my.loss.file = my.small.loss.file,
            deforestation.path = deforestation.path)
    }

    my.raster.stats <- sapply(pieces, inner.function, simplify = FALSE)
    ## At this point, no more data collection from disk is needed, so clean the
    ## cache now.
    raster_tmp <- file.path(tempdir(), "raster")

    if (dir.exists(raster_tmp)) {
        globallivingconditions::my.log.f(
         paste(Sys.time(), "Cleaning the temp-dir/raster used for index", index), 
         "deforestation.log") 
        
        unlink(raster_tmp, recursive = TRUE, force = TRUE)
    }
    
    ## If any element is NULL remove it
    ## (This probably only happened due to a bug in file.name.from.bbox.f
    ## which included tiles that only shared points but not area with the polygon)
    
    these.are.null <- which(sapply(my.raster.stats, is.null))
    if(length(these.are.null) > 0) {
        ## assume not all of them are null
        my.raster.stats <- my.raster.stats[-these.are.null]
    }

    globallivingconditions::my.log.f(
         paste(Sys.time(), "my.raster.stats are ready for index", index), 
         "deforestation.log") 
        
    ## if there are still more than one element, then create a
    ## weighted mean
    if(length(my.raster.stats) > 1) {
        weights <- as.vector(prop.table(unlist(sapply(seq(from = 1,
                             to = length(my.raster.stats)), function(i) {
                                 my.raster.stats[[i]][1] }))))
        ## restructure so that we don't need to know the number of
        ## tiff-files were used
        my.data <- Reduce(cbind, sapply(1:length(my.raster.stats),
             function(i) { my.raster.stats[[i]][[2]] }, simplify = FALSE))
            weighted.means <- sapply(1:nrow(my.data), function(i) {
                round(weighted.mean(x = unlist(my.data[i, ]),
                                    w = weights), 16)
            })
        names(weighted.means) <- paste0("t", 0:(length(
                                                 weighted.means)-1))
        my.raster.stats <- list(size = sum(unlist(sapply(seq(from = 1,
                            to = length(my.raster.stats)), function(i) {
                                my.raster.stats[[i]][1] }))),
                            coverage = weighted.means)
        } else {
            ## just flatten
            my.raster.stats <- my.raster.stats[[1]]
        }
    absolute.loss.per.year <- sapply(1:(length(my.raster.stats$coverage)-1),
       function(i) { my.raster.stats$coverage[["t0"]] -
                         my.raster.stats$coverage[[paste0("t", i)]] })
    temporal.loss <- cbind(data.table::data.table(
               region = names(dhs.grid)[index],
               size = geosphere::areaPolygon(polygon),
               coverage.at.t0 = my.raster.stats$coverage[["t0"]]),
               t(data.frame(absolute.loss.per.year)))
    globallivingconditions::my.log.f(paste(Sys.time(), "Ready with",
          "temporal loss for region", names(dhs.grid)[index]),
          "deforestation.log")
    return(temporal.loss)
}

library(foreach); library(future); library(doRNG); library(future.apply)
n.cores <- parallelly::availableCores(method = c("cgroups.cpuquota", "Slurm", "system"))-1
if(file.exists("/mnt/c")){
    n.cores = 4 ## my wsl1 laptop forces raster() to create objects on disk,
    ## which in turn makes the unresponsive if I use more cores than this.
}
globallivingconditions::my.log.f(paste(Sys.time(), "Using", n.cores, "for future_sapply()"),
          "deforestation.log")
plan(multisession, workers = n.cores)
my.means <- future_sapply(large.polygons, temporal.loss.non.forking.version, deforestation.path = deforestation.path, future.seed=TRUE)

@

<<make.my.means.a.data.table, echo = FALSE, eval = ! file.exists("my.spdf.RDS")>>=
## recover a useful structure for the data of my.means. I forgot "simplify = FALSE" in future_sapply(), so have to fix that now.
# ensure it's a matrix-like object
mat <- as.matrix(my.means)   # uses existing dim / dimnames

# defensive check (will stop with informative message if shape unexpected)
if (nrow(mat) != length(attr(mat, "dimnames")[[1]])) {
  stop("Unexpected shape: number of rows doesn't match length of dimnames[[1]]")
}

# build list of one-row data.tables (column j -> one-row DT)
dt_list <- lapply(seq_len(ncol(mat)), function(j) {
  vals <- mat[, j]                             # named vector of length 26
  names(vals) <- attr(mat, "dimnames")[[1]]    # ensure names come from dimnames[[1]]
  # convert types sensibly (numbers -> numeric, "NA" -> NA, keep strings)
  vals_list <- type.convert(as.list(vals), as.is = TRUE)
  as.data.table(vals_list)                     # single-row data.table
})

# optional: attach original column index/name as an id when binding
combined <- rbindlist(dt_list, use.names = TRUE, fill = TRUE, idcol = "orig_col")
combined[ , orig_col := NULL, ]
my.means <- combined
large.polygons.results <- my.means
@ 


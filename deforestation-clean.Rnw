fit_g4 <- gamm4(
  cbind(deprived, not.deprived) ~ 
    t2(loss.at.year.of.interview, coverage.at.t0, k = c(10,10)) +
    average.years.of.education.for.the.1956.1976.cohort +
    year,
  random = ~ (loss.at.year.of.interview | superClusterID) +
            (0 + average.years.of.education.for.the.1956.1976.cohort | superClusterID) +
            (year | country),
  family = binomial,
  data = data.sets[[1]]

% Using the forest coverage change defined in relation to the previous measurement rather than at $t_{0}$ we get the following predictions (in this case the quadratic model was no worse than the model with a qubic term, so the following is based on a model with only a linear and a quadratic term for GNI).

<<kuznet-4b-effects, fig.cap = "Predicted forest cover change the next five years as a function of GNI, including a linear and a quadratic term, based on change in relation to the previous state, not the state at t0.", fig.width = 5, fig.height = 3, fig.align = "center", eval = FALSE>>=
my.fit.deforestation.4 <- lmer(forestation_change_5yr_forward ~ gdp.log + I(gdp.log^2) + year + (1 | country), data = my.dt.clean)
my.fit.deforestation.5 <- lmer(forestation_change_5yr_forward ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country), data = my.dt.clean)
my.eff <- Effect("gdp.log", my.fit.deforestation.4,
                 xlevels = list(gdp.log = seq(gdp_range[1], gdp_range[2], length.out = 100)))
## Hint to the exponentiation, but include 12000 as a upper point with reasonable coverage.
x_ticks <- c(1000, 2000, 4000, 8000, 12000)
p <- plot(my.eff,
          axes = list(x = list(gdp.log = list(lab = "GNI"), cex = 0.5),
                      y = list(cex = 0.5)),
          main = "", ylim = c(-1.3, 0.6))
p <- update(p,
            xlab = list(label="GNI", cex = 0.8),
            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(h = 0, lty = 2, lwd = 1.2), under = FALSE)

@ 

% The area-level model (kuznet-7-effects) is in the appendix, Section \ref{app:gni-area}.

% Since the area trends are measured relative to the other areas in the same country (Section \ref{sec:strategy}), the question is whether areas with forest loss developed faster or slower than other areas in their country, and whether the trends of such areas vary more than sampling error would produce.

<<rq1.summary, results = "asis", eval = FALSE>>=
library(data.table); library(xtable)
rq1 <- copy(q2.dt)
rq1[, loss := cat_P + cat_U + cat_K + cat_G + cat_S + cat_L + cat_R]
rq1[, loss.class := cut(loss, c(-Inf, 0.5, 2, 5, Inf), right = FALSE,
                        labels = c("$<$ 0.5", "0.5--2", "2--5", "$\\geq$ 5"))]
rq1[, z := iwi_slope_wc / iwi_slope_wc_se]
## between-area SD of the true trends within countries, per class (Paule-Mandel, chunk palm.split.models)
rq1.tau <- function(d) sqrt(tau2.pm.on(iwi_slope_wc ~ 1 | country, d))
rq1.tab <- rq1[, list(areas = .N, countries = uniqueN(country),
                      trend = weighted.mean(iwi_slope_wc, 1 / iwi_slope_wc_se^2),
                      faster = 100 * mean(z > qnorm(0.975)),
                      slower = 100 * mean(z < -qnorm(0.975)),
                      tau = rq1.tau(.SD)),
               by = loss.class][order(loss.class)]
rq1.big <- rq1[loss >= 2]
rq1.print <- copy(rq1.tab)
setnames(rq1.print, c("Forest loss (\\% of land)", "Areas", "Countries", "Mean trend",
                      "Faster (\\%)", "Slower (\\%)", "$\\hat\\tau$"))
print(xtable(rq1.print,
             caption = "Observed IWI trends of the areas by forest loss 2000--2020 (all categories, per cent of the land area in 2000). Mean trend: inverse-variance weighted mean of the area trends, in IWI units per year, as deviation from the country mean. Faster and slower: share of the areas whose trend is significantly above or below the country mean ($|z| > 1.96$); if all areas in a country had the same true trend, about 2.5 per cent would be faster and 2.5 per cent slower by chance. $\\hat\\tau$: between-area standard deviation of the true trends within countries, IWI units per year \\citep{PauleMandel1982}.",
             label = "tab:rq1", digits = c(0, 0, 0, 0, 3, 1, 1, 3)),
      include.rownames = FALSE, booktabs = TRUE, size = "footnotesize",
      sanitize.text.function = identity, sanitize.colnames.function = identity)
@

% Table \ref{tab:rq1} shows that \Sexpr{format(nrow(rq1.big), big.mark = ",")} of the \Sexpr{format(nrow(rq1), big.mark = ",")} areas with an IWI trend lost forest on at least 2 per cent of their land area. % TODO: interpret mean trend by class: do areas with more forest loss develop slower or faster than their country?
% Within countries, the true IWI trends of the areas differ with a standard deviation of \Sexpr{sprintf("%.3f", tau.within.country)} IWI units per year (95\% CI \Sexpr{sprintf("%.3f", tau.within.country.ci[["lower"]])}--\Sexpr{sprintf("%.3f", tau.within.country.ci[["upper"]])}). Within top level regions the variation is no larger than the sampling error predicts ($\hat\tau = \Sexpr{sprintf("%.3f", tau.within.region)}$). The local variation in the development of living conditions is thus mainly between regions within a country, not between neighbouring areas in the same region. % TODO: is this an answer to RQ1 or a limitation of the data? Probably both: with two or three survey rounds, area trends within a region cannot be told apart.

<<rq1.map, fig.cap = "Effect of forest loss on the average IWI of an area, IWI units per percentage point of forest cover lost since 2000, per country (top) and per top level region (bottom), from a linear mixed model with effects of forest loss that vary between countries and between regions within countries. Faded colours: the 95\\% interval includes zero. White land: no area in the analysis. The colour scale is capped at the 95th percentile of the absolute regional effects.", fig.width = 144/25.4, fig.height = 120/25.4, dpi = 300>>=
library(sf); library(ggplot2); library(data.table)
old.s2 <- sf_use_s2(FALSE)
rq1.map.dt <- rbind(
    merge(rq1.country.sf, rq1.country[, list(id = country, est, sig)], by = "id")[, c("est", "sig")] |>
        transform(panel = "Countries"),
    merge(rq1.region.sf, rq1.region[, list(id = top.level.region, est, sig)], by = "id")[, c("est", "sig")] |>
        transform(panel = "Top level regions"))
rq1.map.dt$panel <- factor(rq1.map.dt$panel, levels = c("Countries", "Top level regions"))
rq1.map.dt$interval <- factor(ifelse(rq1.map.dt$sig == "includes zero", "includes zero", "excludes zero"),
                              levels = c("excludes zero", "includes zero"))
rq1.cap <- quantile(abs(rq1.region$est), 0.95, na.rm = TRUE)
rq1.bg <- rnaturalearth::ne_countries(scale = 50, returnclass = "sf")[, "admin"]
rq1.bb <- st_bbox(rq1.map.dt)

ggplot() +
    geom_sf(data = rq1.bg, fill = "#ffffff", colour = NA) +
    geom_sf(data = rq1.map.dt, aes(fill = est, alpha = interval), colour = NA) +
    geom_sf(data = rq1.bg, fill = NA, colour = "#6f6e69", linewidth = 0.12) +
    scale_fill_gradient2(low = "#b2182b", mid = "#f2f1ec", high = "#2166ac", midpoint = 0,
                         limits = c(-rq1.cap, rq1.cap), oob = scales::squish,
                         name = "IWI units per pp\nof forest lost",
                         guide = guide_colourbar(barwidth = unit(30, "mm"), barheight = unit(2.5, "mm"))) +
    scale_alpha_manual(values = c(`excludes zero` = 1, `includes zero` = 0.3), drop = FALSE,
                       name = "95% interval",
                       guide = guide_legend(override.aes = list(fill = "#2166ac"))) +
    coord_sf(xlim = c(rq1.bb[["xmin"]] - 1, rq1.bb[["xmax"]] + 1),
             ylim = c(rq1.bb[["ymin"]] - 1, rq1.bb[["ymax"]] + 1), expand = FALSE, datum = NA) +
    facet_wrap(~ panel, ncol = 1) +
    theme_void(base_size = 7) +
    theme(strip.text = element_text(hjust = 0, size = 7, margin = margin(2, 0, 2, 2), colour = "#0b0b0b"),
          legend.position = "bottom", legend.key.size = unit(3, "mm"),
          legend.text = element_text(size = 6, colour = "#52514e"),
          legend.title = element_text(size = 6.5, colour = "#0b0b0b"),
          panel.background = element_rect(fill = "#eef1f4", colour = NA),
          plot.background = element_rect(fill = "#ffffff", colour = NA),
          panel.spacing = unit(2, "mm"), plot.margin = margin(1, 1, 1, 1))
invisible(sf_use_s2(old.s2))
@

<<rq1b.map, fig.cap = "As Figure \\ref{fig:rq1.map}, but from the alternative specification where the intercept and the time trend are correlated within regions and within countries. Faded colours: the 95\\% interval includes zero.", fig.width = 144/25.4, fig.height = 120/25.4, dpi = 300>>=
library(sf); library(ggplot2); library(data.table)
old.s2 <- sf_use_s2(FALSE)
rq1b.map.dt <- rbind(
    merge(rq1.country.sf, rq1b.country[, list(id = country, est, sig)], by = "id")[, c("est", "sig")] |>
        transform(panel = "Countries"),
    merge(rq1.region.sf, rq1b.region[, list(id = top.level.region, est, sig)], by = "id")[, c("est", "sig")] |>
        transform(panel = "Top level regions"))
rq1b.map.dt$panel <- factor(rq1b.map.dt$panel, levels = c("Countries", "Top level regions"))
rq1b.map.dt$interval <- factor(ifelse(rq1b.map.dt$sig == "includes zero", "includes zero", "excludes zero"),
                               levels = c("excludes zero", "includes zero"))
## same colour scale as Figure rq1.map, so that the two maps can be compared
rq1b.cap <- quantile(abs(rq1.region$est), 0.95, na.rm = TRUE)
rq1b.bg <- rnaturalearth::ne_countries(scale = 50, returnclass = "sf")[, "admin"]
rq1b.bb <- st_bbox(rq1b.map.dt)

ggplot() +
    geom_sf(data = rq1b.bg, fill = "#ffffff", colour = NA) +
    geom_sf(data = rq1b.map.dt, aes(fill = est, alpha = interval), colour = NA) +
    geom_sf(data = rq1b.bg, fill = NA, colour = "#6f6e69", linewidth = 0.12) +
    scale_fill_gradient2(low = "#b2182b", mid = "#f2f1ec", high = "#2166ac", midpoint = 0,
                         limits = c(-rq1b.cap, rq1b.cap), oob = scales::squish,
                         name = "IWI units per pp\nof forest lost",
                         guide = guide_colourbar(barwidth = unit(30, "mm"), barheight = unit(2.5, "mm"))) +
    scale_alpha_manual(values = c(`excludes zero` = 1, `includes zero` = 0.3), drop = FALSE,
                       name = "95% interval",
                       guide = guide_legend(override.aes = list(fill = "#2166ac"))) +
    coord_sf(xlim = c(rq1b.bb[["xmin"]] - 1, rq1b.bb[["xmax"]] + 1),
             ylim = c(rq1b.bb[["ymin"]] - 1, rq1b.bb[["ymax"]] + 1), expand = FALSE, datum = NA) +
    facet_wrap(~ panel, ncol = 1) +
    theme_void(base_size = 7) +
    theme(strip.text = element_text(hjust = 0, size = 7, margin = margin(2, 0, 2, 2), colour = "#0b0b0b"),
          legend.position = "bottom", legend.key.size = unit(3, "mm"),
          legend.text = element_text(size = 6, colour = "#52514e"),
          legend.title = element_text(size = 6.5, colour = "#0b0b0b"),
          panel.background = element_rect(fill = "#eef1f4", colour = NA),
          plot.background = element_rect(fill = "#ffffff", colour = NA),
          panel.spacing = unit(2, "mm"), plot.margin = margin(1, 1, 1, 1))
invisible(sf_use_s2(old.s2))
@

\author{Hans Ekbrand and Mary Zhang and Björn Halleröd}

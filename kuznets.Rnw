<<import.reduce.match.impute>>=
library(data.table)

## 1. Import the DHS data

## the source of final.RDS was original here:
## "~/mnt/poverty/media/sf_Our_data/Hans/Onedrive/
## University of Gothenburg/Deforestation and poverty - Paper I/final.RDS"

my.dt <- readRDS("final.RDS")


## 2. Discard unneeded columns

## This dataset is large, 27.000.000 rows, 108 variables
## So keep only what is needed in a smaller data set regain some RAM with garbage collection.

keep.these <- c("country.code.ISO.3166.alpha.3", "indian.states.as.countries",
                "year.of.interview", "ClusterID", "iwi", "education.in.years",
                "age", "lon", "lat", "wbgi_gee", "wdi_gnicapatlcur", "rural",
                "owns.land", "hectares.of.land", "owns.livestock")
remove.these <- setdiff(colnames(my.dt), keep.these)
my.dt[, (remove.these) := NULL]
gc(verbose = FALSE)


## 3. Import the administrative boundaries

## open a file with the partitionings. We could use the published geopackage
## file here, but it includes a lot of areas for which there is no DHS data,
## so it is faster to use the grid that only covers the areas for which we
## DO have dhs data.

## Again the original source was here: "~/mnt/poverty/media/sf_Our_data/Hans/
## Onedrive/University of Gothenburg/Deforestation and poverty - Paper I/
## dhs.grid.RDS"
dhs.grid <- readRDS("dhs.grid.RDS") ## 18956 areas, instance of "SpatialPolygons"


## 4. Create a SpatialPoints object

## all members of the same cluster should have the same GIS coordinates,
## avoid repeatedly classifying the same point.
## apply the "over" method on an aggregated object with clusters as units.

## Just pick the first row with non missing lon, lat and use those
## coordinates for each cluster.
setkey(my.dt, ClusterID)
these.ids <- my.dt[is.na(lon) == FALSE & is.na(lat) == FALSE, unique(ClusterID), ]
these.rows <- match(these.ids, my.dt$ClusterID)
cluster.coordinates <- my.dt[these.rows, list(ClusterID, lon, lat), ]

library(sp)
my.points <- SpatialPoints(coords = data.frame(
                               x = cluster.coordinates$lon,
                               y = cluster.coordinates$lat))


proj4string(my.points)   <- proj4string(dhs.grid)

## 5. Classify all points

my.map <- over(x = my.points, y = dhs.grid)

## use my.map to infer the area names for each cluster
cluster.coordinates$area.name <- names(dhs.grid)[my.map]

## before merging data back to my.dt, remove the redundant columns lon and lat
cluster.coordinates[, (c("lon", "lat")) := NULL, ]

## merge back to my.dt
my.dt <- merge(my.dt, cluster.coordinates)

## 2026-08-31, this row does not work.
## my.dt$lon.lat <- NULL

## 6. Import the CSV version of the deforestation data
## original source: My data set via zenodo
## https://zenodo.org/records/19221532/files/forest_change.csv?download=1
deforestation.dt <- data.table(read.csv("forest_change.csv"))

## 7. only keep deforestation data about regions with DHS data.
deforestation.dt <- deforestation.dt[region %in% unique(my.dt$area.name) &
                      is.na(deforestation.dt$forestation_2000) == FALSE, ]

## 8 Convert forestation data from wide to long
deforestation_long.dt <- melt(
  deforestation.dt,
  id.vars = c(
    "region",
    "forestation_2000",
    "size_km2",
    "top_level_region",
    "country"
  ),
  measure.vars = patterns("^forestation_change_"),
  variable.name = "year",
  value.name = "forestation_change"
)

deforestation_long.dt[, year := as.integer(sub("forestation_change_", "", year))]

## 9 Impute forestation change data for the intervening years

## add a row for each area at year 2000 with forestation_change == 0,
## to make imputations possible
## simply copy the static columns
unique.regions <- unique(deforestation_long.dt$region)
deforestation.dt <- rbind(deforestation_long.dt, data.table(region = unique.regions,
   forestation_2000 = deforestation_long.dt[match(unique.regions, region), forestation_2000],
   size_km2 = deforestation_long.dt[match(unique.regions, region), size_km2],
   top_level_region = deforestation_long.dt[match(unique.regions, region), top_level_region],
   country = deforestation_long.dt[match(unique.regions, region), country],
   year = 2000,
   forestation_change = 0))

## sort by region and year
setkey(deforestation.dt, region, year)

## Create a minimal data set with only the columns needed for imputation
deforestation.imputation.dt <- deforestation.dt[, list(region, year,
                                                    forestation_change), ]

# Create full yearly grid
deforestation_yearly.dt <- deforestation.imputation.dt[
  CJ(region = unique(region), year = 2000:2020),
  on = .(region, year)
]

# Define five-year interval
deforestation_yearly.dt[ , interval_start := year - ((year - 2000) %% 5) ]
deforestation_yearly.dt[ , interval_end := pmin(interval_start + 5, 2020) ]

## Remove areas with only missing data
only.missing.in.these.regions <- deforestation_yearly.dt[year == 2005 &
                                        is.na(forestation_change), region]
deforestation_yearly.dt <- deforestation_yearly.dt[region %in%
                                 only.missing.in.these.regions == FALSE, ]

## use approx()
deforestation_yearly.dt[ ,
  forestation_change := approx(
    x = year[!is.na(forestation_change)],
    y = forestation_change[!is.na(forestation_change)],
    xout = year
  )$y,
  by = region
]

## Drop the auxilliary columns
deforestation_yearly.dt[, (c("interval_start", "interval_end")) := NULL, ]

## save data common for each area.
area.commons <- my.dt[, list(
    country.code.ISO.3166.alpha.3 = unique(country.code.ISO.3166.alpha.3)), by = area.name]

my.dt <- my.dt[, c("area.name", "year.of.interview", "iwi", "education.in.years", "age")]
saveRDS(my.dt, file = "kuznet.1.RDS")

## Discard auxilliary objects
rm(deforestation.dt, deforestation_long.dt, unique.regions,
   only.missing.in.these.regions, deforestation.imputation.dt,
   cluster.coordinates, dhs.grid, my.points, these.ids, these.rows,
   keep.these, remove.these, my.map, my.dt)

gc(verbose = FALSE)

@

Figure \ref{fig:deforestation-plot} shows forestation data for one area in the sample, both observations (red dots) and interpolated data for the intervening years (rings). Observations are only available for every fith year, starting at year 2000 and ending at year 2020. This particular area started with a period of forest growth, but between 2010 and 2015 the area covered by forests reduced by about 0.3 percent units. We will only actually use the red points (observations) in the regression analysis.

<<deforestation-plot, fig.cap = "Linear interpolation of (de)-forestation data for a sample area. Red points represent observed data, hollow dots represent interpolated data for the intervening years. Postive values indicate growth of forests, while negative values means decreased forest coverage.", fig.width = 7>>=
## Find cases with growth and loss
foo <- deforestation_yearly.dt[ , max(forestation_change) > 0 &
                                  min(forestation_change) < 0, by = region]
these <- which(deforestation_yearly.dt$region == foo$region[head(which(foo$V1), n = 1)])
deforestation_yearly.dt[these,
                        plot(year, forestation_change, type = "b", xlab = "", ylab = "Change in forestation"), ]
those <- match(seq(from = 2000, to = 2020, by = 5), deforestation_yearly.dt[these, year])
      
deforestation_yearly.dt[these[those],
                        points(year, forestation_change, col = "red", pch = 20), ]

abline(h = 0, lty = 2)

@ 

\section{Modelling average IWI}
The DHS data has some useful features at the individual level that can be used to reduce sampling introduces by the DHS (since they do not repeatedly measure the same individuals in an area), specifically we can use years of education for an invariant cohort as an instrument to get a more stable estimate of average IWI in an area. The idea is that by using an invariant cohort we detect differences between the samples and control for such differences. We want persons that are young enough to included when the last surveys are made (max 65 years old in 2024) and old enough to have finished their education when the first surveys were made (at least 25 years in 2000), which gives that they should be born between 1960 and 1976.

Consider the area 24.Luanda.Viana.Viana Sede in Angola, from which we have five measurements (or four, depending on how you count since one survey was collected over two years, 2015 and 2016). In addition to the average IWI for each year, also calculate the average education for a cohort that is invariant over time.

<<iwi.0>>=
library(xtable); library(data.table);
library(globallivingconditions); library(lme4)
my.dt <- readRDS("kuznet.1.RDS")

prepare.data.f <- function(my.dt) {
    these <- which(is.na(my.dt$area.name) == FALSE)
    foo <- my.dt[these, in.the.cohort := (year.of.interview - age) > 1959 & (year.of.interview - age) < 1977, ]
    bar <- foo[these, list(average.iwi = mean(iwi, na.rm = TRUE)), by = list(year.of.interview, area.name)]
    baz <- foo[in.the.cohort == TRUE, list(average.education = mean(education.in.years, na.rm = TRUE)), by = list(year.of.interview, area.name)]
    bal <- merge(baz[is.na(average.education) == FALSE, ], bar[is.na(average.iwi) == FALSE, ])
    bal[, country := iso.3166$String[match(sapply(area.name, function(x) { strsplit(x, split = ".", fixed = TRUE)[[1]][1] }), iso.3166$numeric)], ]
    bal[, top.level.region := paste(country, sapply(area.name, function(x) { strsplit(x, split = ".", fixed = TRUE)[[1]][2] }), sep = "."), ]
    bal <- bal[, c("country", "top.level.region", "area.name", "average.iwi", "year.of.interview", "average.education")]
    
    bal[, year := scale(year.of.interview), ]
    bal[, iwi := scale(average.iwi), ]
    bal[, education := scale(average.education), ]
    return(bal)
}

bal <- prepare.data.f(my.dt)

library(lme4)
## A model with correlated intercept and slope for area yields a correlation between them at 1.0
## my.fit <- lmer(iwi ~ year + education + (year | area.name) + (year | top.level.region) + (year | country), data = bal)

## do not try to estimate the co-variance of the intercept and the slope per area.
## instead, use two separate random terms, one for the intercept (1 | area.name)
## and one for the slope (0 + year | area.name)
## use the bobyqa optimizer to help convergence

my.fit.iwi <- lmer(iwi ~ year + education + (1 | area.name) + (0 + year | area.name) +
                       (year | top.level.region) + (year | country), data = bal,
                  control = lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5)))

## z-transform by other scaling info from an existing data.frame
z.transform.f <- function(value, varname, df){
    (value - attr(df[[varname]], which = "scaled:center")) / attr(df[[varname]], which = "scaled:scale")
}

inverse.z.transform.f <- function(value, varname, df){
    value * attr(df[[varname]], which = "scaled:scale") + attr(df[[varname]], which = "scaled:center")
}

# One row per area with grouping variables and area-specific mean education
area_info <- bal[, .(
  country = first(country),
  top.level.region = first(top.level.region),
  education = mean(education, na.rm = TRUE)
), by = area.name]

# All area-year combinations, predict for all years, to make evaluations easiear.
pred_grid <- CJ(
  area.name = unique(bal$area.name),
  year.of.interview = 1999:2024
)

pred_grid <- area_info[pred_grid, on = "area.name"]

# Scale year using original scaling attributes from bal
pred_grid[, year := z.transform.f(year.of.interview, "year", bal)]

# Predict scaled IWI
pred_grid[, iwi_pred_scaled := predict(
  my.fit.iwi,
  newdata = pred_grid,
)]

# Convert back to original IWI scale
pred_grid[, iwi_pred := inverse.z.transform.f(iwi_pred_scaled, "iwi", bal)]

## And education too
pred_grid[, education := inverse.z.transform.f(education, "education", bal)]

## clean up
pred_grid[, (c("year", "iwi_pred_scaled")) := NULL, ]

@

<<iwi.0.5, results = "asis">>=
temp.f.2 <- function(my.dt, pred_grid, output = "table", my.area, my.label = "foo") {

    alternative.dt <- pred_grid[area.name == my.area & year.of.interview %in% my.dt[area.name == my.area, year.of.interview], list(area.name, year.of.interview, predicted.iwi.lme4 = iwi_pred), ]
    
    foo <- my.dt[area.name == my.area, ]
    foo[, area.name := NULL, ]
    foo[, in.the.cohort := (year.of.interview - age) > 1959 &
                     (year.of.interview - age) < 1977, ]
    bar <- foo[, list(average.iwi = mean(iwi, na.rm = TRUE)), by = year.of.interview]
    baz <- foo[in.the.cohort == TRUE, list(average.education = mean(education.in.years, na.rm = TRUE)), by = year.of.interview]
    bal <- merge(bar, baz)
    if(output == "table"){
        print(xtable(bal, digits = c(0, 0, 1, 1), caption = paste("Average IWI in", my.area, "for the years of DHS observations. The education average is only based on persons born 1960-1976, while the IWI average is based on all persons in the DHS. IWI correlates with Eduacation average, but Education average in the population for this cohort should be almost invariant. Changes in education is thus a good measure of the sampling noise in the DHS. A simple regression that does not account for this sampling noise would fail to account for the fact that average education is particular low at the first measurement (year 2006) which also saw the lowest average IWI."), label = my.label), include.rownames = FALSE, booktabs = TRUE)
    } else {
        my.fit <- lm(average.iwi ~ year.of.interview + average.education, data = bal)
        bal$predicted.iwi <- predict(my.fit, newdata = data.frame(average.education = rep(mean(bal$average.education), nrow(bal)), year.of.interview = bal$year.of.interview))
        my.fit.simple <- lm(average.iwi ~ year.of.interview, data = bal)
        bal$predicted.iwi.simple <- predict(my.fit.simple)
        
        plot(bal$year.of.interview, bal$average.iwi, type = "b", ylab = "average IWI", xlab = "")
        lines(bal$year.of.interview, bal$predicted.iwi.simple, type = "b", col = "red")
        lines(bal$year.of.interview, bal$predicted.iwi, type = "b", col = "green")
        lines(alternative.dt$year.of.interview, alternative.dt$predicted.iwi.lme4, type = "b", col = "orange")
        par(xpd = TRUE)  # allow drawing outside plot region
        legend(x="top",
               inset = c(0, -0.15),     # move below plot
               ncol = 2,
               bty = "n",
               legend = c("observed average", "A. simple regression", "B .regression with control for education", "C. hierarchical regression with education"),
               col = c("black", "red", "green", "orange"), lwd = 1, cex = 0.8)
    }
}

temp.f.2(my.dt, pred_grid, output = "table", my.area = "24.Luanda.Viana.Viana Sede", my.label = "tab:iwi1")
temp.f.2(my.dt, pred_grid, output = "table", my.area = "24.Luanda.Cacuaco.Funda", my.label = "tab:iwi2")

@ 

The changes in education for this cohort should just be sampling noise, i.e. for years with higher values the sampled households happen to be a bit more wealthy (assuming higher education in general leads to slightly higher level of wealth), which leads to an overestimation of the true average IWI, and years with particularly low average education in the sampled members of the cohort, we assume the average IWI is underestimated.

We can estimate IWI in at least three different ways:

\begin{itemize}
\item A: Simple regression based only on year and data in the area.
\item B: Bivarate regression based on year and average education, but still only using data points from the area.
\item C: Hierarchical regression (mixed model) that apply shrinkage to the mean.
\end{itemize}

Below is the mathematical notation for each of these three models.

\begin{align}
y_{it} &= \beta_0 + \beta_1 \textrm{year}_{it} + \varepsilon_{it} \tag{A} \\[1em]
y_{it} &= \beta_0 + \beta_1 \textrm{year}_{it} + \beta_2 \textrm{education}_{it} + \varepsilon_{it} \tag{B} \\[1em]
y_{it} &= \beta_0 + \beta_1 \textrm{year}_{it} + \beta_2 \textrm{education}_{it} \notag \\
       &\quad + u_{0i} + u_{1i} \, \textrm{year}_{it} \notag \\
       &\quad + v_{0r(i)} + v_{1r(i)} \, \textrm{year}_{it} \notag \\
       &\quad + w_{0c(i)} + w_{1c(i)} \, \textrm{year}_{it} \notag \\
       &\quad + \varepsilon_{it} \tag{C}
\end{align}
\noindent
Model C includes random intercepts and random slopes for area, region, and country. For area, the covariance between the random intercept and random slope is constrained to zero. This is because we do not have enough data points to support a model that learns the relationship between the area intercept and the area slope; we only have enough data to fit an intercept and a slope for each area. To also answer the question: does the slope tend to be smaller when the intercept is high, is asking too much of the data.
\[
u_{0i} \sim \mathcal{N}(0,\sigma^2_{u0}), 
\qquad
u_{1i} \sim \mathcal{N}(0,\sigma^2_{u1}),
\qquad
\operatorname{Cov}(u_{0i},u_{1i}) = 0.
\]
While for region and country, the random intercepts and slopes are allowed to covary. 
\begin{align*}
% (u_{0i}, u_{1i}) &\sim \mathcal{N}(0, \Sigma_{\textrm{area}}) \notag \\
(v_{0r}, v_{1r}) &\sim \mathcal{N}(0, \Sigma_{\textrm{region}}) \notag \\
(w_{0c}, w_{1c}) &\sim \mathcal{N}(0, \Sigma_{\textrm{country}}) \notag \\
  \varepsilon_{it} &\sim \mathcal{N}(0, \sigma^2)
\end{align*}


% with correlated intercepts and slopes so that the variance-covariance matrices for the intercept and slope of area, region and country respectively are defined as follows (note that for area, the co-variance is set to zero).

$
\Sigma_{\text{area}} =
\begin{pmatrix}
\sigma^2_{u0} & 0 \\
0 & \sigma^2_{u1}
\end{pmatrix};
\Sigma_{\text{region}} =
\begin{pmatrix}
\sigma^2_{v0} & \sigma_{v0,v1} \\
\sigma_{v0,v1} & \sigma^2_{v1}
\end{pmatrix};
\Sigma_{\text{country}} =
\begin{pmatrix}
\sigma^2_{w0} & \sigma_{w0,w1} \\
\sigma_{w0,w1} & \sigma^2_{w1}
\end{pmatrix}
$

lme4 extends Wilkinson–Rogers formula notation by adding random-effects terms of the form (random-effect expression | grouping factor), including syntax for correlated and uncorrelated random intercepts and slopes, and in this notation the model reads:

<<model.explicit, eval=FALSE, echo = TRUE>>=
formula(iwi ~ year + education + (1 | area.name) + (0 + year | area.name) +
                       (year | top.level.region) + (year | country))
@

In stata this would be achieved with the following code:

<<model.explicit.stata, engine = "stata", eval=FALSE, echo = TRUE>>=
mixed iwi year education ///
    || country: year, covariance(unstructured) ///
    || top_level_region: year, covariance(unstructured) ///
    || area_name: year, covariance(independent) ///
    reml
@ 

<<iwi, fig.cap = "Different ways of estimating average IWI in the area '24.Luanda.Viana.Viana Sede'. Lines A and B are only based on data in table \\ref{tab:iwi1}, while line C is based on hierarchical regression that takes the average IWI in the top region and the country into account.", dev = "png", dpi = 200, fig.width = 7, fig.height = 4.5>>=
temp.f.2(my.dt, pred_grid, output = "figure", my.area = "24.Luanda.Viana.Viana Sede")
@

<<iwi-fig-area-2, fig.cap = "Different ways of estimating average IWI in the area '24.Luanda.Cacuaco.Funda'. Lines A and B are only based on data in table \\ref{tab:iwi2}, while line C is based on hierarchical regression that takes the average IWI in the top region and the country into account.", dev = "png", dpi = 200, fig.width = 7, fig.height = 4.5>>=
my.dt.bak <- my.dt
temp.f.2(my.dt, pred_grid, output = "figure", my.area = "24.Luanda.Cacuaco.Funda")
@ 

Considering again the area in Angola shown in Table \ref{tab:iwi1}, Figure \ref{fig:iwi} shows observed data together with predictions for each of the three models. The red, orange and green lines are all based on regression analysis: the red line represents a regression with a single independent variable, ``year.of.interview'', while the green line is based on both ``year.of.interview'', and ``education.in.years'' (see table \ref{tab:iwi1}). The orange line should in general be preferable since it uses the signal from not only this area but also other areas in the same top level region and in the same country. However, that signal will also shrink the differences between areas and predict values of IWI that make the areas appear more similar than they would have if the predictions for one area was completely independent of predictions for nearby areas. So, it comes with a price : stability is the gain, and decreased area differences is the price.

\texttt{pred\_grid} is the full object, now create \texttt{living.conditions.dt} with only \texttt{area.name}, \texttt{country}, \texttt{top level region}, \texttt{year of interview} and the \texttt{predicted average IWI value}, thus droping the variable average education in years variable.

<<merge.data>>=
library(data.table)
living.conditions.dt <- pred_grid[which(year.of.interview %in% seq(from=2000, to=2020, by=5)), list(area.name, country, top.level.region, year.of.interview, iwi = iwi_pred), ]

## Old code that connected living conditions with deforestation five years later.
## deforestation.dt <- deforestation_yearly.dt[which(year %in% seq(from=2000, to=2020, by=5)), list(area.name = region, year.of.interview = year - 5, forestation_change_year = year, forestation_change), ]

## New code that connects deforestation change with the same year of living conditions
deforestation.dt <- deforestation_yearly.dt[which(year %in% seq(from=2000, to=2020, by=5)), list(area.name = region, year.of.interview = year, forestation_change_year = year, forestation_change), ]

setkey(deforestation.dt, area.name, year.of.interview)
setkey(living.conditions.dt, area.name, year.of.interview)
my.dt <- merge(deforestation.dt, living.conditions.dt, all.x = FALSE, all.y = TRUE)
my.dt$forestation_change_year <- NULL
@

<<merge.data.show, results = "asis">>=
library(xtable)
print(xtable(head(my.dt[, list(`Name of area` = area.name, Year = year.of.interview, FC = forestation_change, IWI = iwi), ]),
             digits = c(0, 0, 0, 2, 1),
             caption = "Living conditions data for year 2000 is connected to the forestation change for the \\emph{following} five years. 'FC' = Forest coverage change in comparison to year 2000 (observed)'."
             ), booktabs = TRUE, include.rownames = FALSE)

@ 

Add GNI-data from a previous imputation. For another article I produced a high quality data set with imputed GNI data. Here, just re-use those data.

<<add.gni>>=
## Reconcile differences in the names of the Indian states.
## Current data (based on GADM naming scheme for region) set uses "India.Andaman and Nicobar"
## GNI source uses "IA.Andaman and Nicobar Islands"
## Change the GNI source.

## lazyLoad("merge.control.vars_29b00956cf7a04f813b4027e23a3da1e") (From the religion paper)
## save(gdl.data.india, Country.data, file = "generic_gdi_artifacts_from_previous_article.RData")
## gdi <- rbind(gdl.data.india, Country.data)
## gdi <- gdi[, list(country, year.of.interview, gdp.log), ]

## gni$country <- gsub("IA.", "India.", gni$country, fixed = TRUE)
## gni$country <- gsub("Andaman and Nicobar Islands", "Andaman and Nicobar", gni$country, fixed = TRUE)
## gni$country <- gsub("India.Chandigarth", "India.Chandigarh", gni$country, fixed = TRUE)
## gni$country <- gsub("India.New Delhi", "India.NCT of Delhi", gni$country, fixed = TRUE)
## gni$country <- gsub("India.Orissa", "India.Odisha", gni$country, fixed = TRUE)
## gni$country <- gsub("India.Uttaranchal", "India.Uttarakhand", gni$country, fixed = TRUE)
## saveRDS(gni, file = "GNI.RDS")

gni <- readRDS(file = "GNI.RDS")
my.dt[country == "India", country := top.level.region, ]
setkey(gni, country, year.of.interview)
setkey(my.dt, country, year.of.interview)
my.dt <- merge(my.dt, gni)

@

\section{Modelling deforestation}

The first models to test are two simple models with only GNI as the focal variable, first included as a linear and a squared term, and, in the second model, also with a cubic term. We also include a dummy term for year, where year 2000 will be the reference level, so one dummy for each of 2005, 2010 and 2015.

\begin{align}
  \text{forest\_coverage\_change}_{t+5} &= \beta_0 \text{GNI}_{t} + \beta_1 \text{GNI}_{t}^{2} \notag \\
                                        &\quad + \beta_2 \text{year}_{2005} + \beta_3 \text{year}_{2010} + \beta_4 \text{year}_{2015} \notag \\
                                        &\quad + w_{0c(i)} + \varepsilon_{it} \tag{1} \\
  \text{forest\_coverage\_change}_{t+5} &= \beta_0 \text{GNI}_{t} + \beta_1 \text{GNI}_{t}^{2} + \beta_2 \text{GNI}_{t}^{3} \notag \\
                                        &\quad + \beta_3 \text{year}_{2005} + \beta_4 \text{year}_{2010} + \beta_5 \text{year}_{2015} \notag \\
                                        &\quad + w_{0c(i)} + \varepsilon_{it} \tag{2}
\end{align}
\noindent
where the random term (the intercept for country) is specified as:

$$ w_{0c} \sim \mathcal{N}(0, \sigma_{\textrm{country}}^2) $$

% When predicting, all variables need a value so the variable year was set to 2010. Figure \ref{fig:plot-model-1a} shows the predicted forest change for a given value with GNI, including uncertainty.

<<plot-model-1a, fig.cap = "Forest cover change as a function of GNI.", fig.width = 5, fig.height = 3, fig.align = "center", eval = FALSE>>=
gdp_seq <- seq(min(my.dt$gdp.log), max(my.dt$gdp.log), length.out = 100)

# Manually construct model matrix
X_new <- cbind(
  `(Intercept)` = 1,
  gdp.log = gdp_seq,
  `I(gdp.log^2)` = gdp_seq^2,
  `factor(year.of.interview)2005` = 0,
  `factor(year.of.interview)2010` = 1,  # choose reference year
  `factor(year.of.interview)2015` = 0
)

beta <- fixef(my.fit.deforestation)
pred <- as.vector(X_new %*% beta)
vcov_mat <- vcov(my.fit.deforestation)

se <- sqrt(diag(X_new %*% vcov_mat %*% t(X_new)))
upper <- pred + 1.96 * se
lower <- pred - 1.96 * se

library(ggplot2)
library(dplyr)

plot.df <- data.frame(
  gdp.log = gdp_seq,
  pred = pred,
  lower = lower,
  upper = upper,
  GNI = exp(gdp_seq)
)

country.deviances <- as.data.frame(ranef(my.fit.deforestation))[c("grp", "condval", "condsd")]
colnames(country.deviances) <- c("country", "point.estimate.for.random.intercept", "sd.for.random.intercept")
country.df <- merge(country.deviances, my.dt[year.of.interview == 2010, list(gdp.log = unique(gdp.log)), by = country])

country.df$fixed_part <- approx(
  x = plot.df$gdp.log,
  y = plot.df$pred,
  xout = country.df$gdp.log
)$y

country.df <- country.df %>%
  mutate(
    GNI = exp(gdp.log),
    pred = fixed_part + point.estimate.for.random.intercept,
    ymin = pred - 1.96 * sd.for.random.intercept,
    ymax = pred + 1.96 * sd.for.random.intercept
  )

ggplot(plot.df, aes(x = GNI, y = pred)) +
    geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.2) +
    geom_line() +
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.8) +
    scale_x_log10() +
    labs(x = "GNI", y = "Predicted forestation change") +
    theme_minimal() + 
    theme(
        axis.text.y = element_text(size = 7),
        axis.title.y = element_text(size = 8),
        axis.text.x = element_text(size = 7),
        axis.title.x = element_text(size = 8)
        )

@
% Figure \vref{fig:plot-model-1b} adds the predicted forest change for all countries in the study, including uncertainty.

<<plot-model-1b, fig.cap = "Forest cover change as a function of GNI with estimated country averages.", fig.width = 3, fig.height = 5, fig.align = "center", eval=FALSE>>=
library(ggplot2)

ggplot(plot.df, aes(x = GNI, y = pred)) +
    geom_ribbon(aes(ymin = lower, ymax = upper), alpha = 0.2) +
    geom_line() +
    geom_point(
        data = country.df,
        aes(x = GNI, y = pred),
        size = 1.5,
        alpha = 0.6,
        inherit.aes = FALSE
    ) +
    geom_errorbar(
        data = country.df,
        aes(x = GNI, ymin = ymin, ymax = ymax),
        width = 0.05,
        alpha = 0.4,
        inherit.aes = FALSE
    ) + 
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.8) +
    scale_x_log10() +
    labs(x = "GNI", y = "Predicted forestation change") +
    theme_minimal() + 
    theme(
        axis.text.y = element_text(size = 7),
        axis.title.y = element_text(size = 8),
        axis.text.x = element_text(size = 7),
        axis.title.x = element_text(size = 8)
        )

@

<<kuznet-0>>=
my.dt[, year := factor(year.of.interview), ]
my.formula.1 <- formula(forestation_change ~ gdp.log + I(gdp.log^2) + year + (1 | country))
my.formula.2 <- formula(forestation_change ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country))
@

This is the code needed to fit the first model to data with lmer in R.

<<show.formula.1, echo = TRUE>>=
formula(forestation_change ~ gdp.log + I(gdp.log^2) + year + (1 | country))
@

And here is the code for the second model:

<<show.formula.2, echo = TRUE>>=
formula(forestation_change ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country))
@

<<kuznet-1-effects, fig.cap = "Forest cover change as a function of GNI, including a quadratic term for GNI.", fig.width = 5, fig.height = 3, fig.align = "center">>=
library(lattice); library(latticeExtra)
library(effects)
library(lme4)

my.fit.deforestation.2 <- lmer(forestation_change ~ gdp.log + I(gdp.log^2) + year + (1 | country), data = my.dt)

## Set the range of GDP values we want visualised explicitly, Effect() will not by default restrict it enough.
gdp_range <- range(my.dt$gdp.log, na.rm = TRUE)
my.eff <- Effect("gdp.log", my.fit.deforestation.2,
                 xlevels = list(gdp.log = seq(gdp_range[1], gdp_range[2], length.out = 100)))

## Hint to the exponentiation, but include 12000 as a upper point with reasonable coverage.
x_ticks <- c(1000, 2000, 4000, 8000, 12000)
p <- plot(my.eff,
          axes = list(x = list(gdp.log = list(lab = "GNI"), cex = 0.5),
                      y = list(cex = 0.5)),
          main = "", ylim = c(-1.95, 1.75))
p <- update(p,
            xlab = list(label="GNI", cex = 0.8),
            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(h = 0, lty = 2, lwd = 1.2), under = FALSE)

@

<<kuznet-3-effects, fig.cap = "Predicted forest cover change the next five years as a function of GNI, including a linear, quadratic and a cubic term. Based on change in relation to the state at t0.", fig.width = 5, fig.height = 3, fig.align = "center">>=
my.fit.deforestation.3 <- lmer(forestation_change ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country), data = my.dt)

## Set the range of GDP values we want visualised explicitly, Effect() will not by default restrict it enough.

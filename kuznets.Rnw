%% Adding Trade data from the FAO
%% input: "FAOSTAT_data_2011-2024.csv" and "FAOSTAT_data_2000-2010.csv" to be in the path
%% "~/mnt/poverty/media/sf_Our_data/Hans/Onedrive/University of Gothenburg/Deforestation and poverty - General/Data/Trade data from FAO/"
%% output: a data.table object called export with three variables per country and year

<<import.and.wash.fao, child="/home/hans/src/deforestation/FAO.Rnw">>=
@

<<add.fao.data>>=
library(data.table)
setkey(my.dt.clean, country.code, year)
fao.dt <- merge(my.dt.clean, exports)
@ 

Using the forest coverage change defined in relation to the previous measurement rather than at $t_{0}$ we get the following predictions (in this case the quadratic model was no worse than the model with a qubic term, so the following is based on a model with only a linear and a quadratic term for GNI).


<<kuznet-4b-effects, fig.cap = "Predicted forest cover change the next five years as a function of GNI, including a linear and a quadratic term, based on change in relation to the previous state, not the state at t0.", fig.width = 5, fig.height = 3, fig.align = "center">>=
my.fit.deforestation.4 <- lmer(forestation_change_5yr_forward ~ gdp.log + I(gdp.log^2) + year + (1 | country), data = my.dt.clean)
my.fit.deforestation.5 <- lmer(forestation_change_5yr_forward ~ gdp.log + I(gdp.log^2) + I(gdp.log^3) + year + (1 | country), data = my.dt.clean)
my.eff <- Effect("gdp.log", my.fit.deforestation.4,
                 xlevels = list(gdp.log = seq(gdp_range[1], gdp_range[2], length.out = 100)))
## Hint to the exponentiation, but include 12000 as a upper point with reasonable coverage.
x_ticks <- c(1000, 2000, 4000, 8000, 12000)
p <- plot(my.eff,
          axes = list(x = list(gdp.log = list(lab = "GNI"), cex = 0.5),
                      y = list(cex = 0.5)),
          main = "", ylim = c(-0.8, 0.2))
p <- update(p,
            xlab = list(label="GNI", cex = 0.8),
            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(h = 0, lty = 2, lwd = 1.2), under = FALSE)

@ 

Now, include the forest coverage at time $t$ as a control.

<<kuznet-5-effects, fig.cap = "Predicted forest cover change the next five years as a function of GNI, including a linear and a quadratic term, based on change in relation to the previous state. Including control for forest coverage at time $t$.", fig.width = 5, fig.height = 3, fig.align = "center">>=
library(lme4)
my.fit.deforestation.6 <- lmer(forestation_change_5yr_forward ~ forest_coverage + gdp.log + I(gdp.log^2) + year + (1 | country), data = my.dt.clean)

my.eff <- Effect("gdp.log", my.fit.deforestation.6,
                 xlevels = list(gdp.log = seq(gdp_range[1], gdp_range[2], length.out = 100)))
## Hint to the exponentiation, but include 12000 as a upper point with reasonable coverage.
x_ticks <- c(1000, 2000, 4000, 8000, 12000)
p <- plot(my.eff,
          axes = list(x = list(gdp.log = list(lab = "GNI"), cex = 0.5),
                      y = list(cex = 0.5)),
          main = "", ylim = c(-0.7, 0.3))
p <- update(p,
            xlab = list(label="GNI", cex = 0.8),
            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(h = 0, lty = 2, lwd = 1.2), under = FALSE)

@

<<kuznet-7-effects, fig.cap = "Predicted forest cover change the next five years ($t+5$) as a function of GNI, including a linear and a quadratic term; average IWI; control for forest coverage at time $t$ and a random intercept term for country and a random intercept term for the top level region.", fig.width = 5, fig.height = 3, fig.align = "center">>=
my.fit.deforestation.7 <- lmer(forestation_change_5yr_forward ~ iwi + forest_coverage + gdp.log + I(gdp.log^2) + year + (1 | country), data = my.dt.clean)
my.fit.deforestation.7b <- lmer(forestation_change_5yr_forward ~ iwi + forest_coverage + gdp.log + I(gdp.log^2) + year + (1 | country) + (1 | top.level.region), data = my.dt.clean)

my.eff <- Effect("gdp.log", my.fit.deforestation.7b,
                 xlevels = list(gdp.log = seq(gdp_range[1], gdp_range[2], length.out = 100)))
## Hint to the exponentiation, but include 12000 as a upper point with reasonable coverage.
x_ticks <- c(1000, 2000, 4000, 8000, 12000)
p <- plot(my.eff,
          axes = list(x = list(gdp.log = list(lab = "GNI"), cex = 0.5),
                      y = list(cex = 0.5)),
          main = "", ylim = c(-0.7, 0.3))
p <- update(p,
            xlab = list(label="GNI", cex = 0.8),
            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(h = 0, lty = 2, lwd = 1.2), under = FALSE)

@ 

\clearpage

\appendix
% The file final.RDS it is created automatically by the function \textrm{download.and.harmonise()} in the package \textrm{globallivingconditions}. The invokation of \textrm{download.and.harmonise()} was done by the template \textrm{dhs-debug-child.Rnw} which dfines the parameters used. As for parameters, the only non-default parameters used are

% \begin{verbatim}
%     file.types.to.download = c("PR", "GE", "IR", "MR", "KR"),
%     variable.packages = c("wealth", "india"),
% \end{verbatim}

% which means: ``get all file types, including the GIS ones'' and ``calculate IWI, include some special stuff for India''. The India stuff is to (a) create an alterantive country variable based on the indian state name and (b) use historical state division so that the set of states is constant, ie. undo state splits that occured after 1990 and (c) include a variable for the household weight within the indian state.
\end{document}

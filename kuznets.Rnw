            ylab = list(label="Predicted forestation change", cex = 0.8),
            scales = list(x = list(at = log(x_ticks), labels = x_ticks )))
p + 
    layer(panel.grid(h = -1, v = 0, lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 
    layer(panel.abline(v = log(x_ticks), lty = 2, lwd = 1, col = rgb(0.7, 0.7, 0.7, alpha = 1)), under = FALSE) + 

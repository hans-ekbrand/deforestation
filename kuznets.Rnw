@

<<fcc.def, echo = FALSE, results = "asis", eval=TRUE>>=
library(data.table); library(xtable); library(globallivingconditions)
setkey(my.dt, area.name)
## import state at t0 again
deforestation.dt <- data.table(read.csv("forest_change.csv"))
initial.state.dt <- deforestation.dt[, list(area.name = region, FC_init = forestation_2000), ]
my.dt.full <- merge(my.dt, initial.state.dt)

setorder(my.dt.full, area.name, year.of.interview)

my.dt.full[
  ,
  forestation_state := FC_init + forestation_change
]

my.dt.full[
  order(area.name, year.of.interview),
  forestation_change_5yr_forward := data.table::shift(forestation_state, type = "lead") - forestation_state,
  by = area.name
]

my.dt.clean <- my.dt.full[, list(country, top.level.region, area.name, year = year.of.interview, iwi, gdp.log, forest_coverage = forestation_state, cummulative_forestation_change = forestation_change, forestation_change_5yr_forward), ]

my.dt.clean[
  order(area.name, year),
  forestation_change_5yr_backward :=
    forest_coverage - data.table::shift(forest_coverage, type = "lag"),
  by = area.name
]

country <- sapply(strsplit(my.dt.clean$country, split = ".", fixed = TRUE), function(x) { x[1] })
my.dt.clean$country.code <- iso.3166$String.code[match(country, iso.3166$String)]
setcolorder(my.dt.clean, "country.code")

write.csv(my.dt.clean, file = "commondata1.csv")

sample.2 <- my.dt.clean[top.level.region == "Zimbabwe.Midlands", list(country, top.level.region, area.name, year, iwi, gdp.log, forest_coverage, cummulative_forestation_change, forestation_change_5yr_forward), ]
colnames(sample.2) <- c("Country", "Top level Region", "Area name", "year", "IWI", "GNI.log", "FC", "cum.FCC", "F5YFCC")

print(xtable(sample.2, caption = "The data points for a top level region in the merged dataset. 'IWI', predicted average IWI based on observed IWI and education in years for a common cohort'; 'FC' = 'Forest Coverage'; 'cum.FCC' = 'Cummulative Forest Coverage Change'; 'F5YFCC' = 'Forward-looking 5 years Forest Coverage Change, ie, the FCC for the coming 5 years after this year. Not Available for the last observation in each area", label = "tab:def1"), booktabs = TRUE)

@

